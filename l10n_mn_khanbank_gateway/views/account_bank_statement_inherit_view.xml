<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    	 <data>
    	 <record id="account_bank_statement_bank_inherit_form" model="ir.ui.view">
		        <field name="name">account.statement.mn.bank.inherit</field>
		        <field name="model">account.bank.statement</field>
		        <field name="inherit_id" ref="account.view_bank_statement_form"/>
		        <field name="arch" type="xml">
		            <data>
		            	<xpath expr='//field[@name="date"]' position="after">
		                        <field name="end_date"/>
		                </xpath>
		                <xpath expr='//sheet/div[@class="oe_button_box"]' position="after">
		                	
		                	<button class="oe_inline oe_stat_button" name="get_download_statement" 
		                	string="Хаан банкны хуулга татах" type="object" 
		                	attrs="{'invisible':[('state','=','confirm')]}" icon="fa-pencil-square-o"/>
		                	<button class="oe_inline oe_stat_button" name="get_action_tdb_bank_statement" 
		                	string="Худалдаа хөгжлийн банкны хуулга татах" type="object" 
		                	attrs="{'invisible':[('state','=','confirm')]}" icon="fa-pencil-square-o"/>
		                </xpath>
		                
		                <xpath expr='//sheet/div[@class="oe_button_box"]' position="after">
		                	

		                </xpath>
		               
		            </data>
		        </field>
	    	</record>
    	</data>

</odoo>