<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_expense_sheet_form_inherit_view" model="ir.ui.view">
            <field name="name">hr.expense.sheet.mn.tree</field>
            <field name="model">hr.expense.sheet</field>
            <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//field[@name="accounting_date"]' position="replace">
                        <field name="accounting_date" readonly="0"/>
                        <field name="partner_id" string="Харилцагч"/>
                        <field name="bank_account_id" string="Банкны данс"/>
                    </xpath>
                </data>
            </field>
        </record>

    </data>
</odoo>
