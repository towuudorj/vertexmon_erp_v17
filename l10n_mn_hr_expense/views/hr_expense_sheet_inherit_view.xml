<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_expense_sheet_form_inherit_view" model="ir.ui.view">
            <field name="name">hr.expense.sheet.mn.tree</field>
            <field name="model">hr.expense.sheet</field>
            <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//field[@name="accounting_date"]' position="replace">
                        <field name="accounting_date" readonly="0"/>
                        <field name="partner_id" string="Харилцагч"/>
                        <field name="bank_account_id" string="Банкны данс"/>
                    </xpath>
                    <xpath expr='//button[@name="action_register_payment"]' position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                    <xpath expr='//button[@name="action_submit_sheet"]' position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                    <xpath expr='//field[@name="state"]' position="attributes">
                        <attribute name="statusbar_visible">draft,done</attribute>
                    </xpath>
                    <xpath expr='//button[@name="action_submit_sheet"]' position="after">
                        <button name="action_to_done" string="To done" type="object" invisible="state != 'draft'" groups="account.group_account_user"/>
                    </xpath>
                </data>
            </field>
        </record>

    </data>
</odoo>
