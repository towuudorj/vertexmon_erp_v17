<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_auto_download_currency_rate_cron" model="ir.cron">
        <field name="name">Download currency rate</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="doall" eval="True"/>
        <field name="model_id" ref="model_res_currency"/>
        <field name="code">model._download_currency_rate()</field>
        <field name="state">code</field>
    </record>
</odoo>
