<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
        <template id="report_mn_purchase_invoice_data">
        	<t t-call="web.external_layout">
			<t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                <div class="page">
                	<div class="row mb64">
			            <div class="col-6">
			            	<p style="text-align: left;">
			            		<img t-attf-src="data:image/jpg;base64,{{request.env.user.company_id.logo}}" style="width:190px;height:60px;"/>
			            	</p>
			            </div>
			            <div class="col-6">
			            	<p style="text-align:right;font-size: 12px;margin-right:5%; margin-top:-100px;">
							<span>Сангийн сайдын 2017 оны</span>
							<br/>
							<span>347 дугаар тушаалын хавсралт</span>
							<br/>
							<span>НХМаягт Т-1</span>
							</p>
			            </div>
			        </div>
			        
			        <p style="text-align:center; font-size:16px; font-weight: bold;">
			        	НЭХЭМЖЛЭХ №: <t t-esc="o.name"/>
			        </p>
                    <div class="row" style="content:''; display: table; clear: both; padding-top:6px;">
                      <div class="column" style="float: left; width: 55%; padding-top: 10px; padding-left:1%;">
                        <p style="height:10px;"><b>Нэхэмжлэгч:</b></p>
                        <p>Байгууллагын нэр: <b><span style="text-decoration: underline;"><t t-esc="o.company_id.name"/></span></b></p>
                        <p style="height:10px;">Регистрийн дугаар: <span style="text-decoration: underline;"><t t-esc="o.company_id.vat"/></span></p>
                        <p>Хаяг: <span style="text-decoration: underline;"><t t-esc="o.company_id.street"/></span></p>
                        
                        <p style="height:5px;">Оффис утас: <span style="text-decoration: underline;"><t t-esc="o.company_id.partner_id.mobile"/></span></p>                  
                        <p style="height:5px;">Э-шуудан: <span style="text-decoration: underline;"><t t-esc="o.company_id.email"/></span></p>
                        <tr>
                          <td style="text-align: left;">
                            Банкны нэр:
                            <span><b style="text-decoration: underline;"><t t-esc="o.partner_bank_id.bank_id.name"/></b>
                            <br/>
                            <p>Дансны дугаар: ₮ <span style="text-decoration: underline;"><t t-esc="o.partner_bank_id.acc_number"/></span></p>
                            </span>
                          </td>
                        </tr>
                        <p style="height:5px;">Гүйлгээний утга: <span style="text-decoration: underline;">Байгууллагын нэр, Регистер </span></p>
                      </div>
                      <div class="column" style="float: left; width: 42%; padding-top: 10px;">
                        <p style="height:10px;"><b>Харилцагч:</b></p>
                        <p>Байгууллагын нэр: <b><span style="text-decoration: underline;"><t t-esc="o.partner_id.name"/></span></b></p>
                        <p style="height:10px;">Регистрийн дугаар: <span style="text-decoration: underline;"><t t-esc="o.partner_id.vat"/></span></p>
						<p style="margin-bottom: 10px;">
							Хаяг: 
							<span style="text-decoration: underline;">
								<t t-esc="', '.join(filter(None, [
									o.partner_id.street,
									o.partner_id.street2,
									o.partner_id.city,
									o.partner_id.state_id.name if o.partner_id.state_id else '',
									o.partner_id.zip,
									o.partner_id.country_id.name if o.partner_id.country_id else ''
								]))"/>
							</span>
						</p>                  
						<p style="height:5px;">Нэхэмжлэх огноо: <span style="text-decoration: underline;"><t t-esc="o.invoice_date"/></span></p>
                        <p style="height:5px;">Төлбөр хийх хугацаа: <span style="text-decoration: underline;"><t t-esc="o.date"/></span></p>
                        <p>Утас: <span style="text-decoration: underline;"><t t-esc="o.partner_id.phone"/></span>, <span style="text-decoration: underline;"><t t-esc="o.partner_id.mobile"/></span></p>
                        <p>Имэйл: <span style="text-decoration: underline;"><t t-esc="o.partner_id.email"/></span></p>
                      </div>
                    </div>
                	<table style="width: 99%; font-size:13px;text-align: center; border-collapse: collapse; border: 1px solid black; margin-left:1%; padding-top:1px;">
                		<tr class="border-black">
                			<td style="padding: 3px; width: 5%; border: 1px solid black; font-weight: bold;">№:</td>
                			<td style="padding: 3px; width: 60%; border: 1px solid black; font-weight: bold;">Барааны нэр</td>
                			<td style="padding: 3px; width: 10%; border: 1px solid black; font-weight: bold;">Тоо хэмжээ</td>
                			<td style="padding: 3px; width: 10%; border: 1px solid black; font-weight: bold;">Нэгж үнэ</td>
                			<td style="padding: 3px; width: 15%; border: 1px solid black; font-weight: bold;">НӨАТ-гүй Нийт үнэ</td>
                		</tr>
                		<t t-set="i" t-value="1"/>
						<tr class="border-black" t-foreach="o.invoice_line_ids" t-as="line">
							<td style="padding: 5px; border: 1px solid black;  text-align: center;">  <span t-esc="i"/> </td>
							<td style="padding: 5px; border: 1px solid black;  text-align: left;">
		                        <t t-esc="line.name"/>
		                    </td>
							<td style="padding: 5px; border: 1px solid black;  text-align: center;"> <span t-field="line.quantity"/></td>
							<td style="padding: 5px; border: 1px solid black;  text-align: right;"> <span t-esc="line.price_subtotal/line.quantity" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
							<td style="padding: 5px; border: 1px solid black;  text-align: right;"> <span t-field="line.price_subtotal"/></td>
							<t t-set="i" t-value="i+1"/>
		                </tr>
                		<tr class="border-black">
							<td rowspan="4" colspan="3" style="padding: 3px; border: 1px solid black;  text-align: center;"> </td>
							<td style="padding: 3px; font-weight: bold; border: 1px solid black;  text-align: center;"> Дүн</td>
							<td style="padding: 3px; border: 1px solid black;  text-align: right;"> <span t-field="o.amount_untaxed"/></td>
							<br/>
		                </tr>
                		<tr class="border-black">
		                    <td style="padding: 3px; font-weight: bold; border: 1px solid black;  text-align: center;"> НӨАТ 10%</td>
							<td style="padding: 3px; border: 1px solid black;  text-align: right;"> <span t-field="o.amount_tax"/></td>
		                </tr>
						<tr class="border-black">
		                    <td style="padding: 3px; font-weight: bold; border: 1px solid black;  text-align: center;"> Нийт дүн</td>
							<td style="padding: 2px; border: 1px solid black;  text-align: right;"> <span t-field="o.amount_total"/></td>
		                	<br/>
		                </tr>
                	</table>
		        	<br/>
		        	
                	<p style="margin-left:1%; margin-right:5%;">Мөнгөн дүн (үсгээр): <span t-field="o.amount_text"/> болно.</p>
                	<table style="margin-right:1%; margin-left:1%; width: 99%; text-align: center; border-spacing: 0; border:none !important;">
						<tr style="border: transparent 1px solid; height: 40px;">
							<td style="text-align:left; width: 30%; border:none !important; border-spacing: 0;">Ерөнхий нягтлан бодогч:  </td>
						</tr>
						<tr style="height: 40px;">
							<td style="text-align:left; width: 50%; border:none !important; border-spacing: 0;">
								<span>Борлуулалтын менежер:  </span>
							</td>
						</tr>
						<tr style="height: 40px;">
							<td style="text-align:left; width: 50%; border:none !important; border-spacing: 0;">
								<span>Хүлээн авсан:  </span>
							</td>
						</tr>
                	</table>
                	</div>
                </t>
			
        </template>

        <template id="report_mn_purchase_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="l10n_mn_purchase.report_mn_purchase_invoice_data" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
