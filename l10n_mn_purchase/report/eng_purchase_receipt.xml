<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_purchaseorder_eng">
            <t t-call="web.external_layout">
                <div class="page" style="margin-left:50px; margin-right:50px;">

                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 50%; text-align: left;">
                                <img t-attf-src="data:image/jpg;base64,{{o.company_id.logo}}" style="width:150px; height:auto;"/>
                            </td>
                            <td style="width: 50%; text-align: right;">
                                <h2 style="margin: 0;"> Purchase Order</h2>
                                <p style="margin: 0; font-size: 11px;">PO No: <span t-field="o.name"/></p>
                                <p style="margin: 0; font-size: 11px;">Contract No: <span t-field="o.partner_ref"/></p>
                                <p style="margin: 0; font-size: 11px;">Date: <span t-field="o.date_order" t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"/></p>
                            </td>
                        </tr>
                    </table>

                    <table style="width: 100%; margin-top: 20px; font-size: 11px;">
                        <tr>
                            <td style="width: 50%;">
                                <b>Contact ID:</b><br/>
                                <span t-field="o.partner_id.name"/><br/>
                                <span t-field="o.partner_id.street"/><br/>
                                <span t-field="o.partner_id.city"/>, <span t-field="o.partner_id.state_id.name"/><br/>
                                <span t-field="o.partner_id.country_id.name"/><br/>
                                <b>Email:</b> <span t-field="o.partner_id.email"/><br/>
                                <b>Phone:</b> <span t-field="o.partner_id.phone"/>
                            </td>
                            <td style="width: 50%; text-align: right;">
                                <b>Customer ID:</b><br/>
                                <span t-field="o.company_id.en_name"/><br/>
                                <span t-field="o.company_id.street2"/><br/>
                                <span t-field="o.company_id.city"/>, <span t-field="o.company_id.state_id.name"/><br/>
                                <span t-field="o.company_id.country_id.name"/><br/>
                                <b>Email:</b> <span t-field="o.company_id.email"/><br/>
                                <b>Phone:</b> <span t-field="o.company_id.phone"/>
                            </td>
                        </tr>
                    </table>

                    <table style="width: 100%; margin-top: 40px; font-size: 11px;">
                        <tr>
                            <td style="width: 50%;">
                                <b>Ship to:</b><br/>
                                <span t-field="o.company_id.en_name"/><br/>
                            </td>
                        </tr>
                    </table>


                    <table style="width: 100%; margin-top: 20px; border-collapse: collapse; font-size: 11px;" border="1">
                        <thead style="background-color: #f2f2f2; text-align: center;">
                            <tr>
                                <th style="padding: 5px; text-align: center;">SHIPPING METHOD</th>
                                <th style="padding: 5px; text-align: center;">PAYMENT TERM</th>
                                <th style="padding: 5px; text-align: center;">DELIVERY DATE</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding: 5px; text-align: center;">
                                </td>
                                <td style="padding: 5px; text-align: center;">
                                </td>
                                <td style="padding: 5px; text-align: center;">
                                    <span t-field="o.date_order" t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width: 100%; margin-top: 20px; border-collapse: collapse; font-size: 11px;" border="1">
                        <thead style="background-color: #f2f2f2; text-align: center;">
                            <tr>
                                <th style="padding: 5px; text-align: center;">№</th>
                                <th style="padding: 5px; text-align: left;">ITEM</th>
                                <th style="padding: 5px; text-align: left;">DESCRIPTION</th>
                                <th style="padding: 5px; text-align: center;">QTY</th>
                                <th style="padding: 5px; text-align: right;">UNIT PRICE</th>
                                <th style="padding: 5px; text-align: right;">TOTAL /<span t-field="o.currency_id.name"/>/</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="i" t-value="1"/>
                            <tr t-foreach="o.order_line" t-as="line">
                                <t t-if="line.is_downpayment==false">
                                    <td style="padding: 5px; text-align: center;">
                                        <span t-esc="i"/>
                                        <t t-set="i" t-value="i + 1"/>
                                    </td>
                                    <td style="padding: 5px; text-align: left;">
                                        <span t-field="line.product_id.default_code"/>
                                    </td>
                                    <td style="padding: 5px; text-align: left;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td style="padding: 5px; text-align: left;">
                                        <span t-field="line.product_qty"/>
                                    </td>
                                    <td style="padding: 5px; text-align: right;">
                                        <span t-esc="'%.2f' % line.price_unit"/>
                                    </td>
                                    <td style="padding: 5px; text-align: right;">
                                        <span t-field="line.price_subtotal"/>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width: 100%; margin-top: 20px; font-size: 11px;">
                        <tr>
                            <td style="width: 70%;"></td>
                            <td style="width: 30%; text-align: right;">
                                <p style="margin: 0;">
                                    <b>Tax:</b>
                                    <span t-field="o.amount_tax"/>
                                </p>
                                <p style="margin: 0;">
                                    <b>Total Amount:</b>
                                    <span t-field="o.amount_total"/>
                                </p>
                            </td>
                        </tr>
                    </table>

                    <div style="margin-top: 30px; font-size: 11px;">
                        <p><b>Signed by:</b></p>
                        <p><b>Date: </b><span t-field="o.date_order" t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"/></p>
                    </div>

                </div>
            </t>
        </template>

        <template id="report_purchaseorder_custom">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="l10n_mn_purchase.report_purchaseorder_eng" t-lang="'en_US'"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
