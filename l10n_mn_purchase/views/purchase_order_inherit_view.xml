<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_purchase_order_mn_form" model="ir.ui.view">
            <field name="name">purchase.order.view.form.inherit.mn</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='effective_date']" position="after">
                    <!--<field name="dispatch_date"  />-->
                    <field name="freight_status"/>
                    <field name="freight_type_id" />
                    <field name="freight_partner_id"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="sales_partner_id"  />
                    <field name="crm_code" readonly="1"/>
                    <field name="analytic_id"  />
                    <field name="is_expense"  />
                </xpath>

                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="purchase_type" />
                    <!--<field name="partner_type" />-->
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="currency_rate" />
                </xpath>
                
                <xpath expr="//sheet/notebook/page/field[@name='order_line']/tree/field[@name='name']" position="after">
                    <field name="month" optional="show"/>
                    <field name="pre_qty" optional="show"/>
                </xpath>
                <xpath expr="(//button[@name='action_create_invoice'])[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="(//button[@name='action_create_invoice'])[2]" position="replace">
                    <button name="%(action_purchase_create_invoice)d" type="action" context="{'create_bill':True}"
                            string="Create Bill" class="oe_highlight"
                            invisible="state not in ('purchase', 'done') or not order_line or invoice_status=='invoiced'" data-hotkey="w"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
