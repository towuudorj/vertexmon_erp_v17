<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

             <record id="view_purchase_requisition_mn_form" model="ir.ui.view">
                <field name="name">purchase.requisition.view.form.inherit.mn</field>
                <field name="model">purchase.requisition</field>
                <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
                <field name="arch" type="xml">
                    <xpath expr="//field[@name='vendor_id']" position="replace">
                        <field name="vendor_id" context="{'res_partner_search_mode': 'supplier'}" readonly="state in ['ongoing', 'done']" />
                    </xpath>
                    
                </field>
            </record>

    </data>
</odoo>
