<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_view_form_inherit_abi_product" model="ir.ui.view">
        <field name="name">sale.order.form (abi_sale_invoice_policy)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="invoice_policy_required" invisible="1" />
                <field
                    name="invoice_policy"
                    required="invoice_policy_required"
                    readonly="state not in ('draft', 'sent')"
                />
            </field>
        </field>
    </record>

    <record id="sale_order_view_filter_inherit_policy" model="ir.ui.view">
        <field name="name">sale.order.form.filter.policy</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter
                    name="filter_invoice_policy"
                    string="Invoice Policy Order"
                    domain="[('invoice_policy', '=', 'order')]"
                />
                <filter
                    name="filter_invoice_policy"
                    string="Invoice Policy Delivery"
                    domain="[('invoice_policy', '=', 'delivery')]"
                />
            </xpath>
        </field>
    </record>

</odoo>
