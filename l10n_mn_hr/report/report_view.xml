            <field name="name">Print Reference Report</field>
            <field name="model">reference.register</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_mn_hr.reference_report_view_template</field>
            <field name="report_file">l10n_mn_hr.reference_report_view_template</field>
