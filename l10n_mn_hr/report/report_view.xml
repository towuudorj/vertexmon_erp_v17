            <field name="report_name">l10n_mn_hr.decree_report_view_template_new_mn</field>
            <field name="report_file">l10n_mn_hr.decree_report_view_template_new_mn</field>
            <field name="attachment"/>
            <field name="binding_model_id" ref="model_hr_decree"/>
            <field name="binding_type">report</field>
        </record>

