        <record id="action_report_handover_act" model="ir.actions.report">
            <field name="name">Print Work Handover Act Report</field>
            <field name="model">work.handover.act</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_mn_hr.handover_act_report_template</field>
