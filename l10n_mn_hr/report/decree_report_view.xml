                                </t>

                                <!-- ==== DECR07 Ажилтны цалингаас өр төлбөр суутгах тухай ==== --> 
                                <t t-elif="o.decree_template.code == 'DECR07'">
                                    <p style="line-height: 1.1;">
                                        <span style="font-family: monospace; white-space: pre;">┌                                               ┐</span><br/>
                                        <span style="font-family: monospace; white-space: pre;">   Ажилтны цалингаас өр төлбөр </span><br/>
                                        <span style="font-family: monospace; white-space: pre;">          суутгах тухай        </span><br/>
                                    </p>
                                    <p style="text-align: justify; text-indent: 60px; margin-top: 80px;">
                                        Вертексмон ХХК-ийн Удирдлагын багийн шийдвэрийг үндэслэн ТУШААХ нь:
                                    </p>
