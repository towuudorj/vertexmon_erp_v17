                                        <li>
                                            <p>
                                                <t t-esc="o.decr_notes or ' '"/>
                                            </p>
                                            <t t-if="o.decr_image">
                                                <p>
                                                    <img t-att-src="'data:image/png;base64,%s' % o.decr_image" style="width: 100%; height: auto; margin-top: 10px;"/>
