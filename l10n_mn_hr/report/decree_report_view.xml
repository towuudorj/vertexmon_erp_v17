<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="decree_report_view_template_data">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({})"/>
                <div class="page">
                    <p style="text-align: center; font-size: 16px; font-weight: bold;">
                        <span>"<t t-esc="o.company_id.name"/>" ХХК</span>
                    </p>
                    <t t-set="parsed_date" t-value="o.date and o.date.strftime('%Y-%m-%d')"/>
                    <t t-set="year" t-value="parsed_date[:4]"/>
                    <t t-set="month" t-value="parsed_date[5:7]"/>
                    <t t-set="day" t-value="parsed_date[8:10]"/>
                    <p style="text-align: center;">
                        <span style="margin-right: 120px;"><t t-esc="year"/> оны <t t-esc="month"/>  сарын <t t-esc="day"/> -ны өдөр </span>
                        <span style="margin-right: 120px;">
                        Дугаар: <t t-esc="o.decree_number"/>
                        </span>
                        <span>
                        Улаанбаатар хот
                        </span>
                    </p>
                    <p style="text-align: center; font-weight: bold; font-size: 16px;">
                        "<t t-esc="o.name"/>"
                    </p>
                    <p style="text-align: center; font-weight: bold; margin-top: 50px;">
                        ГҮЙЦЭТГЭХ ЗАХИРАЛ:. . . . . . . . . . . . . . . . . . ./<span><t t-esc="o.employee_id.name"/></span>/
                    </p>
                </div>
            </t>
        </template>

        <!-- ==== Тушаал шинэчилсэн, нийт 48 баримт ==== -->
        <template id="decree_report_view_template_data_new_mn">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="col-6">
                            <p style="text-align: left; margin-right:20px">
                                <img t-attf-src="data:image/jpg;base64,{{request.env.user.company_id.logo}}" style="width:190px;height:60px;"/>
                            </p>
                        </div>
                        <div style="
                            margin-top: 50px;
                            margin-left: 50px;
                            margin-right: 80px;
                            margin-bottom: 50px;
                            font-size: 16px;
                        ">
                            <!-- ==== Date Parsing ==== -->
                            <t t-set="parsed_date" t-value="o.date and o.date.strftime('%Y-%m-%d')"/>
                            <t t-set="year"  t-value="parsed_date[:4]"/>
                            <t t-set="month" t-value="parsed_date[5:7]"/>
                            <t t-set="day"   t-value="parsed_date[8:10]"/>

                            <!-- ==== Header Line ==== -->
                            <p style="text-align: center;">
                                <span style="margin-right: 100px;"><t t-esc="year"/> оны <t t-esc="month"/>  сарын <t t-esc="day"/> -ны өдөр </span>
                                <span style="margin-right: 100px;">
                                Дугаар: <t t-esc="o.decree_number"/>
                                </span>
                                <span>
                                Улаанбаатар хот
                                </span>
                            </p>

                            <!-- ==== Title ==== -->
                            <p style="text-align: center; margin-top: 50px;">
                                “ВЕРТЕКСМОН” ХХК-ИЙН ГҮЙЦЭТГЭХ ЗАХИРЛЫН ТУШААЛ
                            </p>                           
                            <p>

                                <!-- ==== DECR01 Туршилтын хугацаанд ажилд томилох тухай ==== --> 
                                <t t-if="o.decree_template.code == 'DECR01'">
                                    <p style="line-height: 1.1;">
                                        <span style="font-family: monospace; white-space: pre;">┌                                           ┐</span><br/>
                                        <span style="font-family: monospace; white-space: pre;">   Туршилтын хугацаанд</span><br/>
                                        <span style="font-family: monospace; white-space: pre;">   ажилд томилох тухай</span><br/>
                                    </p>

                                    <p style="text-align: justify; text-indent: 60px; margin-top: 80px;">
                                        Монгол Улсын Хөдөлмөрийн тухай хуулийн 47 дугаар зүйл, ажилтантай байгуулсан 
                                        <t t-esc="o.decr_emp_contract or '...........'"/> хөдөлмөрийн гэрээг тус тус үндэслэн ТУШААХ НЬ:
                                    </p>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт эхлэл -->
	                                <ol style="margin: 0; padding-left: 25px; text-align: justify; line-height: 1.8;">
                                        <li>
                                            <t t-esc="o.employee_id.last_name or '......................'"/> овогтой
                                            <t t-esc="o.employee_id.name.rsplit('.', 1)[0] or '......................'"/> 
                                            (РД: <t t-esc="o.employee_id.ssnid or '......................'"/>)-г
                                            <t t-set="date" t-value="o.decr_startdate and o.decr_startdate.strftime('%Y-%m-%d')"/>
                                            <t t-set="year"  t-value="date[:4]"/>
                                            <t t-set="month" t-value="date[5:7]"/>
                                            <t t-set="day"   t-value="date[8:10]"/>
                                            <t t-esc="year"/> оны <t t-esc="month"/>  сарын <t t-esc="day"/>-ны өдрөөс
                                            <t t-esc="o.department_id.get_dep_name_mn() or '......................'"/>-ны
                                            <t t-esc="o.position_id.get_job_name_mn() or '......................'"/> албан тушаалд
                                            туршилтын <t t-esc="o.decr_trial_period or '....'"/> сарын хугацаанд томилон ажиллуулсугай.
                                        </li>
                                        <li>
                                            Ажилтныг өдөр тутмын үйл ажиллагаанд чиглүүлж, удирдлагаар хангаж ажиллахыг
                                            <t t-esc="o.decr_guide_dep_id.get_dep_name_mn() or '...........................................................................'"/>-ны
                                            (<t t-esc="o.guide_emp_short_name or '..................................................'"/>)-т үүрэг болгосугай.
                                        </li>
                                        <li>
                                            Ажилтны нэг сарын цалинг 
                                            <t t-esc="'{:,.2f}'.format(o.wage) if o.wage else '......................'"/> ( 
                                            <t t-esc="o.wage_amount_to_text or '..................................................'"/>) төгрөг,
                                            хоол унааны нэмэгдэл
                                            <t t-esc="'{:,.2f}'.format(o.food_and_vehicle_add) if o.food_and_vehicle_add else '..............'"/> ( 
                                            <t t-esc="o.food_and_vehicle_add_amount_to_text or '..................................................'"/>) 
                                            төгрөгөөр тооцож олгохыг Санхүү, төлөвлөлтийн алба Санхүү эрхэлсэн захирал (
                                            <t t-esc="o.chief_acc_short_name or '.....................'"/>)-д зөвшөөрсүгэй.
                                        </li>
                                        <li>
                                            Энэхүү тушаалын хэрэгжилтэд хяналт тавьж ажиллахыг Захиргаа, Хүний нөөцийн алба Үйл ажиллагаа хариуцсан захирал (
                                            <t t-esc="o.chief_hr_short_name or '.....................'"/>)-д даалгасугай.
                                        </li>
                                    </ol>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт төгсгөл -->
                                </t>
                                
                                <!-- ==== DECR02 Туршилтын хугацаанд ажилд томилох тухай ==== --> 
                                <t t-elif="o.decree_template.code == 'DECR02'">
                                    <p style="line-height: 1.1;">
                                        <span style="font-family: monospace; white-space: pre;">┌                                   ┐</span><br/>
                                        <span style="font-family: monospace; white-space: pre;">   Үндсэн ажилтнаар </span><br/>
                                        <span style="font-family: monospace; white-space: pre;">    томилох тухай </span><br/>
                                    </p>

                                    <p style="text-align: justify; text-indent: 60px; margin-top: 80px;">
                                        Монгол улсын Хөдөлмөрийн тухай хуулийн 47 дугаар зүйл, ажилтантай байгуулсан 
                                        <t t-esc="o.decr_emp_contract or '...........'"/> хөдөлмөрийн гэрээг тус тус үндэслэн ТУШААХ нь:
                                    </p>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт эхлэл -->
                                    <ol style="margin: 0; padding-left: 25px; text-align: justify; line-height: 1.8;">
                                        <li>
                                            <t t-esc="o.employee_id.last_name or '......................'"/> овогтой
                                            <t t-esc="o.employee_id.name.rsplit('.', 1)[0] or '......................'"/>
                                            (РД: <t t-esc="o.employee_id.ssnid or '......................'"/>)-г
                                            <t t-set="date" t-value="o.decr_startdate and o.decr_startdate.strftime('%Y-%m-%d')"/>
                                            <t t-set="year"  t-value="date[:4]"/>
                                            <t t-set="month" t-value="date[5:7]"/>
                                            <t t-set="day"   t-value="date[8:10]"/>
                                            <t t-esc="year"/> оны <t t-esc="month"/>  сарын <t t-esc="day"/>-ны өдрөөс
                                            <t t-esc="o.department_id.get_dep_name_mn() or '......................'"/>-ны
                                            <t t-esc="o.position_id.get_job_name_mn() or '......................'"/> албан тушаалд
                                            үндсэн ажилтнаар томилон ажиллуулсугай.
                                        </li>
                                        <li>
                                            Ажилтныг өдөр тутмын үйл ажиллагаанд чиглүүлж, удирдлагаар хангаж ажиллахыг
                                            <t t-esc="o.decr_guide_dep_id.get_dep_name_mn() or '...........................................................................'"/>-ны
                                            (<t t-esc="o.guide_emp_short_name or '..................................................'"/>)-т үүрэг болгосугай.
                                        </li>
                                        <li>
                                            Ажилтны нэг сарын цалинг 
                                            <t t-esc="'{:,.2f}'.format(o.wage) if o.wage else '......................'"/> ( 
                                            <t t-esc="o.wage_amount_to_text or '..................................................'"/>) төгрөг,
                                            хоол унааны нэмэгдэл
                                            <t t-esc="'{:,.2f}'.format(o.food_and_vehicle_add) if o.food_and_vehicle_add else '..............'"/> ( 
                                            <t t-esc="o.food_and_vehicle_add_amount_to_text or '..................................................'"/>) 
                                            төгрөгөөр тооцож олгохыг Санхүү, төлөвлөлтийн алба Санхүү эрхэлсэн захирал (
                                            <t t-esc="o.chief_acc_short_name or '.....................'"/>)-д зөвшөөрсүгэй.
                                        </li>
                                        <li>
                                            Энэхүү тушаалын хэрэгжилтэд хяналт тавьж ажиллахыг Захиргаа, Хүний нөөцийн алба Үйл ажиллагаа хариуцсан захирал (
                                            <t t-esc="o.chief_hr_short_name or '.....................'"/>)-д даалгасугай.
                                        </li>
                                    </ol>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт төгсгөл -->
                                </t>

                                <!-- ==== DECR03 Ээлжийн амралтын цалинг олгох тухай ==== --> 
                                <t t-elif="o.decree_template.code == 'DECR03'">

                                    <p style="line-height: 1.1;">
                                        <span style="font-family: monospace; white-space: pre;">┌                                                  ┐</span><br/>
                                        <span style="font-family: monospace; white-space: pre;">   Ээлжийн амралтын цалинг </span><br/>
                                        <span style="font-family: monospace; white-space: pre;">    тооцож олгох тухай </span><br/>
                                    </p>

                                    <p style="text-align: justify; text-indent: 60px; margin-top: 80px;">
                                        Монгол Улсын Хөдөлмөрийн хуулийн 99.1, “Вертексмон” ХХК-ийн дотоод журмын 11.3 заалтыг тус 
                                        үндэслэн ТУШААХ НЬ:
                                    </p>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт эхлэл -->
                                    <p style="text-align: justify; text-indent: 60px; line-height: 1.8;">
                                        <strong>Нэг.</strong>
                                        <t t-esc="o.department_id.get_dep_name_mn() or '......................'"/>-ны
                                        <t t-esc="o.position_id.get_job_name_mn() or '......................'"/> албан тушаалтай
                                        <t t-esc="o.employee_id.last_name or '......................'"/> овогтой
                                        <t t-esc="(o.employee_id.name.rsplit('.', 1)[0] if o.employee_id and o.employee_id.name else '......................')"/>
                                        (РД: <t t-esc="o.employee_id.ssnid or '......................'"/>)-д
                                        <t t-set="date" t-value="o.decr_date and o.decr_date.strftime('%Y-%m-%d')"/>
                                        <t t-set="year"  t-value="date[:4]"/>
                                        <t t-set="month" t-value="date[5:7]"/>
                                        <t t-set="day"   t-value="date[8:10]"/>
                                        <t t-esc="year"/> оны <t t-esc="month"/> сарын <t t-esc="day"/>-ны өдөр
                                        ээлжийн амралтын цалинг ОЛГОСУГАЙ.
                                    </p>
                                    <p style="text-align: justify; text-indent: 60px; line-height: 1.8;">
                                        <strong>Хоёр.</strong>
                                        <t t-esc="o.emp_short_name or '......................'"/>-д 
                                        ээлжийн амралтын хоногийн цалинг 
                                        <t t-esc="'{:,.2f}'.format(o.decr_day_off_wage) if o.decr_day_off_wage else '......................'"/> 
                                        хоногоор тооцож олгохыг Санхүү, төлөвлөлтийн алба Санхүү эрхэлсэн захирал 
                                        (<t t-esc="o.chief_acc_short_name or '.....................'"/>)-д ДААЛГАСУГАЙ.
                                    </p>
                                    <p style="text-align: justify; text-indent: 60px; line-height: 1.8;">
                                        <strong>Гурав.</strong>
                                        Энэхүү тушаалын хэрэгжилтэд хяналт тавьж ажиллахыг Захиргаа, Хүний нөөцийн алба 
                                        Үйл ажиллагаа хариуцсан захирал 
                                        (<t t-esc="o.chief_hr_short_name or '.....................'"/>)-д ДААЛГАСУГАЙ.
                                    </p>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт төгсгөл -->
                                </t>

                                <!-- ==== DECR04 Цалинтай чөлөө, тэтгэмж олгох тухай ==== --> 
                                <t t-elif="o.decree_template.code == 'DECR04'">

                                    <p style="line-height: 1.1;">
                                        <span style="font-family: monospace; white-space: pre;">┌                                                    ┐</span><br/>
                                        <span style="font-family: monospace; white-space: pre;">   Цалинтай чөлөө, тэтгэмж </span><br/>
                                        <span style="font-family: monospace; white-space: pre;">         олгох тухай </span><br/>
                                    </p>

                                    <p style="text-align: justify; text-indent: 60px; margin-top: 80px;">
                                        “Вертексмон” ХХК-ийн дотоод журмын 11.2.2.2  заалтыг тус үндэслэн ТУШААХ НЬ:
                                    </p>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт эхлэл -->
                                    <p style="text-align: justify; text-indent: 60px; line-height: 1.8;">
                                        <strong>Нэг.</strong>
                                        <t t-esc="o.department_id.get_dep_name_mn() or '......................'"/>-ны
                                        <t t-esc="o.position_id.get_job_name_mn() or '......................'"/> албан тушаалтай
                                        <t t-esc="o.employee_id.last_name or '......................'"/> овогтой
                                        <t t-esc="(o.employee_id.name.rsplit('.', 1)[0] if o.employee_id and o.employee_id.name else '......................')"/>
                                        (РД: <t t-esc="o.employee_id.ssnid or '......................'"/>)-н
                                        <t t-esc="o.decr_reason or '......................'"/> тул 
                                        <t t-esc="o.decr_day_off or '......................'"/> хоногийн 
                                        <t t-esc="'цалинтай' if o.decr_is_wage else 'цалингүй'"/> чөлөө олгосугай.
                                    </p>
                                    <p style="text-align: justify; text-indent: 60px; line-height: 1.8;">
                                        <strong>Хоёр.</strong>
                                        <t t-esc="o.emp_short_name or '......................'"/>-д 
                                        <t t-esc="'{:,.2f}'.format(o.decr_amount) if o.decr_amount else '......................'"/> 
                                        (<t t-esc="o.decr_amount_to_text or '..................................................'"/>) төгрөгийн тэтгэмж олгохыг 
                                        Санхүү, төлөвлөлтийн алба Санхүү эрхэлсэн захирал 
                                        (<t t-esc="o.chief_acc_short_name or '.....................'"/>)-д зөвшөөрсүгэй.
                                    </p>
                                    <p style="text-align: justify; text-indent: 60px; line-height: 1.8;">
                                        <strong>Гурав.</strong>
                                        Энэхүү тушаалын хэрэгжилтэд хяналт тавьж ажиллахыг
                                        Захиргаа, Хүний нөөцийн алба Үйл ажиллагаа хариуцсан захирал 
                                        (<t t-esc="o.chief_hr_short_name or '.....................'"/>)-д ҮҮРЭГ БОЛГОСУГАЙ.
                                    </p>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт төгсгөл -->
                                </t>

                                <!-- ==== DECR05 Албан томилолтоор ажиллуулах тухай ==== --> 
                                <t t-elif="o.decree_template.code == 'DECR05'">
                                    <p style="line-height: 1.1;">
                                        <span style="font-family: monospace; white-space: pre;">┌                                   ┐</span><br/>
                                        <span style="font-family: monospace; white-space: pre;">   Албан томилолтоор </span><br/>
                                        <span style="font-family: monospace; white-space: pre;">    ажиллуулах тухай </span><br/>
                                    </p>
                                    <p style="text-align: justify; text-indent: 60px; margin-top: 80px;">
                                        “Вертексмон” ХХК-ийн Менежментийн багийн шийдвэр, “Вертексмон” ХХК-ийн Албан томилолтын журмыг үндэслэн ТУШААХ НЬ:
                                    </p>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт эхлэл -->
                                    <ol style="margin: 0; padding-left: 25px; text-align: justify; line-height: 1.8;">
                                        <li>
                                            <t t-esc="o.department_id.get_dep_name_mn() or '......................'"/>-ны
                                            <t t-esc="o.position_id.get_job_name_mn() or '......................'"/> албан тушаалтай
                                            <t t-esc="o.emp_short_name or '......................'"/>-г 
                                            <t t-set="sdate" t-value="o.decr_startdate and o.decr_startdate.strftime('%Y-%m-%d')"/>
                                            <t t-set="syear"  t-value="sdate[:4]"/>
                                            <t t-set="smonth" t-value="sdate[5:7]"/>
                                            <t t-set="sday"   t-value="sdate[8:10]"/>
                                            <t t-esc="sdate"/> оны <t t-esc="smonth"/> сарын <t t-esc="sday"/>-ны өдрөөс
                                            <t t-set="edate" t-value="o.decr_enddate and o.decr_enddate.strftime('%Y-%m-%d')"/>
                                            <t t-set="eyear"  t-value="edate[:4]"/>
                                            <t t-set="emonth" t-value="edate[5:7]"/>
                                            <t t-set="eday"   t-value="edate[8:10]"/>
                                            <t t-esc="eyear"/> оны <t t-esc="emonth"/> сарын <t t-esc="eday"/>-ны өдөр хүртэл
                                            <t t-esc="o.decr_taks_details or '......................'"/> ажлын шугамаар
                                            <t t-esc="o.decr_to_location or '......................'"/>-руу томилон АЖИЛЛУУЛСУГАЙ.
                                        </li>
                                        <li>
                                            Хавсралт 1-д заасан томилолтын удирдамжийн дагуу томилолтын 
                                            зардлыг тооцон олгохыг Санхүү, төлөвлөлтийн алба Санхүү эрхэлсэн захирал 
                                            (<t t-esc="o.chief_acc_short_name or '.....................'"/>)-д ДААЛГАСУГАЙ.
                                        </li>
                                        <li>
                                            Энэхүү тушаалын хэрэгжилтэд хяналт тавьж ажиллахыг Захиргаа, 
                                            Хүний нөөцийн алба Үйл ажиллагаа хариуцсан захирал 
                                            (<t t-esc="o.chief_hr_short_name or '.....................'"/>)-д ҮҮРЭГ БОЛГОСУГАЙ.
                                        </li>
                                    </ol>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт төгсгөл -->
                                </t>

                                <!-- ==== DECR06 Хөдөлмөрийн гэрээг цуцлах тухай ==== --> 
                                <t t-elif="o.decree_template.code == 'DECR06'">
                                    <p style="line-height: 1.1;">
                                        <span style="font-family: monospace; white-space: pre;">┌                                   ┐</span><br/>
                                        <span style="font-family: monospace; white-space: pre;">   Хөдөлмөрийн гэрээг </span><br/>
                                        <span style="font-family: monospace; white-space: pre;">      цуцлах тухай </span><br/>
                                    </p>
                                    <p style="text-align: justify; text-indent: 60px; margin-top: 80px;">
                                        Монгол Улсын Хөдөлмөрийн тухай хуулийн 80.1.4 дэх заалт, Компанийн “Хөдөлмөрийн дотоод журам”-ын 
                                        7 дугаар зүйлийн 7.6.4, 7.6.11 дахь заалтыг тус тус үндэслэн ТУШААХ нь:
                                    </p>
                                    <!-- 🔥 Дугаарлагдсан жагсаалт эхлэл -->
                                    <ol style="margin: 0; padding-left: 25px; text-align: justify; line-height: 1.8;">
                                        <li>
                                            <t t-esc="o.department_id.get_dep_name_mn() or '......................'"/>-нд
                                            <t t-esc="o.position_id.get_job_name_mn() or '......................'"/> албан тушаалтай
                                            <t t-esc="o.employee_id.last_name or '......................'"/> овогтой
                                            <t t-esc="(o.employee_id.name.rsplit('.', 1)[0] if o.employee_id and o.employee_id.name else '......................')"/>
