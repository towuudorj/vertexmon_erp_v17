                    (0, 0, {'name': 'Wednesday', 'dayofweek': '2', 'hour_from': 9, 'hour_to': 18, 'day_period': 'morning'}),
                    (0, 0, {'name': 'Thursday', 'dayofweek': '3', 'hour_from': 9, 'hour_to': 18, 'day_period': 'morning'}),
                    (0, 0, {'name': 'Friday', 'dayofweek': '4', 'hour_from': 9, 'hour_to': 18, 'day_period': 'morning'})
                ]"
            />
        </record>
    </data>
</odoo>