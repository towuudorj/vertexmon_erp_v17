<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="cron_sale_order_reminder" model="ir.cron">
            <field name="name">Leave Allocation: Annual leave Creation</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_annual_leave_allocation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, month=DateTime.now().month+1)).strftime('%Y-%m-%d 00:00:01')"/>
        </record>
    </data>
</odoo>