<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Хүний нөөцийн жагсаалтуудад баганаар шүүх мөр (vertexmon_tools: o_list_column_filter) -->

    <!-- Ажилтан -->
    <record id="hr_employee_tree_column_filter" model="ir.ui.view">
        <field name="name">hr.employee.column.filter</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class" add="o_list_column_filter" separator=" "/>
            </xpath>
        </field>
    </record>

