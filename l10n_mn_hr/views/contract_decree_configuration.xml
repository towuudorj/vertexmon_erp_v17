<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="contract_decree_configuration_tree_view">
        <field name="name">contract.decree.conf.tree</field>
        <field name="model">contract.decree.conf</field>
        <field name="arch" type="xml">
            <tree string="Contract Decree Configuration">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="contract_decree_configuration_form_view">
        <field name="name">contract.decree.conf.form</field>
        <field name="model">contract.decree.conf</field>
        <field name="arch" type="xml">
            <form string="Contract Decree Configuration">
                <h2>
                    <field name="name" readonly="1"/>
                </h2>
                <group>
                    <group>
                        <field name="type"/>
                        <field name="file_name" invisible="1"/>
                        <field name="file" filename="file_name" options="{'accept': '.docx'}"/>
                    </group>
                </group>
                <group>
                    <group colspan="8">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="parent_model" invisible="1" column_invisible="1"/>
                                <field name="text"/>
                                <field name="field" domain="[('model_id', '=', parent_model)]"/>
                                <field name="field2"/>
                                <field name="field3"/>
                            </tree>
                        </field>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_contract_decree_configuration">
        <field name="name">Contract Decree Configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">contract.decree.conf</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="contract_decree_configuration_tree_view"/>
    </record>

    <menuitem
        id="menu_contract_decree_configuration"
        action="l10n_mn_hr.action_contract_decree_configuration"
        parent="hr_contract.menu_human_resources_configuration_contract"
        name="Contract Decree Configuration"
        groups="hr.group_hr_user"/>
</odoo>