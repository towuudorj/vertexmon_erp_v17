<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_employee_kpi_tree" model="ir.ui.view">
            <field name="name">employee.kpi.tree</field>
            <field name="model">employee.kpi</field>
            <field name="arch" type="xml">
                <tree string="Employee KPI">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="manager_employee_id"/>
                    <field name="kpi_template_id"/>
                    <field name="date_type"/>
                    <field name="period_year"/>
                    <field name="total_achieved_percentage"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_employee_kpi_form" model="ir.ui.view">
            <field name="name">employee.kpi.form</field>
            <field name="model">employee.kpi</field>
            <field name="arch" type="xml">
                <form string="Employee KPI">
                    <header>
                        <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'draft' or can_approve == False"/>
                        <button name="action_cancel" string="Cancel" type="object" class="oe_highlight" invisible="state == 'draft' or can_approve == False"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="employee_id" readonly="state == 'approved'"/>
                            <field name="manager_employee_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="kpi_template_id" readonly="state == 'approved'"/>
                            <field name="date_type" readonly="1"/>
                            <field name="period_year" readonly="state == 'approved'"/>
                            <field name="period_month" invisible="date_type != 'month'" required="date_type == 'month'" readonly="state == 'approved'"/>
                            <field name="period_session" invisible="date_type != 'session'" required="date_type == 'session'" readonly="state == 'approved'"/>
                            <field name="period_half" invisible="date_type != 'half_year'" required="date_type == 'half_year'" readonly="state == 'approved'"/>
                            <field name="note" readonly="state == 'approved'"/>
                            <field name="total_achieved_percentage" readonly="1" widget="percentage"/>
                            <field name="can_approve" invisible="1"/>
                        </group>
                        <notebook>
                            <page string="KPI Lines">
                                <field name="line_ids" nolabel="1" readonly="state == 'approved'">
                                    <tree editable="bottom" create="false" delete="false" open_form_view="false">
                                        <field name="template_line_id" invisible="1" force_save="1"/>
                                        <field name="name" readonly="1" force_save="1" options="{'no_open': True}"/>
                                        <field name="weight_percentage" readonly="1" force_save="1" sum="Total Weight Percentage" widget="percentage"/>
                                        <field name="achieved_percentage" sum="Total Achieved Percentage" widget="percentage"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="hr.group_hr_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_employee_kpi" model="ir.actions.act_window">
            <field name="name">Employee KPI</field>
            <field name="res_model">employee.kpi</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
