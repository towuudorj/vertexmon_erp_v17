<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_work_location_tree_view" model="ir.ui.view">
            <field name="name">hr.work.location.tree.inherit.view</field>
            <field name="model">hr.work.location</field>
            <field name="inherit_id" ref="hr.hr_work_location_tree_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='name']" position="before">
                        <field name="code"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="hr_work_location_view_form" model="ir.ui.view">
            <field name="name">hr.work.location.form.inherit.view</field>
            <field name="model">hr.work.location</field>
            <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='name']" position="before">
                        <field name="code"/>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>