<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		
		  <record model="ir.ui.view" id="ndd_type_tree_view">
                <field name="name">Hr payroll prepayment tree</field>
                <field name="model">ndd.type</field>
                <field name="arch" type="xml">
                    <tree string="Hr payroll prepayment">
                    	<field name="company_id"/>
                        <field name="name"/>
                    </tree>
                </field>
            </record>

            <record model="ir.ui.view" id="ndd_type_form_view">
                <field name="name">Ndd type form</field>
                <field name="model">ndd.type</field>
                <field name="arch" type="xml">
                    <form string="Ndd type">
                    	<group>
                    		<field name="company_id" />
                    		<field name="name" />
                        </group>
                       
                    </form>
                </field>
            </record>

            <record model="ir.actions.act_window" id="action_ndd_type_tree_view">
                <field name="name">Ndd type</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">ndd.type</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="ndd_type_tree_view"/>
            </record>


		
		
	</data>
</odoo>