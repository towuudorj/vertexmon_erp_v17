<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		
		<record model="ir.ui.view" id="language_type_tree_view">
                <field name="name">language.type.tree</field>
                <field name="model">language.type</field>
                <field name="arch" type="xml">
                    <tree string="tree_string">
                        <field name="code"/>
                        <field name="company_id"/>
                        <field name="name"/>
                    </tree>
                </field>
            </record>

            <record model="ir.ui.view" id="language_type_form_view">
                <field name="name">language.type.form</field>
                <field name="model">language.type</field>
                <field name="arch" type="xml">
                    <form string="form_string">
                    	<group col="4" colspan="2" >
                    		<field name="company_id" />
                            <field name="code"/>
                        	<field name="name"/>
                        </group>
                        
                    </form>
                </field>
            </record>

            
            

            <record model="ir.actions.act_window" id="action_language_type_tree_view">
                <field name="name">Language type</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">language.type</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="language_type_tree_view"/>
            </record>
		
		
	</data>
</odoo>