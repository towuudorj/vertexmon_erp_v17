<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_kpi_template_tree" model="ir.ui.view">
            <field name="name">kpi.template.tree</field>
            <field name="model">kpi.template</field>
            <field name="arch" type="xml">
                <tree string="KPI Templates">
                    <field name="name"/>
                    <field name="date_type"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_kpi_template_form" model="ir.ui.view">
            <field name="name">kpi.template.form</field>
            <field name="model">kpi.template</field>
            <field name="arch" type="xml">
                <form string="KPI Template">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="date_type"/>
                            <field name="note"/>
                            <field name="job_id"/>
                            <field name="approver_id"/>
                            <field name="approver_title"/>
                            <field name="kpi_amount_note"/>
                            <field name="min_score" widget="percentage"/>
                        </group>
                        <notebook>
                            <page string="Template Lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="criteria" optional="show"/>
                                        <field name="source" optional="show"/>
                                        <field name="target" optional="show"/>
                                        <field name="weight_percentage" widget="percentage" sum="Total Weight Percentage"/>
                                        <field name="source_type"/>
                                        <field name="calc_method"/>
                                        <field name="evaluator" optional="show"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_kpi_line_section_tree" model="ir.ui.view">
            <field name="name">kpi.line.section.tree</field>
            <field name="model">kpi.line.section</field>
            <field name="arch" type="xml">
                <tree string="KPI хэсэг" editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_kpi_line_section" model="ir.actions.act_window">
            <field name="name">KPI хэсэг</field>
            <field name="res_model">kpi.line.section</field>
            <field name="view_mode">tree</field>
        </record>

        <record id="action_kpi_template" model="ir.actions.act_window">
            <field name="name">KPI</field>
            <field name="res_model">kpi.template</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
