<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_kpi_template_tree" model="ir.ui.view">
            <field name="name">kpi.template.tree</field>
            <field name="model">kpi.template</field>
            <field name="arch" type="xml">
                <tree string="KPI Templates">
                    <field name="name"/>
                    <field name="date_type"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_kpi_template_form" model="ir.ui.view">
            <field name="name">kpi.template.form</field>
            <field name="model">kpi.template</field>
            <field name="arch" type="xml">
                <form string="KPI Template">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="date_type"/>
                            <field name="note"/>
                        </group>
                        <notebook>
                            <page string="Template Lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="name" width="70%"/>
                                        <field name="weight_percentage" widget="percentage" sum="Total Weight Percentage"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_kpi_template" model="ir.actions.act_window">
            <field name="name">KPI</field>
            <field name="res_model">kpi.template</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
