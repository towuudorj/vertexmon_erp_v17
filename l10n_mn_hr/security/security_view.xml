<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="group_overtime_request" model="res.groups">
            <field name="name">Илүү цаг ажилтан</field>
        </record>

        <record id="group_overtime_allow" model="res.groups">
	        <field name="name">Илүү цаг зөвшөөрөх</field>
	    </record>
        
        <record id="group_overtime_approve" model="res.groups">
	        <field name="name">Илүү цаг батлах</field>
        </record>

        <!-- Multi-Company Rules for Contract Decree Configuration -->
        <record id="contract_decree_conf_multi_company_rule" model="ir.rule">
            <field name="name">Contract Decree Conf Multi-Company</field>
            <field name="model_id" ref="model_contract_decree_conf"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="contract_configuration_line_multi_company_rule" model="ir.rule">
            <field name="name">Contract Configuration Line Multi-Company</field>
            <field name="model_id" ref="model_contract_configuration_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

    </data>
</odoo>
