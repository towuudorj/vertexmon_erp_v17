<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Added project Sequence -->
    <record id="view_project_mn" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.mn</field>
        <field name="model">project.project</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_favorite']" position="after">
                <field name="sequence_name"/>
                
            </xpath>
        </field>
    </record>
    
    
    <record id="view_project_tree_mn" model="ir.ui.view">
        <field name="name">project.project.view.tree.inherit.mn</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
        	<xpath expr="//field[@name='partner_id']" position="after">
				<field name="product_count"/>        		
        	</xpath>
            <xpath expr="//field[@name='stage_id']" position="replace">
                <field name="state"/>
            </xpath>
        </field>
    </record>
    
    <!-- Inserting Sequence the Kanban view -->
    <record id="view_project_kanban" model="ir.ui.view">
        <field name="name">project.project.view.kanban.inherit.mn</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="/kanban" position="inside">
                <field name="sequence_name"/>
            </xpath>
        </field>
    </record>
    
    
    <!-- Added edit project view -->
    
    
    
    <record id="edit_project" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.mn</field>
        <field name="model">project.project</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
             <header>
                <!-- <button class="btn-secondary" name="action_create_purchase_requisition"
                        type="object"
                        icon="fa-external-link" string="Purchase Requisition"/> -->
                
                <button class="btn-secondary" name="action_confirm"
                        type="object"
                        string="Батлах" invisible="state != 'planned'"/>
                        
                <button class="btn-secondary" name="action_done"
                        type="object"
                        string="Дууссан" invisible="state != 'process'" groups="account.group_account_manager"/>
                
                <button class="btn-secondary" name="action_process"
                        type="object"
                        string="Явагдаж буй" invisible="state != 'confirm'" groups="project.group_project_manager"/>
                
                <button class="btn-secondary" name="action_create_tasks"
                        type="object"
                        icon="fa-tasks" string="Create Tasks"/>
                
                <button class="btn-secondary" name="%(action_local_purchase_request)d"
                        type="action"
                        icon="fa-tasks" string="Create local purchase"/>
                        
                <button class="btn-secondary" name="%(action_foreign_purchase_request)d"
                        type="action"
                        icon="fa-tasks" string="Create foreign purchase"/>
                
                 <!-- <button class="btn-secondary" name="package_task"
                        type="object"
                        icon="fa-tasks" string="Create Packege Tasks"/> -->
            </header>
            
            <xpath expr="//field[@name='stage_id']" position="replace">
                <field name="state" widget="statusbar"/>
            </xpath>  

            <xpath expr="//field[@name='is_favorite']" position="after">
                <field name="sequence_name"/>
            </xpath>
            
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="user_id" readonly="state in ('confirm','done')" />
            </xpath>   
            
            <xpath expr="//field[@name='date_start']" position="replace">
                <field name="date_start" readonly="state in ('confirm','done')" />
            </xpath>   

            <xpath expr="//field[@name='partner_id']" position="replace">
            	<field name="partner_id" readonly="state in ('confirm','done')" />
            	<field name="invoice_product_id"/>
            	<field name="invoice_journal_id" required="state == 'process'"/>
            	<field name="journal_id" string="Журнал" required="state == 'process'"/>
            	<field name="bbo_account_id" string="Данс" required="state == 'process'"/>
            	<field name="close_date" string="Хаасан огноо" required="state == 'process'"/>
            	<field name="close_move_id" readonly="1"/>
            	<field name="invoice_id" readonly="1"/>
                <field name="contract_number" readonly="state in ('confirm','done')" />
                <field name="contract_amount" readonly="state in ('confirm','done')"/>
                <field name="project_total_cost" invisible="state != 'done'"/>
                <field name="project_total_profit" invisible="state != 'done'"/>
                <field name="warehouse_id" readonly="state in ('confirm','done')"/>
                <field name="picking_type_id" readonly="state in ('confirm','done')"/>
                <field name="purchase_manager_id" readonly="state in ('confirm','done')"/>
                <field name="project_type" readonly="state in ('confirm','done')"/>
            </xpath>    
            
            <xpath expr="//page[@name='description']"
                   position="after">
                <page name="project_products" string="Products">
                    <field name="products_line"
                            widget="section_and_note_one2many"
                            mode="tree" readonly="state in ('confirm','done')">
                        <tree string="Project Product Lines"
                                editable="bottom"
                                limit="200">
                            <field name="sequence" widget="handle" />
                            <field name="product_id"/>
                            <field name="name" widget="section_and_note_text" optional="show"/>
                            <field name="product_uom"/>
                            <field name="product_qty"/>
                            <field name="purchase_type"/>
                            <field name="purchase_manager_id"/>
                            <field name="qty_available" string="Нөөцөнд байгаа тоо"/>
                            <field name="qty_available_cost" string="Нөөцөнд байгаа нийт өртөг"/>
                            <field name="qty_delivered" string="Зарлага хийгдсэн тоо"/>
                            <field name="delivery_cost" string="Нийт зарлагын өртөг"/>
                            <field name="last_qty" string="Үлдэгдэл тоо"/>
                            <field name="cost_price"/>
                            <field name="price_unit"/>
                            <field name="change_cost" readonly="1"/>
                            <field name="cost_total" sum="Total Cost" force_save="1"/>
                            <field name="price_total" sum="Total Price" force_save="1"/>
                        </tree>
                    </field>
                     <group class="oe_subtotal_footer oe_right">
                     	<field name="total_cost" string="Нийт өртөг" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="untax_amount" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="total_tax_amount" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="total_amount" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                     </group>
                    <field name="product_notes" class="oe_inline" placeholder="Define your terms and conditions ..."/>
                    <div class="oe_clear"/>
                </page>
                <page string="Шинжилгээний бичилт">
                	<field name="account_analytic_line_ids" readonly="1">
                		<tree >
                			<field name="name"/>
                			<field name="partner_id"/>
                			<field name="account_id"/>
                			<field name="date"/>
                			<field name="amount"/>
                		</tree>
                	</field>
                </page>
            </xpath>        
        </field>
    </record>

     <!-- Added filter project view -->
    <record id="filter_project" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.mn</field>
        <field name="model">project.project</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='name']" position="after">
                <field name="sequence_name"/>
            </xpath>            
        </field>
    </record>

     <record id="project_project_view_form" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_view_purchase_requisition"
                    type="object"
                    icon="fa-shopping-cart">
                    <field string="Худалдан авалт /дотоод захиалга/" name="purchase_requisition_count" widget="statinfo" />
                </button>
                <button
                    class="oe_stat_button"
                    name="action_view_crm_lead"
                    type="object"
                    icon="fa-shopping-cart">
                    <field string="CRM /гадаад захиалга/" name="crm_count" widget="statinfo" />
                </button>
                <button
                    class="oe_stat_button"
                    name="action_view_picking"
                    type="object"
                    icon="fa-shopping-cart">
                    <field string="Зарлагууд" name="picking_count" widget="statinfo" />
                </button>
            </div>
        </field>
    </record>

    <record id="project.open_view_project_all_group_stage_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
    </record>
    <record id="project.open_view_project_all_group_stage_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
    </record>

</odoo>
