<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_foreign_purchase_request" model="ir.ui.view">
        <field name="name">foreign.purchase.request.form</field >
        <field name="model">foreign.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Foreign purchase request">
                <group>
                    <field name="company_id"/>
                    <field name="date"/>
                    <field name="project_id"/>
                    <field name="partner_id"/>
                </group>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="product_id"  options="{'no_create': True, 'no_open': True}" force_save="1"/>
                        <field name="desc"/>
                        <field name="uom_id" />
                        <field name="purchase_user_id"/>
                        <field name="qty"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_create_crm" type="object"
                        string="Create crm"
                        class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_foreign_purchase_request" model="ir.actions.act_window">
        <field name="name">Foreign purchase request</field>
        <field name="res_model">foreign.purchase.request</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_project_project"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>