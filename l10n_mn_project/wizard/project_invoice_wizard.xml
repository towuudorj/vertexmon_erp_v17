<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_invoice" model="ir.ui.view">
        <field name="name">Package Tasks</field>
        <field name="model">project.invoice</field>
        <field name="arch" type="xml">
            <form string="Package Task">
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="invoiced_amount" readonly="1"/>
                    <field name="invoice_amount"/>
                    <field name="payment_type" required="1"/>
                </group>
                <group>
                    <field name="invoice_line_ids" readonly="1">
                        <tree create="0" options="{'no_create': True, 'no_open': True}" editable="top">
                            <field name="move_id"/>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="price_unit" SUM="Total"/>
                            <field name="price_subtotal" SUM="Total"/>
                        </tree>
                    </field>
                </group>


                <footer>
                    <button name="create_invoice" type="object"
                            string="Create Invoice"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_project_invoice">
        <field name="name">Project Invoice</field>
        <field name="res_model">project.invoice</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_project_invoice"/>
        <field name="target">new</field>
    </record>

</odoo>