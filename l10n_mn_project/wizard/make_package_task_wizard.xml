<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_pack_tasks" model="ir.ui.view">
        <field name="name">Package Tasks</field >
        <field name="model">project.package.task.create</field>
        <field name="arch" type="xml">
            <form string="Package Task">

                <group>
                    <field name="name"/>
                    <field name="date"/>
                </group>
                <field name="product_lines">
                    <tree editable="top" create="0">
                        <field name="product_id"  options="{'no_create': True, 'no_open': True}" force_save="1"/>
                        <field name="quantity"/>
                        <field name="uom_id" groups="uom.group_uom"/>
                        <field name="pline_id" column_invisible="True"/>
                    </tree>
                </field>
                
                
               
                <footer>
                    <button name="action_create_packege_tasks" type="object"
                        id="create_packege_tasks_open"
                        string="Create Package Task"
                        class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_view_package_task" model="ir.actions.act_window">
        <field name="name">Create Package Tasks</field>
        <field name="res_model">project.package.task.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_project_project"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>