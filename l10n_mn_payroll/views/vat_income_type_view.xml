<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_vat_income_type_form_view" model="ir.ui.view">
            <field name="name">vat.income.type.form</field>
            <field name="model">vat.income.type</field>
            <field name="arch" type="xml">
            <form string="VAT Income Type">
                <sheet>
                <group>
                    <field name="company_id"/>
                    <field name="name"/>
                    <field name="code"/>
                </group>
                </sheet>
            </form>
            </field>
        </record>

        <record id="view_vat_income_type_tree_view" model="ir.ui.view">
            <field name="name">vat.income.type.tree</field>
            <field name="model">vat.income.type</field>
            <field name="arch" type="xml">
            <tree string="VAT Income Type">
                <field name="company_id"/>
                <field name="name"/>
                <field name="code"/>
            </tree>
            </field>
        </record>

        <record id="action_vat_income_type_tree_view" model="ir.actions.act_window">
            <field name="name">VAT Income Type</field>
            <field name="res_model">vat.income.type</field>
            <field name="view_mode">tree,form</field>
        </record>
        
    </data>
</odoo>