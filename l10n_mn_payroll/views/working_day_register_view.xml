<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
 			
 			<record model="ir.ui.view" id="working_day_register_tree_view">
                <field name="name">working.day.register.tree</field>
                <field name="model">working.day.register</field>
                <field name="arch" type="xml">
                    <tree string="Working day register">
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="state"/>
                    </tree>
                </field>
            </record>

            <record model="ir.ui.view" id="working_day_register_form_view">
                <field name="name">working.day.register.form</field>
                <field name="model">working.day.register</field>
                <field name="arch" type="xml">
                    <form string="Shift holiday register">
                        <header>
                            <button name="action_confirm" class="oe_highlight" string="Батлах" invisible="state != 'draft'"  type="object" />
                            <field name="state" widget="statusbar" />
                        </header>
                        <sheet>
                            <group col="4" colspan="4">
                                <group col="2" colspan="2" >
                                    <field name="company_id" readonly="state != 'draft'"/>
                                    <field name="end_date" readonly="state != 'draft'"/>
                                </group>
                                <group col="2" colspan="2" >
                                    <field name="name" readonly="state != 'draft'"/>
                                    <field name="start_date" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="medium">
                                    <field name="name"/>
                                    <field name="work_day"/>
                                </tree>
                            </field>
                            <div class="oe_chatter">
                                <field name="message_follower_ids" widget="mail_followers"/>
                                <field name="message_ids" widget="mail_thread"/>
                            </div>
		                </sheet>
                    </form>
                </field>
            </record>
            

            <record model="ir.actions.act_window" id="action_working_day_register_tree_view">
                <field name="name">Working day register</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">working.day.register</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="working_day_register_tree_view"/>
            </record>
 			
 			   
    </data>
</odoo>