<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_payslip_run_inherit_form" model="ir.ui.view">
	        <field name="name">hr.payslip.run.form.mn.inherit</field>
	        <field name="model">hr.payslip.run</field>
	        <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_form"/>
	        <field name="arch" type="xml">
	            <data>
					<xpath expr="//sheet/label[@for='name']" position="before">
						<group name="payslip_type">
							<field name="payslip_type" widget="radio" options="{'horizontal': true}"
								   readonly="state != 'draft' or slip_ids"/>
						</group>
					</xpath>
					<xpath expr="//sheet/h1" position="after">
						<group name="final_period" invisible="payslip_type != 'final'">
							<field name="advance_run_id"
								   readonly="state != 'draft'" options="{'no_create': True}"/>
						</group>
					</xpath>
					<xpath expr="//field[@name='credit_note']" position="after">
                        <field name="dep_id"/>
					</xpath>
					<xpath expr="//field[@name='slip_ids']" position="attributes">
						<attribute name="class">o_x2many_sticky_header o_sticky_first_3_cols</attribute>
					</xpath>
					<xpath expr="//field[@name='slip_ids']" position="inside">
						<!-- Урьдчилгааны багцад зөвхөн урьдчилгааны дүнг мөр дээр засна; сүүл цалингийн баганууд нуугдана -->
						<tree editable="bottom" create="0" open_form_view="True" class="o_x2many_sticky_header o_sticky_first_3_cols o_list_column_filter"
							  decoration-info="state == 'done'" decoration-muted="state == 'cancel'" limit="300">
							<field name="employee_last_name" width="120px" readonly="1"/>
							<field name="employee_first_name" width="120px" readonly="1"/>
							<field name="employee_department_id" width="180px" readonly="1"/>
							<field name="employee_bank_account" width="130px" optional="show" readonly="1"/>
							<field name="wage_amount" width="110px" sum="Нийт" readonly="1"/>
							<field name="advance_must_hours" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type != 'advance'"
								   readonly="state != 'draft'"/>
							<field name="advance_worked_hours" width="110px" sum="Нийт" string="Ажилласан цаг"
								   column_invisible="parent.payslip_type != 'advance'"
								   readonly="state != 'draft'"/>
							<field name="prepayment_amount" width="130px" sum="Нийт"
								   column_invisible="parent.payslip_type != 'advance'"
								   readonly="state != 'draft'"/>
							<field name="month_work_days" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="month_work_hours" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="worked_days" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="worked_hours" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="overtime_hours" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="overtime_amount" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="computed_salary" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="vacation_amount" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="performance_amount" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="other_allowance_amount" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="allowance_total" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="gross_amount" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="advance_amount" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft' or parent.advance_run_id != False"/>
							<field name="ndsh_employee_amount" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="ndsh_company_amount" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="pit_amount" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="phone_deduction_amount" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="receivable_deduction_amount" width="110px" sum="Нийт" optional="show"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="state != 'draft'"/>
							<field name="deduction_total" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="net_amount" width="110px" sum="Нийт"
								   column_invisible="parent.payslip_type == 'advance'"
								   readonly="1"/>
							<field name="employee_register" width="110px" optional="show" readonly="1"/>
							<field name="employee_id" column_invisible="1"/>
							<field name="payslip_type" column_invisible="1"/>
							<field name="state" column_invisible="1"/>
						</tree>
					</xpath>
					<xpath expr='//button[@name="done_payslip_run"]' position="after">
						<button string="Хэвлэх" name="action_print_xls_report" type="object"
								class="oe_highlight"/>
						<button string="Импортлох" name="action_open_import_wizard" type="object"
								invisible="state != 'draft'"/>
					</xpath>
				</data>
			</field>
		</record>

		<record id="hr_payslip_run_inherit_tree" model="ir.ui.view">
			<field name="name">hr.payslip.run.tree.mn.inherit</field>
			<field name="model">hr.payslip.run</field>
			<field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_tree"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='name']" position="after">
					<field name="payslip_type"/>
				</xpath>
			</field>
		</record>

		<record id="hr_payslip_run_inherit_filter" model="ir.ui.view">
			<field name="name">hr.payslip.run.search.mn.inherit</field>
			<field name="model">hr.payslip.run</field>
			<field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_filter"/>
			<field name="arch" type="xml">
				<xpath expr="//search" position="inside">
					<filter name="advance" string="Урьдчилгаа цалин" domain="[('payslip_type', '=', 'advance')]"/>
					<filter name="final" string="Сүүл цалин" domain="[('payslip_type', '=', 'final')]"/>
					<group expand="0" string="Group By">
						<filter name="group_payslip_type" string="Цалингийн төрөл" context="{'group_by': 'payslip_type'}"/>
					</group>
				</xpath>
			</field>
		</record>

		<record id="view_hr_payslip_run_import_wizard" model="ir.ui.view">
			<field name="name">hr.payslip.run.import.wizard.form</field>
			<field name="model">hr.payslip.run.import.wizard</field>
			<field name="arch" type="xml">
				<form string="Цалингийн тайлан импортлох">
					<sheet>
						<group>
							<field name="run_id" invisible="1"/>
							<field name="data_file" filename="filename" string="Excel файл сонгох"/>
							<field name="filename" invisible="1"/>
						</group>
						<p class="text-muted">
							Татаж авсан Excel тайлангийн мөрүүдийг засварлаад энэ хэсгээр оруулснаар ажилласан хоног, цаг (worked_days) болон цалингийн дүрмүүдийн дүн (line_ids) автоматаар шинэчлэгдэнэ.
						</p>
					</sheet>
					<footer>
						<button name="action_import" string="Импортлох" type="object" class="btn-primary"/>
						<button string="Хаах" class="btn-secondary" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>

    </data>
</odoo>
