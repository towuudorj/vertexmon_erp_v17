<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_payslip_run_inherit_form" model="ir.ui.view">
	        <field name="name">hr.payslip.run.form.mn.inherit</field>
	        <field name="model">hr.payslip.run</field>
	        <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_form"/>
	        <field name="arch" type="xml">
	            <data>
					<xpath expr="//field[@name='credit_note']" position="after">
                        <field name="dep_id"/>
					</xpath>
					<xpath expr="//field[@name='slip_ids']" position="inside">
						<tree decoration-info="state == 'done'" decoration-muted="state == 'cancel'">
							<field name="employee_last_name" width="120px"/>
							<field name="employee_first_name" width="120px"/>
							<field name="employee_department_id" width="180px"/>
							<field name="employee_bank_account" width="130px" optional="show"/>
							<field name="wage_amount" width="110px" sum="Нийт"/>
							<field name="month_work_days" width="110px" sum="Нийт" optional="show"/>
							<field name="month_work_hours" width="110px" sum="Нийт" optional="show"/>
							<field name="worked_days" width="110px" sum="Нийт"/>
							<field name="worked_hours" width="110px" sum="Нийт"/>
							<field name="overtime_hours" width="110px" sum="Нийт" optional="show"/>
							<field name="overtime_amount" width="110px" sum="Нийт" optional="show"/>
							<field name="computed_salary" width="110px" sum="Нийт"/>
							<field name="vacation_amount" width="110px" sum="Нийт" optional="show"/>
							<field name="performance_amount" width="110px" sum="Нийт" optional="show"/>
							<field name="other_allowance_amount" width="110px" sum="Нийт" optional="show"/>
							<field name="allowance_total" width="110px" sum="Нийт"/>
							<field name="gross_amount" width="110px" sum="Нийт"/>
							<field name="advance_amount" width="110px" sum="Нийт"/>
							<field name="ndsh_employee_amount" width="110px" sum="Нийт"/>
							<field name="ndsh_company_amount" width="110px" sum="Нийт"/>
							<field name="pit_amount" width="110px" sum="Нийт"/>
							<field name="pit_percent" width="70px" string="%" optional="show"/>
							<field name="phone_deduction_amount" width="110px" sum="Нийт" optional="show"/>
							<field name="receivable_deduction_amount" width="110px" sum="Нийт" optional="show"/>
							<field name="deduction_total" width="110px" sum="Нийт"/>
							<field name="net_amount" width="110px" sum="Нийт"/>
							<field name="employee_register" width="110px" optional="show"/>
							<field name="employee_id" column_invisible="1"/>
							<field name="state" column_invisible="1"/>
						</tree>
					</xpath>

				</data>
			</field>
		</record>

    </data>
</odoo>
