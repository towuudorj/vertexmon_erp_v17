<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    	
    	
    	
    	<record id="payroll_prepayment_report_view" model="ir.ui.view">
            <field name="name">hr.payroll.prepayment.report</field>
            <field name="model">payroll.prepayment.report</field>
            <field name="arch" type="xml">
                <form string="Hr payroll prepayment">
                    <footer>
                        <button name="export_report" string="Report export" type="object" class="oe_highlight" />
                        or
                        <button string="Close" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hr_payroll_prepayment_report" model="ir.actions.act_window">
            <field name="name">Hr payroll prepayment</field>
            <field name="res_model">payroll.prepayment.report</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="payroll_prepayment_report_view"/>
            <field name="target">new</field>
        </record>
        
        
    
    </data>
</odoo>