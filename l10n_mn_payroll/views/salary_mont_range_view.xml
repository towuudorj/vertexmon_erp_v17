<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="hr_salary_month_range_tree_view">
            <field name="name">salary.month.range.tree</field>
            <field name="model">salary.month.range</field>
            <field name="arch" type="xml">
                <tree string="Salary Month Range">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="hr_salary_month_range_form_view">
            <field name="name">salary.month.range.form</field>
            <field name="model">salary.month.range</field>
            <field name="arch" type="xml">
                <form string="Salary Month Range">
                    <sheet>
                        <group>
                            <field name="year" widget="no_format_integer"/>
                            <field name="month"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="action_hr_salary_month_range">
            <field name="name">Salary Month Range</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">salary.month.range</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="hr_salary_month_range_tree_view"/>
        </record>

    </data>
</odoo>