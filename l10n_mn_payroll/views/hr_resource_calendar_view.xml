<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		
			<record id="view_resource_calendar_payroll_mn_inherit_form" model="ir.ui.view">
	            <field name="name">resource.calendar.inherit.payroll.mn.form</field>
	            <field name="model">resource.calendar</field>
	            <field name="inherit_id" ref="resource.resource_calendar_form"/>
	            <field name="arch" type="xml">
	            	<data>
	            		<field name="tz" position="after">
	                          <field name="work_time" widget="float_time"/>
	                          <field name="lunchtime_start" widget="float_time"/>
	                          <field name="lunchtime_end" widget="float_time"/>
	                    </field>
	            	</data>
	           </field>
	        </record>
		
	</data>
</odoo>