<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>

		<record id="hr_contract_cash_inherit_form" model="ir.ui.view">
	        <field name="name">hr.contract.form.cash.inherit</field>
	        <field name="model">hr.contract</field>
	        <field name="inherit_id" ref="om_hr_payroll.hr_contract_form_inherit"/>
	        <field name="arch" type="xml">
	            <data>
					<xpath expr='//group[@name="allowances"]' position="replace">
					</xpath>
					<xpath expr="//field[@name='date_end']" position="after">
                        <field name="trial_end_date"/>
					</xpath>

				</data>
			</field>
		</record>
    	
		<record id="hr_contract_inherit_form" model="ir.ui.view">
	        <field name="name">hr.contract.form.inherit</field>
	        <field name="model">hr.contract</field>
	        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
	        <field name="arch" type="xml">
					<data>
						<xpath expr='//group[@name="salary_info"]' position="after">
							<group name="phone_add">
								<label for="phone_add"/>
								<div class="o_row mw-50" name="phone_add">
									<field name="phone_add" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								</div>
								<label for="administration_add"/>
								<div class="o_row mw-50" name="administration_add">
									<field name="administration_add" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								</div>
								<label for="food_and_vehicle_add"/>
								<div class="o_row mw-50" name="food_and_vehicle_add">
									<field name="food_and_vehicle_add" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								</div>
								<label for="long_year_add"/>
								<div class="o_row mw-50" name="long_year_add">
									<field name="long_year_add" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								</div>
								<label for="health_insurance"/>
								<div class="o_row mw-50" name="health_insurance">
									<field name="health_insurance" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								</div>
								<label for="accident_insurance"/>
								<div class="o_row mw-50" name="accident_insurance">
									<field name="accident_insurance" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								</div>
								<label for="voucher"/>
								<div class="o_row mw-50" name="voucher">
									<field name="voucher" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								</div>
								<label for="abnormal_add"/>
								<div class="o_row mw-50" name="abnormal_add">
									<field name="abnormal_add" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								</div>
							</group>
						</xpath>
						<xpath expr='//field[@name="contract_type_id"]' position="after">
							<field name="insurance_type_id" required="1"/>
						</xpath>
					</data>
	        </field>
    	</record>
	</data>
</odoo>