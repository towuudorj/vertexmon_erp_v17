<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="res_partner_bank_inherit_form" model="ir.ui.view">
            <field name="name">res.partner.bank.form.mn.inherit</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="account.view_partner_bank_form_inherit_account"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='currency_id']" position="after">
                        <field name="is_salary_account"/>
                    </xpath>

                </data>
            </field>
        </record>

    </data>
</odoo>
