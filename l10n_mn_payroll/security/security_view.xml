<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		
		
		<record id="group_hr_shift_holiday_work" model="res.groups">
	        <field name="name">Ээлжийн амралт бодох</field>
	    </record>
		
		<record id="group_hr_confirm" model="res.groups">
	        <field name="name">ХНМ Батлах</field>
	    </record>
	    
	    <record id="group_manager_confirm" model="res.groups">
	        <field name="name">Албаны менежер Батлах</field>
	    </record>
	    
	    <record id="group_hr_done" model="res.groups">
	        <field name="name">ХНМ Дуусгах</field>
	    </record>
	    
	    <record id="hr_hour_record_domain" model="ir.rule">
	        <field name="name">hr.hour.record</field>
	        <field name="model_id" ref="l10n_mn_payroll.model_hr_hour_record"/>
	        <field name="domain_force">[('department.manager_id', '=', user.employee_id.id)]</field>
	        <field name="groups" eval="[(4, ref('group_manager_confirm'))]"/>
	        <field name="perm_create" eval="1"/>
	        <field name="perm_write" eval="1"/>
	        <field name="perm_unlink" eval="1"/>
	        <field name="perm_read" eval="1"/>
	    </record>
		
		
		<record id="hr_hour_record_domain_all" model="ir.rule">
	        <field name="name">hr.hour.record</field>
	        <field name="model_id" ref="l10n_mn_payroll.model_hr_hour_record"/>
	        <field name="domain_force">[(1, '=', 1)]</field>
	        <field name="groups" eval="[(4, ref('group_hr_done'))]"/>
	        <field name="perm_create" eval="1"/>
	        <field name="perm_write" eval="1"/>
	        <field name="perm_unlink" eval="1"/>
	        <field name="perm_read" eval="1"/>
	    </record>
		
	</data>
</odoo>