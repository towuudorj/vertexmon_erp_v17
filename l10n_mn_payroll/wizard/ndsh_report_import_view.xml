<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
	
		<record id="ndsh_report_import_view" model="ir.ui.view">
            <field name="name">ndsh.report.import</field>
            <field name="model">ndsh.report.import</field>
            <field name="arch" type="xml">
               <form string="ndsh report import">
               		<group>
               			<field name="company_id"/>
               			<field name="start_date"/>
               			<field name="end_date"/>
               		</group>
                     <footer>
                       <button name="export_report" string="Report export" type="object" class="oe_highlight" />
                       or
                       <button string="Close" class="oe_link" special="cancel" />
                     </footer>
               </form>
            </field>
        </record>

        <record id="action_ndsh_report_import" model="ir.actions.act_window">
            <field name="name">Ndsh import report</field>
            <field name="res_model">ndsh.report.import</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ndsh_report_import_view"/>
            <field name="target">new</field>
        </record>
		
		
	</data>
</odoo>