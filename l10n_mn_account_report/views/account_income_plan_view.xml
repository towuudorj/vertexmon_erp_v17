<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>

		<record id="account_income_plan_tree_view" model="ir.ui.view">
			<field name="name">account.income.plan.tree</field>
			<field name="model">account.income.plan</field>
			<field name="arch" type="xml">
				<tree string="Income report annual plan">
					<field name="name"/>
					<field name="year"/>
					<field name="company_id"/>
					<field name="state"/>
				</tree>
			</field>
		</record>

		<record id="account_income_plan_form_view" model="ir.ui.view">
			<field name="name">account.income.plan.form</field>
			<field name="model">account.income.plan</field>
			<field name="arch" type="xml">
				<form string="Income report annual plan">
					<header>
						<button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
								invisible="state != 'draft'"/>
						<button name="action_draft" string="Set to draft" type="object"
								invisible="state != 'confirmed'"/>
						<field name="state" widget="statusbar"/>
					</header>
					<sheet>
						<h1><field name="name"/></h1>
						<group>
							<group>
								<field name="year" readonly="state == 'confirmed'"/>
							</group>
							<group>
								<field name="company_id"
									   readonly="state == 'confirmed'"/>
							</group>
						</group>
						<field name="line_ids" readonly="state == 'confirmed'">
							<tree editable="bottom">
								<field name="company_id" column_invisible="1"/>
								<field name="income_type_id" options="{'no_create': True}"/>
								<field name="m01" sum="Total"/>
								<field name="m02" sum="Total"/>
								<field name="m03" sum="Total"/>
								<field name="m04" sum="Total"/>
								<field name="m05" sum="Total"/>
								<field name="m06" sum="Total"/>
								<field name="m07" sum="Total"/>
								<field name="m08" sum="Total"/>
								<field name="m09" sum="Total"/>
								<field name="m10" sum="Total"/>
								<field name="m11" sum="Total"/>
								<field name="m12" sum="Total"/>
								<field name="q1" optional="show"/>
								<field name="q2" optional="show"/>
								<field name="q3" optional="show"/>
								<field name="q4" optional="show"/>
								<field name="year_total" sum="Total"/>
							</tree>
						</field>
					</sheet>
					<div class="oe_chatter">
						<field name="message_follower_ids"/>
						<field name="message_ids"/>
					</div>
				</form>
			</field>
		</record>

		<record id="action_account_income_plan" model="ir.actions.act_window">
			<field name="name">Income report annual plan</field>
			<field name="res_model">account.income.plan</field>
			<field name="view_mode">tree,form</field>
		</record>

	</data>
</odoo>
