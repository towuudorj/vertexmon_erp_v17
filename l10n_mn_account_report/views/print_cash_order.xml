<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

	<template id="print_cash_order_report_datas">   
   	 	<t t-call="web.html_container">
        	 <t t-foreach="docs" t-as="o">
        	 <t t-call="web.external_layout">
                <div class="page" t-if="o.amount &lt; 0">

                    
                    <style>
				              table{
				                width: 100%;
				              }
				              .solid{
				                background-color: grey;
				                background-size: auto;
				                border:1px solid black;
				                padding: 5px;
				              }
				              .box{
				                background-size: auto;
				                border:1px solid black;
				                padding: 5px;
				              }
					</style>
					<p style="text-align:right; font-size: 12px; padding-left:10%;padding-right:40%;">
		       		<span>НХМаягт МХ3</span>
		       		<br/>
		       		</p>
                	<p style="text-align:right; font-size: 12px; padding-left:10%; padding-right:40%;">
		       		<span>Санхүү, эдийн засгийн сайд, Үндэсний статистикийн газрын 
                                   даргын 2017 оны 12-р сарын 05-ний 347
                                   тоот тушаалын хавсралт</span>
		       		<br/>
		       		</p>
		       		
		       		
			        
			        <p style="width:60%; font-weight: bold; text-align:center; font-size: 16px; padding-left:0%;">
		       		<span>Бэлэн мөнгөний зарлагын баримт</span>
		       		</p>
                    
                    
                    <table style="width:60%; padding-right:10%;padding-left:10%; border: transparent 1px solid; ">
                        <tr>
	                        <td  style="text-align:left;">
	                           <h4>№ <span t-field="o.statement_id.name"/>/<span t-field="o.sequence"/></h4>
	                        </td>
	                        
	                        <td style=" text-align:right;">
	                        	<span>Огноо :</span> <span t-field="o.date"/>
	                        </td>
                       </tr>
                       <tr>
                            <td>
                            	<span>Байгууллагын нэр :</span> <b t-field="o.company_id.name"/>
	                        </td>
	                         </tr>
	                       
	                    		
	                    		<t t-set="statement_amount" t-value="abs(o.amount)"/>
	                       
	                        <tr>
	                        	<td>
	                        	<span>Мөнгө хүлээн авагч: <b t-field="o.partner_id"/></span>
	                        	</td>

	                        </tr>


                                   <tr><td colspan="2"><span>Гүйлгээний утга :</span> <b t-if="o.payment_ref" t-field="o.name"/></td></tr>
                                   <tr><td colspan="2">Олгосон мөнгөний дүн : <span t-esc="statement_amount"/> ( үсгээр ) <span  t-field="o.amount_text"/>
                                       </td></tr>
                                   <tr><td colspan="2"><span>Хавсаргасан баримт :</span>................................</td></tr>
                            
                      
                       
 
                        
                        <tr >
                                <td style="text-align:left; padding-left:10%;">
                                	<span>Захирал :</span> ...............................................................
                                </td>
                                </tr>
                                <tr>
                                <td style="text-align:left; padding-left:10%;">
                                	<span>Нягтлан бодогч :</span> ................................................
                                </td>
                                </tr>

                                 <tr>
                                <td style="text-align:left; padding-left:10%;">
                                	<span>Хүлээн авагч :</span> .....................................................
                                </td>
                        		</tr>
                    </table>
                    
                    
                    
                </div>
                
                <div class="page" t-if="o.amount &gt; 0">
                    <p style="text-align:right; font-size: 12px; padding-left:10%;padding-right:40%;">
		       		<span>НХМаягт МХ3</span>
		       		<br/>
		       		</p>
                	<p style="text-align:right; font-size: 12px; padding-left:10%; padding-right:40%;">
		       		<span>Санхүү, эдийн засгийн сайд, Үндэсний статистикийн газрын 
                                   даргын 2017 оны 12-р сарын 05-ний 347
                                   тоот тушаалын хавсралт</span>
		       		<br/>
		       		</p>
		       		
		       		
			        
			        <p style="width:60%; font-weight: bold; text-align:center; font-size: 16px; padding-left:0%;">
		       		<span>Бэлэн мөнгөний орлогын баримт</span>
		       		</p>
                    
                    
                    <table style="width:60%; padding-right:10%; border: transparent 1px solid; ">
                        <tr>
	                        <td  style="text-align:left;">
	                           <h4>№ <span t-field="o.statement_id.name"/>/<span t-field="o.sequence"/></h4>
	                        </td>
	                        
	                        <td style=" text-align:right;">
	                        	<span>Огноо :</span> <span t-field="o.date"/>
	                        </td>
                       </tr>
                       <tr>
                            <td>
                            	<span>Байгууллагын нэр :</span> <b t-field="o.company_id.name"/>
	                        </td>
	                         </tr>
	                       
	                    		
	                    		<t t-set="statement_amount" t-value="abs(o.amount)"/>
	                       
	                        <tr>
	                        	<td>
	                        	<span>Мөнгө хүлээн авагч: <b t-field="o.partner_id"/></span>
	                        	</td>

	                        </tr>


                                   <tr><td colspan="2"><span>Гүйлгээний утга :</span> <b t-if="o.payment_ref" t-field="o.name"/></td></tr>
                                   <tr><td colspan="2">Олгосон мөнгөний дүн : <span t-esc="statement_amount"/> ( үсгээр ) <span  t-field="o.amount_text"/>
                                       </td></tr>
                                   <tr><td colspan="2"><span>Хавсаргасан баримт :</span>................................</td></tr>
                        
                        <tr >
                                <td style="text-align:left; padding-left:10%;">
                                <span>Захирал :</span> ...............................................................
                                </td>
                                </tr>
                                <tr>
                                <td style="text-align:left; padding-left:10%;">
                                	<span>Нягтлан бодогч :</span> ................................................
                                </td>
                                </tr>

                                 <tr>
                                <td style="text-align:left; padding-left:10%;">
                                	<span>Хүлээн авагч :</span> .....................................................
                                </td>
                        		</tr>
                    </table>
                    
                    
                    
                </div>

                
                
                <div class="page" t-if="o.amount == 0">
                    
                    <h2>Гүйлгээний дүнг оруулна уу!</h2>
                    
                </div>
                </t>
            </t>
         </t>
     
	</template>

    <template id="print_cash_order_report_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_mn_account_report.print_cash_order_report_datas" t-lang="lang"/>
            </t>
        </t>
    </template>

    </data>
</odoo>