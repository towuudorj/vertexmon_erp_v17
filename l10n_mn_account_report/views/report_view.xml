<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>

        <record id="cash_order_report" model="ir.actions.report">
            <field name="name">Cash Order</field>
            <field name="model">account.bank.statement.line</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_mn_account_report.print_cash_order_report_pdf</field>
            <field name="report_file">l10n_mn_account_report.print_cash_order</field>
            <field name="binding_model_id" ref="model_account_bank_statement_line"/>
            <field name="binding_type">report</field>
        </record>

        <record id="payment_order_report_data_new_pdf" model="ir.actions.report">
           <field name="name">Payment Order</field>
           <field name="model">account.bank.statement.line</field>
           <field name="report_type">qweb-pdf</field>
           <field name="report_name">l10n_mn_account_report.payment_order_report</field>
           <field name="report_file">l10n_mn_account_report.payment_order</field>
           <field name="print_report_name">'payment_order_pdf'</field>
           <field name="binding_model_id" ref="model_account_bank_statement_line"/>
           <field name="binding_type">report</field>
        </record>

        <record id="payment_order_transport_report_data" model="ir.actions.report">
           <field name="name">Payment Order /Transport/</field>
           <field name="model">account.bank.statement.line</field>
           <field name="report_type">qweb-pdf</field>
           <field name="report_name">l10n_mn_account_report.payment_order_transport_report</field>
           <field name="report_file">l10n_mn_account_report.payment_order_transport</field>
           <field name="print_report_name">'payment_order_pdf'</field>
           <field name="binding_model_id" ref="model_account_bank_statement_line"/>
           <field name="binding_type">report</field>
        </record>

	</data>
</odoo>