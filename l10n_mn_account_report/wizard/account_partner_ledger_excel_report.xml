<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    
    
        <record id="account_partner_ledger_excel_report_view" model="ir.ui.view">
            <field name="name">Partner Ledger</field>
            <field name="model">account.partner.ledger.excel.report</field>
            <field name="arch" type="xml">
	             <form string="Partner ledger report">
					<group col="4" colspan="4">
						<field name="company_id"/>
						<field name="fiscalyear_id"/>
						<field name="target_move"/>
						<field name="is_transaction"/>
						<field name="account_id"/>
						<field name="result_selection"/>
						<field name="partner_id"/>
						<field name="filter"/>
						<field name="is_extra"/>
					</group>
					<group string="Date" colspan="4" col="4">
                        <field name="start_date" />
                        <field name="end_date" />
                    </group>
					<notebook>
						<page string="Journals" name="journal_ids">
	                        <field name="account_journal_ids"/>
	                    </page>
					</notebook>
					<footer>
                        <button name="action_print_xls_report" string="Export" type="object" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
				</form>
            </field>
        </record>
        
    	<record id="action_account_partner_ledger_excel_report" model="ir.actions.act_window">
             <field name="name">Partner ledger report</field>
             <field name="res_model">account.partner.ledger.excel.report</field>
             <field name="type">ir.actions.act_window</field>
             <field name="view_mode">tree,form</field>
             <field name="view_id" ref="account_partner_ledger_excel_report_view"/>
             <field name="target">new</field>
       </record>
       
    
    </data>
</odoo>