<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_picking_form" model="ir.ui.view">
            <field name="name">stock.picking.form.effictve.date</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_done']" position="attributes">
                    <attribute name="invisible">False</attribute>
                    <attribute name="force_save">"1"</attribute>
                    <attribute name="readonly">"state in ('cancel', 'done')"</attribute>
                </xpath>
            </field>
        </record>
        <record id="stock_valuation_layer_tree" model="ir.ui.view">
            <field name="name">stock.valuation.layer.tree.effictve.date</field>
            <field name="model">stock.valuation.layer</field>
            <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='create_date']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
                <xpath expr="//field[@name='create_date']" position="after">
                    <field name="date_done" optional="show"/>
                </xpath>
            </field>
        </record>

</odoo>
