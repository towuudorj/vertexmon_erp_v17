<odoo>
    <record id="project_task_multi_user_inherited_project_task_multi_user_form_view" model="ir.ui.view">
        <field name="name">project.task.multi.user.inherited.project.task.multi.user.form.view</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
             <xpath expr="//sheet/group/group[1]" position="inside">
                <field name="user_ids" widget="many2many_tags" group="eg_project_task_multi_user.project_display_multi_user_task_group"/>
            </xpath>
        </field>
    </record>
    <record id ="project_task_multi_users_inherited_project_task_multi_users_tree_view" model="ir.ui.view">
        <field name="name">project.task.multi.user.inherited.project.task.multi.user.tree.view</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="user_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
    <record id="project_task_multi_users_inherited_project_task_multi_users_kanban_view" model="ir.ui.view">
        <field name="name">project.task.multi.user.inherited.project.task.multi.user.kanban.view</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban_inherit_my_task"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <field name="user_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
