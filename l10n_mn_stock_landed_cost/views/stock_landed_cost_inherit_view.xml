<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mn_stock_landed_cost_search_view" model="ir.ui.view">
            <field name="name">stock.landed.cost.inherit.search</field>
            <field name="model">stock.landed.cost</field>            
            <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_search"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='name']" position="after">
                	<field name="po_ids"/>
                </xpath>
            </field>
		</record>

        <record id="mn_stock_landed_cost_tree_view" model="ir.ui.view">
            <field name="name">stock.landed.cost.inherit.tree</field>
            <field name="model">stock.landed.cost</field>            
            <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_tree"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='date']" position="after">
                	<field name="po_ids" widget="many2many_tags"/>
                </xpath>
            </field>
		</record>

        <record id="mn_stock_landed_cost_view" model="ir.ui.view">
            <field name="name">stock.landed.cost.inherit.form</field>
            <field name="model">stock.landed.cost</field>            
            <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='picking_ids']" position="before">
                    <field name="currency_id" />
                	<field name="po_ids" widget="many2many_tags"/>
                </xpath>

                <xpath expr="//sheet/notebook/page[@name='valuation_adjustments']/field[@name='valuation_adjustment_lines']/tree/field[@name='final_cost']" position="after">
                    <field name="unit_price" />
                </xpath>
            </field>
		</record>

    </data>
</odoo>
