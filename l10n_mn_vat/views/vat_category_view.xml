<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="vat_category_tree_view">
            <field name="name">vat.category.tree</field>
            <field name="model">vat.category</field>
            <field name="arch" type="xml">
                <tree string="tree_string">
                    <field name="code"/>
                    <field name="name" />
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vat_category_form_view">
            <field name="name">vat.category.form</field>
            <field name="model">vat.category</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <group col="4" colspan="2">
                        <field name="company_id"/>
                        <field name="name" />
                        <field name="code"/>
                        <field name="type"/>
                        <field name="parent_id"/>
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_vat_category">
            <field name="name">Vat category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vat.category</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="vat_category_tree_view"/>
        </record>
        

    </data>
</odoo>
