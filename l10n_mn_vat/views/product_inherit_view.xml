<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <record id="mn_vat_inherit_product_product_view" model="ir.ui.view">
            <field name="name">inherit.mn.vat.product.form</field>
            <field name="model">product.template</field>            
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='barcode']" position="after">   
                	<field name="is_send_tax"/>
					<field name="tax_type" invisible = "is_send_tax == False" required="is_send_tax == True"/>
					<field name="barcode_type" invisible = "is_send_tax == False" required="is_send_tax == True"/>
					<field name="tax_product_code" invisible = "is_send_tax == False" required="is_send_tax == True"/>
                </xpath>
            </field>
		</record>
        
    </data>
</odoo>
