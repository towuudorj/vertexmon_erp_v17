<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_vat_district_form" model="ir.ui.view">
            <field name="name">vat.district.form</field>
            <field name="model">vat.district</field>
            <field name="arch" type="xml">
                <form string="Job">
                    <sheet>
                    	<div class="oe_title">
                            <label for="company_id"/>
                            <h1><field name="company_id" /></h1>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" /></h1>
                        </div>
                        
                        <div class="oe_title">
                            <label for="code"/>
                            <h1><field name="code" /></h1>
                        </div>

                        <div class="oe_title">
                            <label for="parent_id"/>
                            <h1><field name="parent_id" /></h1>
                        </div>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" options="{'open_attachments': True}"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_vat_district_tree" model="ir.ui.view">
            <field name="name">vat.district.tree</field>
            <field name="model">vat.district</field>
            <field name="arch" type="xml">
               	<tree string="Vat district">
                	<field name="parent_id"/>
                    <field name="name"/>
                    <field name="code"/>
                </tree>
            </field>
        </record>


        <record id="view_vat_district_filter" model="ir.ui.view">
            <field name="name">vat.district.search</field>
            <field name="model">vat.district</field>
            <field name="arch" type="xml">
                <search string="Vat district">
                    <field name="name"/>
                    <field name="code"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="action_vat_district" model="ir.actions.act_window">
            <field name="name">Vat district</field>
            <field name="res_model">vat.district</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_vat_district_filter"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
              </p><p>
                Let's create a vat district.
              </p>
            </field>
        </record>

    </data>
</odoo>
