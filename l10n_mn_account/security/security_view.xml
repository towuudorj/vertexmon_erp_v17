<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="group_cost_price_view" model="res.groups">
	        <field name="name">Өртөг харах</field>
	    </record>

        <record id="group_financial_analyst" model="res.groups">
	        <field name="name">Санхүүгийн шинжээч</field>
	    </record>

        <record id="account_partner_balance_report_comp_rule" model="ir.rule">
            <field name="name">Харилцагчид (үлдэгдлээр): компанийн харагдац</field>
            <field name="model_id" ref="model_account_partner_balance_report"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        </record>

        <!-- Нэхэмжлэл эрхтэй хэрэглэгч журналын мөрүүдийг бүгдийг харж чаддаг тул эх бичилтийг нь зөвхөн унших эрх.
             Батлагдсан нэхэмжлэлийн "Биелээгүй дебет/кредит" нь бусад төлбөр, бичилтийг уншдаг. -->
        <record id="account_move_read_all_billing_rule" model="ir.rule">
            <field name="name">Нэхэмжлэл: бүх журналын бичилт унших</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
