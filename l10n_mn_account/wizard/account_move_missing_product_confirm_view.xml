<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_missing_product_confirm_form" model="ir.ui.view">
        <field name="name">account.move.missing.product.confirm.form</field>
        <field name="model">account.move.missing.product.confirm</field>
        <field name="arch" type="xml">
            <form string="Бараа сонгоогүй мөр байна">
                <field name="move_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <field name="message" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Тийм, батлах" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Болих" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- "Post"/"Confirm" товч дарахад бараагүй мөрийг шалгана (кодоор батлахад шалгахгүй).
         Odoo 17 string-ээр сонгохыг хориглодог тул байрлалаар; шалгалт зөвхөн нэхэмжлэлд ажиллана. -->
    <record id="view_account_move_missing_product_check" model="ir.ui.view">
        <field name="name">account.move.form.missing.product.check</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//header/button[@name='action_post'])[1]" position="attributes">
                <attribute name="context">{'validate_analytic': True, 'check_missing_product': True}</attribute>
            </xpath>
            <xpath expr="(//header/button[@name='action_post'])[2]" position="attributes">
                <attribute name="context">{'validate_analytic': True, 'check_missing_product': True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
