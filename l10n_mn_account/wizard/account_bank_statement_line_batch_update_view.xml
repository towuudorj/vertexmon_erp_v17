<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_bank_statement_line_batch_update" model="ir.ui.view">
            <field name="name">account.bank.statement.line.batch.update.form</field>
            <field name="model">account.bank.statement.line.batch.update</field>
            <field name="arch" type="xml">
                <form string="Batch Update Bank Statement Lines">
                    <sheet>
                        <group>
                            <field name="line_count" readonly="1"/>
                        </group>
                        <group>
                            <group>
                                <field name="update_partner"/>
                                <field name="partner_id" invisible="not update_partner"/>
                            </group>
                            <group>
                                <field name="update_cash_move_type"/>
                                <field name="cash_move_type_id" invisible="not update_cash_move_type" required="update_cash_move_type"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Selected Statement Lines">
                                <field name="line_ids" readonly="1">
                                    <tree create="0" delete="0">
                                        <field name="date"/>
                                        <field name="payment_ref"/>
                                        <field name="partner_id"/>
                                        <field name="amount"/>
                                        <field name="cash_move_type_id"/>
                                        <field name="is_reconciled"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_update" string="Update" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_account_bank_statement_line_batch_update" model="ir.actions.act_window">
            <field name="name">Batch Update</field>
            <field name="res_model">account.bank.statement.line.batch.update</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="account.model_account_bank_statement_line"/>
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>