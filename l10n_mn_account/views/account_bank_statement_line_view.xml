<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>


        <record model="ir.ui.view" id="account_bank_statement_line_tree_view">
                <field name="name">account.bank.statement.line.tree</field>
                <field name="model">account.bank.statement.line</field>
                <field name="arch" type="xml">
                    <tree string="tree_string" create="0" edit="0">
                        <field name="date" />
               			<field name="payment_ref" />
                        <field name="partner_id"/>
               			<field name="amount"/>
                    </tree>
                </field>
            </record>


            <record model="ir.actions.act_window" id="action_bank_statement_line_tree_view">
                <field name="name">Account bank statement line</field>
                <field name="res_model">account.bank.statement.line</field>
                <field name="view_mode">tree</field>
                <field name="view_id" ref="account_bank_statement_line_tree_view"/>
            </record>

        

    </data>
</odoo>
