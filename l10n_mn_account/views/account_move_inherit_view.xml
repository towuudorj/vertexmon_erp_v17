        <record id="view_account_move_mn_inherit" model="ir.ui.view">
            <field name="name">account.move.form.mn</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
            <data>
                <xpath expr='//sheet/notebook/page[@id="aml_tab"]/field[@name="line_ids"]/tree/field[@name="currency_id"]' position="before">
                    <field name="cash_move_type_id" string="Мөнгөн гүйлгээний төрөл"/>
                </xpath>
                <xpath expr='//button[@name="action_post"]' position="after">
                    <field name="invisible_approve_to_parent" invisible="1"/>
                    <field name="parent_notif_sent" invisible="1"/>
                    <field name="invoice_state" invisible="1"/>
                    <button name="approve_to_accountant" type="object" string="Reviewed" invisible="invisible_approve_to_parent or invoice_state == 'accountant_approve'"/>
                    <button name="action_send_parent_notif" type="object" string="send" invisible="parent_notif_sent or move_type not in ('in_invoice', 'out_invoice')"/>
                </xpath>
            </data>
            </field>
        </record>

         <record id="view_account_move_line_tree_mn_inherit" model="ir.ui.view">
            <field name="name">account.move.line.tree.mn</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
	            <data>
	                <xpath expr='//tree/field[@name="debit"]' position="before">
	                    <field name="cash_move_type_id" optional="hidden"/>
	                </xpath>
                    <xpath expr='//tree/field[@name="analytic_distribution"]' position="after">
	                    <field name="counterpart_account_name" optional="hidden"/>
	                </xpath>
	            </data>
            </field>
        </record>


        <record id="mn_account_move_tree_landed_account_view" model="ir.ui.view">
            <field name="name">account.move.landed.account.inherit.tree</field>
            <field name="model">account.move</field>            
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">     
                <xpath expr="//field[@name='date']" position="after">
                    <field name="po_ids" widget="many2many_tags" optional="show"/>
                    <field name="vat_declaration" optional="show"/>
                </xpath>
            </field>
		</record>

        <record id="mn_account_move_landed_account_view" model="ir.ui.view">
            <field name="name">account.move.landed.account.inherit.form</field>
            <field name="model">account.move</field>            
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">     
                <xpath expr="//field[@name='name']" position="after">
                    <field name="po_ids"/>
                    <field name="vat_declaration"/>
                </xpath>
            </field>
		</record>

        <record id="view_account_move_line_filter_mn_inherit" model="ir.ui.view">
            <field name="name">account.move.line.filter.mn</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_account_move_line_filter"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//search/group/filter[@name="group_by_move"]' position="before">
                    <filter string="Cash move type" name="cash_move_type_id"  domain="[]" context="{'group_by': 'cash_move_type_id'}"/>
                    </xpath>
                </data>
            </field>
        </record>
	

</odoo>