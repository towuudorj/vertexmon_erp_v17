<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_form_lock" model="ir.ui.view">
        <field name="name">account.analytic.account.form.lock</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_lock" type="object" string="Түгжих"
                            invisible="is_locked" groups="account.group_account_manager"
                            confirm="Түгжсэн шинжилгээний дансыг шинэ гүйлгээнд ашиглах боломжгүй болно. Үргэлжлүүлэх үү?"/>
                    <button name="action_unlock" type="object" string="Түгжээ тайлах"
                            invisible="not is_locked" groups="account.group_account_manager"/>
                </header>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <widget name="web_ribbon" title="Түгжээтэй" bg_color="text-bg-warning" invisible="not is_locked or not active"/>
            </xpath>
            <group name="main" position="inside">
                <group string="Түгжээ" invisible="not is_locked">
                    <field name="is_locked" invisible="1"/>
                    <field name="lock_date"/>
                    <field name="lock_user_id"/>
                    <field name="lock_reason"/>
                </group>
            </group>
        </field>
    </record>

    <record id="view_account_analytic_account_list_lock" model="ir.ui.view">
        <field name="name">account.analytic.account.list.lock</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list"/>
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="decoration-muted">is_locked</attribute>
            </tree>
            <field name="name" position="after">
                <field name="is_locked" optional="show" widget="boolean" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_account_analytic_account_search_lock" model="ir.ui.view">
        <field name="name">account.analytic.account.search.lock</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="locked" string="Түгжээтэй" domain="[('is_locked', '=', True)]"/>
                <filter name="not_locked" string="Түгжээгүй" domain="[('is_locked', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
