            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//sheet/notebook/page[@name="general_information"]/group/group[@name="group_standard_price"]/div/field[@name="standard_price"]' position="attributes">
