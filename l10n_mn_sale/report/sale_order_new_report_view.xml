<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<data>
		
		<record id="sale_order_new_report_view" model="ir.ui.view">
            <field name="name">sale.order.new.report.form</field>
            <field name="model">sale.order.new.report</field>
            <field name="arch" type="xml">
                <form string="Report Options">
                    <group colspan="4">
                        <field name="company_id" widget='selection'/>
                        <field name="target_move" />
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="partner_id"/>
                        <field name="sales_user_id"/>
                        <field name="is_license"/>
                    </group>
                    <footer>
                        <button name="action_print_xls_report" string="Export" type="object" class="oe_highlight" />
                        <button name="action_preview_report" string="Preview" type="object" class="oe_highlight"/>
                        <button string="Close" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_order_new_report" model="ir.actions.act_window">
            <field name="name">Борлуулалтын тайлан</field>
            <field name="res_model">sale.order.new.report</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sale_order_new_report_view"/>
            <field name="target">new</field>
        </record>
    
	
	</data>

</odoo>
