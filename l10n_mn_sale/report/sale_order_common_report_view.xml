<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="sale_order_common_report_view" model="ir.ui.view">
            <field name="name">sale.order.common.report.form</field>
            <field name="model">sale.order.common.report</field>
            <field name="arch" type="xml">
                <form string="Report Options">
                    <group colspan="4">
                        <field name="company_id" widget='selection'/>
                        <field name="target_move" />
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="sales_user_id"/>
                        <!-- Орлого үр дүнтэй тулгахад лиценз, лицензийн бус бүх орлого орно -->
                        <field name="is_license" invisible="target_move == 'invoiced'"/>
                        <field name="account_ids" widget="many2many_tags"
                               invisible="target_move != 'invoiced'"
                               required="target_move == 'invoiced'"
                               domain="[('company_id', '=', company_id)]"/>
                    </group>
                    <footer>
                        <button name="action_print_xls_report" string="Export" type="object" class="oe_highlight" />
                        <button name="action_preview_report" string="Preview" type="object" class="oe_highlight"/>
                        <button string="Close" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_order_common_report" model="ir.actions.act_window">
            <field name="name">Борлуулалтын тайлан хураангуй</field>
            <field name="res_model">sale.order.common.report</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sale_order_common_report_view"/>
            <field name="target">new</field>
        </record>
        

    </data>
</odoo>
