<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

			
        <template id="sale_stock_picking_expense_data">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="row mb64">
			            <div class="col-6">
			            	<p style="text-align:left;font-size: 11px;margin-left:50px; margin-right:50px; margin-top: -50px">
							<span>НХМаягт БТ-2</span>
							</p>
			            </div>
                        <div class="col-6">
			            	<p style="text-align: right; margin-right:20px">
			            		<img t-attf-src="data:image/jpg;base64,{{request.env.user.company_id.logo}}" style="width:190px;height:60px;"/>
			            	</p>
			            </div>
			        </div>

                    <div class="col-xs-8" style="text-align:center; font-size:14px;">
                        <h4>ЗАРЛАГЫН БАРИМТ</h4>
                        <p style="text-align:center;">№ <span t-field="o.name"/> </p>
                    </div>
                    <table class="width: 100%; table table-condensed; text-align: center; border: transparent 1px solid; margin-left:50px; margin-right:50px;">
                        <tr style="border: none;">
                            <td style="width: 50%; border: none; font-size:11px; padding:3px; text-align:center; text-decoration: underline;"><span t-field="o.company_id.name"/></td>
                            <td style="width: 50%; border: none; font-size:11px; padding:3px; text-align:center; text-decoration: underline;"><span t-field="o.partner_id.name"/></td>
                        </tr>
                        <tr style="border: none; underline;">
                            <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                ( Байгууллагын нэр )
                            </td>
                            <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                ( Байгууллагын нэр )
                            </td>
                        </tr>
                        <tr style="border: none;">
                            <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                Регистрийн №: <span t-field="o.company_id.vat"/>
                            </td>
                            <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                Регистрийн №: <span t-field="o.partner_id.vat"/>
                            </td>
                        </tr>
                        <tr style="border: none;">
                            <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                Огноо: <span t-field="o.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;yyyy-MM-dd&quot;}"/>
                            </td>
                            <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                            </td>
                        </tr>
                    </table>
                    <br/>
                    <table class="width: 100%;" style="margin-left:60px; margin-right:20px;">
                        <t t-set="discount" t-value="false"/>
                        <t class="border-black" t-foreach="o.order_line" t-as="line">
                            <t t-if="line.is_downpayment==false">
                                <t t-if="line.discount &gt; 0.0">
                                    <t t-set="discount" t-value="true"/>
                                </t>
                                <t t-else="line.discount==0.0">
                                    <t t-set="discount" t-value="false"/>
                                </t>
                            </t>
                        </t>
                        <t t-if="discount==false">
                            <thead>
                                <tr>
                                    <th style="width: 3%; border: 1px solid black; font-size:11px; padding:3px;"><strong>№</strong></th>
                                    <th style="width: 30%; border: 1px solid black; font-size:11px; padding:3px;"><strong>Барааны нэр</strong></th>
                                    <th style=" width: 5%; border: 1px solid black; font-size:11px; padding:3px;" class="text-right"><strong>Х/Нэгж</strong></th>                                                
                                    <th style=" width: 5%; border: 1px solid black; font-size:11px; padding:3px;" class="text-right"><strong>Тоо хэмжээ</strong></th>
                                    <th style=" width: 7%; border: 1px solid black; font-size:11px; padding:3px;"><strong>Нэгж үнэ</strong></th>
                                    <th style=" width: 8%; border: 1px solid black; font-size:11px; padding:3px;" class="text-right"><strong>Нийт дүн</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                    <t t-if="o.order_line">
                                        <t t-set="i" t-value="1"/>
                                        <tr t-foreach="o.order_line" t-as="line">
                                            <t t-if="line.is_downpayment==false">
                                                <td style="border: 1px solid black; font-size:11px; padding:7px; text-align:center;"><span t-esc="i"/></td>
                                                <td style="border: 1px solid black; font-size:11px; padding:5px;"><span t-field="line.product_id.name"/></td>
                                                <td style="border: 1px solid black; font-size:11px; padding:5px; text-align:center;"><span t-field="line.product_uom.name"/></td>
                                                <td style="border: 1px solid black; font-size:11px; padding:5px; text-align:right;">
                                                    <span t-field="line.product_uom_qty" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                                </td>
                                                <td style="border: 1px solid black; font-size:11px; padding:4px; text-align:right;"><span t-esc="line.price_unit/1.1" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                                <td style="border: 1px solid black; font-size:11px; padding:4px; text-align:right;"><span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                                <t t-set="i" t-value="i+1"/>
                                            </t>
                                        </tr>
                                        <tr class="border-black">
                                            <td colspan="3" style="padding: 4px;  font-size:11px; border: 1px solid black; font-weight: bold; text-align: center;"> Нийт тоо</td>
                                            <td style="padding: 3px; font-size:11px;  border: 1px solid black;  text-align: right;">
                                                <t t-esc="sum([x for x in o.order_line.mapped('product_uom_qty')])" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                            </td>
                                            <td style="border: 1px solid black; font-size:11px; padding:4px;"/> 
                                            <td style="border: 1px solid black; font-size:11px; padding:4px;"/> 
                                        </tr>
                                    </t>
                                
                                
                                <tr>
                                    <td colspan="5" style="border: 1px solid black; font-size:11px; padding:3px; text-align:center;"><b>Дүн</b></td>
                                    <td style="border: 1px solid black; font-size:11px; padding:3px; text-align:right;"><span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                </tr>
                                <tr>
                                    <td colspan="5" style="border: 1px solid black; font-size:11px; padding:3px; text-align:center;"><b>НӨАТ</b></td>
                                    <td style="border: 1px solid black; font-size:11px; padding:3px; text-align:right;"><span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                </tr>
                                <tr>
                                    <td colspan="5" style="border: 1px solid black; font-size:11px; padding:3px; text-align:center;"> <b>Нийт дүн /НӨАТ орсон/</b> </td>
                                    <td style="border: 1px solid black; font-size:11px; padding:3px; text-align:right;"><span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                </tr>
                            </tbody>
                            </t>
                        <t t-if="discount==true">
                            <thead>
                                <tr>
                                    <th style="width: 3%; border: 1px solid black; font-size:11px; padding:3px;"><strong>№</strong></th>
                                    <th style="width: 30%; border: 1px solid black; font-size:11px; padding:3px;"><strong>Барааны нэр</strong></th>
                                    <th style=" width: 5%; border: 1px solid black; font-size:11px; padding:3px;" class="text-right"><strong>Х/Нэгж</strong></th>                                                
                                    <th style=" width: 5%; border: 1px solid black; font-size:11px; padding:3px;" class="text-right"><strong>Тоо хэмжээ</strong></th>
                                    <th style=" width: 7%; border: 1px solid black; font-size:11px; padding:3px;"><strong>Нэгж үнэ</strong></th>
                                    <th style=" width: 7%; border: 1px solid black; font-size:11px; padding:3px;"><strong>Хөнгөлөлт</strong></th>
                                    <th style=" width: 8%; border: 1px solid black; font-size:11px; padding:3px;" class="text-right"><strong>Нийт дүн</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                    <t t-if="o.order_line">
                                        <t t-set="i" t-value="1"/>
                                        <tr t-foreach="o.order_line" t-as="line">
                                            <t t-if="line.is_downpayment==false">
                                                <td style="border: 1px solid black; font-size:11px; padding:7px; text-align:center;"><span t-esc="i"/></td>   
                                                <td style="border: 1px solid black; font-size:11px; padding:5px;"><span t-field="line.product_id.name"/></td>
                                                <td style="border: 1px solid black; font-size:11px; padding:5px; text-align:center;"><span t-field="line.product_uom.name"/></td>
                                                <td style="border: 1px solid black; font-size:11px; padding:5px; text-align:right;">
                                                    <span t-field="line.product_uom_qty" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                                </td>
                                                <td style="border: 1px solid black; font-size:11px; padding:4px; text-align:right;"><span t-esc="line.price_unit/1.1" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                                <td style="border: 1px solid black; font-size:11px; padding:4px; text-align:right;"><span t-esc="line.discount" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                                <td style="border: 1px solid black; font-size:11px; padding:4px; text-align:right;"><span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                            
                                                <t t-set="i" t-value="i+1"/>
                                            </t>
                                        </tr>
                                        <tr class="border-black">
                                            <td colspan="3" style="padding: 4px;  font-size:11px; border: 1px solid black; font-weight: bold; text-align: center;"> Нийт тоо</td>
                                            <td style="padding: 3px; font-size:11px;  border: 1px solid black;  text-align: right;">
                                                <t t-esc="sum([x for x in o.order_line.mapped('product_uom_qty')])" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                            </td>
                                            <td style="border: 1px solid black; font-size:11px; padding:4px;"/> 
                                            <td style="border: 1px solid black; font-size:11px; padding:4px;"/> 
                                            <td style="border: 1px solid black; font-size:11px; padding:4px;"/> 
                                        </tr>
                                    </t>
                                
  
                                <tr>
                                    <td colspan="6" style="border: 1px solid black; font-size:11px; padding:3px; text-align:center;"><b>Дүн</b></td>
                                    <td style="border: 1px solid black; font-size:11px; padding:3px; text-align:right;"><span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                </tr>
                                <tr>
                                    <td colspan="6" style="border: 1px solid black; font-size:11px; padding:3px; text-align:center;"><b>НӨАТ</b></td>
                                    <td style="border: 1px solid black; font-size:11px; padding:3px; text-align:right;"><span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                </tr>
                                <tr>
                                    <td colspan="6" style="border: 1px solid black; font-size:11px; padding:3px; text-align:center;"> <b>Нийт дүн /НӨАТ орсон/</b> </td>
                                    <td style="border: 1px solid black; font-size:11px; padding:3px; text-align:right;"><span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/></td>
                                </tr>
                            </tbody>
                    
                        </t>
                    </table>

                    <div style="position: absolute;  margin-left: 40px; margin-bottom: 7px;">
                    </div>
                    <div style="font-size:11px; padding-top:10px; text-align:right; margin-right:20px; margin-bottom: 10px;"><b>Тамга</b>        Хариуцсан борлуулалтын менежер :......................................................................./............................................................../
                    </div> 
                    <div style="font-size:11px; padding:5px; text-align:right; margin-right: 20px;"> Шалгасан нягтлан бодогч :............................................................................................../............................................................/
                    </div>   
                    <div style="font-size:11px; padding:5px; text-align:right; margin-right: 20px;"> Хүлээлгэн өгсөн эд хариуцагч :..................................................................................../.........................................................../
                    </div>      
                    <div style="font-size:11px; padding:5px; text-align:right; margin-right: 20px;"> Хүлээн авсан :........................................................................................................................../.............................................................../
                    </div>                                                                                                                                              
                   </div>
                </t>
            </t> 
        </template>
    
        <template id="mn_sale_stock_expense">
            <t t-call="web.html_container">
                <t t-foreach="doc_ids" t-as="doc_id">
                    <t t-set="lang"/>
                    <t t-call="l10n_mn_sale.sale_stock_picking_expense_data" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>