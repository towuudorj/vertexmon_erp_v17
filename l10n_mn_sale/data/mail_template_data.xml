<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_sale_confirmation" model="mail.template">
            <field name="name">Sale Order Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Sale Order Confirmed: {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear {{ object.partner_id.name }},</p>
    <p>Your sale order <strong>{{ object.name }}</strong> has been confirmed.</p>
    
    <h3>Order Details:</h3>
    <ul>
        <li><strong>Order Number:</strong> {{ object.name }}</li>
        <li><strong>Order Date:</strong> {{ format_date(object.date_order) }}</li>
        <li><strong>Total Amount:</strong> {{ format_amount(object.amount_total, object.currency_id) }}</li>
        <li><strong>Salesperson:</strong> {{ object.user_id.name }}</li>
    </ul>
    
    <p>Thank you for your business!</p>
    
    <p>Best regards,<br/>
    {{ object.company_id.name }}</p>
</div>
            </field>
        </record>
    </data>
</odoo>