<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mn_sale_inherit_res_users_view" model="ir.ui.view">
            <field name="name">inherit.mn.sale.res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <data>
                    <field name="signature" position="before">
                        <field name="signature_image" widget="image" options="{'size': [100, 100]}"/>
                        <field name="name_image" widget="image" options="{'size': [100, 100]}"/>
                    </field>
                </data>
                <xpath expr="//field[@name='active']" position="before">   
                    <field name="sq_number" />
					<field name="is_purchase_manager" />
                </xpath>
            </field>
		</record>

    </data>
</odoo>
