<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

            <record model="ir.ui.view" id="sales_contract_register_tree_view">
                <field name="name">sales.contract.register.tree</field>
                <field name="model">sales.contract.register</field>
                <field name="arch" type="xml">
                    <tree string="Sales contract register">
                        <field name="company_id" />
                        <field name="name" />
                        <field name="partner_id" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="reg_user_id" />
                        <field name="contract_amount" />
                        <field name="state" />
                    </tree>
                </field>
            </record>

            <record model="ir.ui.view" id="sales_contract_register_form_view">
                <field name="name">sales.contract.register.form</field>
                <field name="model">sales.contract.register</field>
                <field name="arch" type="xml">
                    <form string="Sales contract register">
                        <header>
                            <button name="action_confirm"  string="Confirm" 
                                    invisible="state != 'send_draft'"  type="object" 
                                     />
                                    
                            <button name="action_cancel"  string="Cancel" 
                                    invisible="state != 'closed'"  type="object" 
                                     />

                            <button name="action_closed"  string="Closed" 
                                    invisible="state != 'payment_waiting'"  type="object" 
                                     />

                            <button name="action_send_draft"  string="Send draft" 
                                    invisible="state != 'draft'"  type="object" 
                                     />
                            <button name="action_payment_waiting" string="Payment waiting" 
                                    invisible="state != 'confirmed'" type="object" class="oe_highlight"/>

                            <button name="action_deposit" string="Deposit" 
                                    invisible="state != 'closed'" type="object" class="oe_highlight"/>
                            
                            <button name="action_create_project" string="Create project" 
                                    invisible="project_id != False" type="object" class="oe_highlight"/>

                            <field name="state" widget="statusbar" />
                        </header>
                        <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_sale_order" type="object"
                                class="oe_stat_button"  icon="fa-star-o">
                                <div class="o_stat_info">
                                    <field name="sales_count" class="o_stat_value"/>
                                    <span class="o_stat_text" >Sales</span>
                                </div>
                            </button>

                             <button name="action_invoice_order" type="object"
                                class="oe_stat_button"  icon="fa-star-o">
                                <div class="o_stat_info">
                                    <field name="invoice_count" class="o_stat_value"/>
                                    <span class="o_stat_text" >Invoice</span>
                                </div>
                            </button>

                            <button name="action_project_order" type="object"
                                class="oe_stat_button"  icon="fa-star-o">
                                <div class="o_stat_info">
                                    <field name="project_count" class="o_stat_value"/>
                                    <span class="o_stat_text" >Project</span>
                                </div>
                            </button>
                        </div>
                        <group colspan="4" col="4">
                            <group colspan="2" col="2">
                                <field name="company_id" readonly="state != 'draft'"/>
                                <field name="name"  readonly="state != 'draft'"/>
                                <field name="contract_number"  readonly="state != 'draft'"/>
                                <field name="contract_number_auto"  readonly="state != 'draft'"/>
                                <field name="partner_id"  readonly="state != 'draft'"/>
                                <field name="confirm_date"  readonly="state != 'draft'"/>
                                <field name="start_date"  readonly="state != 'draft'"/>
                                <field name="end_date" readonly="state != 'draft'"/>
                            </group>
	                        <group colspan="2" col="2">
                                <field name="payment_term_id" readonly="state != 'draft'"/>
                                <field name="contract_type" readonly="state != 'draft'"/>
                                <field name="contract_amount" readonly="state != 'draft'"/>
                                <field name="currency_id" readonly="state != 'draft'"/>
                                <field name="sales_manager_id" readonly="state != 'draft'"/>
                                <field name="sales_team_id" readonly="state != 'draft'"/>
                                <field name="reg_user_id" readonly="state != 'draft'"/>
                                <field name="reg_date" readonly="state != 'draft'" />
                                <field name="project_id"/>
                                <field name="sales_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="note" readonly="state != 'draft'"/>
                        </group>
                        </sheet>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </div>
                    </form>
                </field>
            </record>
            

            <record id="view_sales_contract_register_filter" model="ir.ui.view">
                <field name="name">sales.contract.register.list.select</field>
                <field name="model">sales.contract.register</field>
                <field name="priority" eval="15"/>
                <field name="arch" type="xml">
                    <search string="Search Sales Contract Register">
                        <field name="name"
                            filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id', 'child_of', self)]"/>
                        <field name="partner_id" operator="child_of"/>
                        <field name="reg_user_id"/>
                        <field name="sales_team_id" string="Sales Team"/>
                        <filter string="My contracts" domain="[('reg_user_id', '=', uid)]" name="my_sales_contracts_filter"/>
                        <group expand="0" string="Group By">
                            <filter string="Salesperson" name="salesperson" domain="[]" context="{'group_by': 'reg_user_id'}"/>
                            <filter name="customer" string="Customer" domain="[]" context="{'group_by': 'partner_id'}"/>
                            <filter string="Start Date" name="order_month" domain="[]" context="{'group_by': 'start_date'}"/>
                        </group>
                    </search>
                </field>
            </record>


            <record model="ir.actions.act_window" id="action_sales_contract_register_tree_view">
                <field name="name">Sales contract register</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">sales.contract.register</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="sales_contract_register_tree_view"/>
            </record>

    </data>
</odoo>
