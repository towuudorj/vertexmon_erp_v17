<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="sale_order_inherit_purchase_requisition_tree_view" model="ir.ui.view">
            <field name="name">inherit.sale.purchase.requisition.tree</field>
            <field name="model">purchase.requisition</field>            
            <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vendor_id']" position="after">
                    <field name="crm_lead_id"/>
                    <field name="crm_lead_code"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='state']" position="before">
                    <field name="status"/>
                </xpath>
            </field>
        </record>

        

        <record id="sale_order_inherit_purchase_requisition_view" model="ir.ui.view">
            <field name="name">inherit.sale.purchase.requisition.form</field>
            <field name="model">purchase.requisition</field>            
            <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                 <xpath expr="//header" position="replace">  
                    <header>
                        <button name="quotation_start" groups="l10n_mn_sale.group_purchase_request" type="object" string="Quotation start"  class="oe_highlight" invisible = "status != 'new'" />
                        <button name="qoutation_end" groups="l10n_mn_sale.group_purchase_request" type="object" string="Quotation end" class="oe_highlight"  invisible= "status != 'quotation_st'" />
                        <!--<button name="quotation_done" groups="sales_team.group_sale_manager" type="object" string="Батлах" class="oe_highlight"  invisible= "status != 'quotation_ed'" />
                        --><button name="quotation_cancel" groups="l10n_mn_sale.group_purchase_request,sales_team.group_sale_manager" type="object" string="Cancel" class="oe_highlight" invisible= "status != 'new'" />
                        <button name="quotation_edit_request" groups="l10n_mn_sale.group_purchase_request" type="object" string="Quotation edit request" class="oe_highlight"  invisible= "status != 'done'" />

                        <field name="status" widget="statusbar" />
                        <field name="state" invisible="1" />
                    </header>
                </xpath>
                
               
                <xpath expr="//field[@name='vendor_id']" position="replace">  
                    <field name="vendor_id" context="{'res_partner_search_mode': 'supplier'}" readonly="state in ['ongoing', 'done']" />
					<field name="crm_lead_id" readonly="1"/>
                    <field name="send_date" readonly="1"/>
                    <field name="purchase_user_id" readonly="1"/>
                </xpath>


                <xpath expr="//sheet/notebook/page[@name='products']/field[@name='line_ids']/tree/field[@name='product_id']" position="replace">
                    <field name="line_status" readonly="1" />
                    <field name="supplier_id" readonly="line_status =='approve'"/>
                    <field name="product_id"  readonly="line_status =='approve'" options="{'no_create': True, 'no_open': True}" 
                                       domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                </xpath>

                <xpath expr="//sheet/notebook/page[@name='products']/field[@name='line_ids']/tree" position="attributes">
                     <attribute name="decoration-success">priority == 'normal'</attribute>
                     <attribute name="decoration-danger">priority == 'high'</attribute>
                </xpath>
                <xpath expr="//sheet/notebook/page[@name='products']/field[@name='line_ids']/tree/field[@name='price_unit']" position="replace">
                    <field name="price_unit" readonly="line_status =='approve'"/>
                    <!--<field name="line_status" readonly="1" />-->
                    <field name="priority" />
                    <field name="currency_id"/>
                    <field name="total_amount"/>
                    <!--<button name="action_approve" invisible="line_status =='approve' or product_id == False" string="Approve" type="object"/>
                    <button name="action_unapproved" invisible="line_status =='approve' or product_id == False" string="Unapprove" type="object"/>
                    --><button name="%(action_create_product_wizard)d" invisible="product_id != False"  string="Create product" type="action"/>
                    <!--<field name="cancel_reason_id"/>-->
                </xpath>
                <field name="line_ids" position="attributes">
                    <attribute name="readonly">status == 'done'</attribute>
                </field>

                <field name="vendor_id" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
                <xpath expr="//sheet/notebook/page[@name='products']/field[@name='description']" position="before">
                    <group class="oe_subtotal_footer">
                        <field name="total_amount" class="oe_subtotal_footer_separator"/>
                    </group>
                </xpath>
            </field>
		</record>


    </data>
</odoo>
