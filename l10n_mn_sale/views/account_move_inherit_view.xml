<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_account_move_mn_sale_order_inherit" model="ir.ui.view">
            <field name="name">account.move.form.sale.order.mn</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//field[@name="partner_shipping_id"]' position="after">
                        <field name="payment_types"/>
                        <field name="ot_po"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_account_move_search_sale_order_inherit" model="ir.ui.view">
            <field name="name">account.move.search.sale.order</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//field[@name="date"]' position="after">
                        <field name="payment_date"/>
                        <field name="ot_po"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_account_move_tree_sale_order_inherit" model="ir.ui.view">
            <field name="name">account.move.tree.sale.order</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//field[@name="invoice_date"]' position="after">
                        <field name="line_names"/>
                        <field name="ot_po" optional="show"/>
                    </xpath>
                </data>
            </field>
        </record>

    </data>
</odoo>
