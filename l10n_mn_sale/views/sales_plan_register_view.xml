<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

            <record model="ir.ui.view" id="sales_plan_register_tree_view">
                <field name="name">sales.plan.register.tree</field>
                <field name="model">sales.plan.register</field>
                <field name="arch" type="xml">
                    <tree string="Sales plan register">
                        <field name="company_id" />
                        <field name="name" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="reg_user_id" />
                        <field name="state" />
                    </tree>
                </field>
            </record>

            <record model="ir.ui.view" id="sales_plan_register_form_view">
                <field name="name">sales.plan.register.form</field>
                <field name="model">sales.plan.register</field>
                <field name="arch" type="xml">
                    <form string="Sales plan register">
                        <header>
                            <button name="action_confirm"  string="Confirm" 
                                    invisible="state != 'send_draft'"  type="object" />
                                    
                            <button name="action_cancel"  string="Cancel" 
                                    invisible="state != 'closed'"  type="object" />
                            <field name="state" widget="statusbar" />
                        </header>
                        <sheet>
                        <group colspan="4" col="4">
                            <group colspan="2" col="2">
                                <field name="company_id" readonly="state != 'draft'"/>
                                <field name="name"  readonly="state != 'draft'"/>
                                <field name="start_date"  readonly="state != 'draft'"/>
                                <field name="end_date" readonly="state != 'draft'"/>
                            </group>
	                        <group colspan="2" col="2">
                                <field name="currency_id" readonly="state != 'draft'"/>
                                <field name="reg_user_id" readonly="state != 'draft'"/>
                                <field name="reg_date" readonly="state != 'draft'" />
                            </group>
                        </group>
                        <group>
                            <field name="note" readonly="state != 'draft'"/>
                        </group>
                        </sheet>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </div>
                    </form>
                </field>
            </record>
            

            <record id="view_sales_plan_register_filter" model="ir.ui.view">
                <field name="name">sales.plan.register.list.select</field>
                <field name="model">sales.plan.register</field>
                <field name="priority" eval="15"/>
                <field name="arch" type="xml">
                    <search string="Search Sales Plan Register">
                        <field name="name" filter_domain="['|', '|', ('name', 'ilike', self)]"/>
                        <field name="reg_user_id"/>
                        <group expand="0" string="Group By">
                            <filter string="Start Date" name="order_month" domain="[]" context="{'group_by': 'start_date'}"/>
                        </group>
                    </search>
                </field>
            </record>


            <record model="ir.actions.act_window" id="action_sales_plan_register_tree_view">
                <field name="name">Sales plan register</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">sales.plan.register</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="sales_plan_register_tree_view"/>
            </record>

    </data>
</odoo>
