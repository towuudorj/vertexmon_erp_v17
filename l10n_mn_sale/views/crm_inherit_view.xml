<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
            
             <record model="ir.ui.view" id="crm_lead_create_inherit_mn_tree_view">
                <field name="name">crm.lead.mn.inherit.tree</field>
	        	<field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
                <field name="model">crm.lead</field>
                <field name="arch" type="xml">
                    <data>
                        <xpath expr="//tree" position="attributes">
                            <attribute name="class" add="o_list_column_filter" separator=" "/>
                        </xpath>
                        <xpath expr='//field[@name="create_date"]' position="replace">
                        </xpath>
                        <xpath expr='//field[@name="contact_name"]' position="replace">
                        </xpath>
                        <xpath expr='//field[@name="name"]' position="replace">
                             <field name="name"  string="Нэр"/>
                            <field name="code" />
                        </xpath>

                        <xpath expr='//field[@name="stage_id"]' position="replace">
                        </xpath>

                         <tree position="attributes">
                             <attribute name="decoration-success">new_status == 'confirm'</attribute>
                        </tree>
                        <xpath expr='//field[@name="expected_revenue"]' position="attributes">
                            <attribute name="invisible">True</attribute>
                        </xpath>
                        <xpath expr='//field[@name="expected_revenue"]' position="after">
                            <field name="amount_total" />
                            <field name="new_status" string="Төлөв"/>
                        </xpath>
                    </data>
                </field>
            </record>

            <!-- Сэжим жагсаалтад баганаар шүүх мөр (vertexmon_tools) -->
            <record model="ir.ui.view" id="crm_lead_leads_tree_column_filter">
                <field name="name">crm.lead.leads.tree.column.filter</field>
                <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
                <field name="model">crm.lead</field>
                <field name="arch" type="xml">
                    <xpath expr="//tree" position="attributes">
                        <attribute name="class" add="o_list_column_filter" separator=" "/>
                    </xpath>
                </field>
            </record>

            <!--
            <record model="ir.ui.view" id="crm_lead_enrich_inherit_mn_view">
                <field name="name">crm.lead.mn.enrich.inherit</field>
	        	<field name="inherit_id" ref="crm_iap_enrich.crm_lead_view_form"/>
                <field name="model">crm.lead</field>
                <field name="arch" type="xml">
                    <data>
                         <xpath expr='//button[@name="iap_enrich"]' position="replace">
                        </xpath>
                    </data>
                </field>
            </record>
            -->

            <record model="ir.ui.view" id="crm_lead_create_inherit_mn_search_view">
                <field name="name">crm.lead.mn.create.inherit.search</field>
	        	<field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
                <field name="model">crm.lead</field>
                <field name="arch" type="xml">
                    <data>
                         <xpath expr='//field[@name="partner_id"]' position="after">
                            <field name="code"/>
                            <field name="is_sale" />
                        </xpath>
                    </data>
                </field>
            </record>

            <record model="ir.ui.view" id="crm_lead_create_inherit_mn_form_view">
                <field name="name">crm.lead.mn.create.inherit.form</field>
	        	<field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
                <field name="model">crm.lead</field>
                <field name="arch" type="xml">
                    <data>
                         <xpath expr='//field[@name="partner_id"]' position="replace">
                        </xpath>
                    </data>
                </field>
            </record>

            
            <record model="ir.ui.view" id="crm_lead_button_inherit_mn_form_view">
                <field name="name">crm.lead.mn.create.button.inherit.form</field>
	        	<field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
                <field name="model">crm.lead</field>
                <field name="arch" type="xml">
                    <data>
                        <xpath expr='//button[@name="action_sale_quotations_new"]' position="replace">
                            <field name="is_purchase" invisible="1"/>
                        </xpath>
                    </data>
                </field>
            </record>
        
            
            <record model="ir.ui.view" id="crm_lead_inherit_mn_form_view">
                <field name="name">crm.lead.mn.inherit.form</field>
	        	<field name="inherit_id" ref="crm.crm_lead_view_form"/>
                <field name="model">crm.lead</field>
                <field name="arch" type="xml">
                    <data>

                        <button name="action_view_sale_quotation" position="replace">
                        </button>
                        <button name="action_schedule_meeting" position="after">
                            <button class="oe_stat_button" type="object"
                                name="action_view_invoice" icon="fa-pencil-square-o">
                                <field name="invoice_count" widget="statinfo" string="Invoice"/>
                            </button>

                            <button class="oe_stat_button" type="object"
                                name="action_view_purchase_requisition" icon="fa-pencil-square-o">
                                <field name="purchase_request_count" widget="statinfo" string="Purchase requisition"/>
                            </button>

                            <button class="oe_stat_button" type="object"
                                name="action_view_purchase_order" icon="fa-pencil-square-o">
                                <field name="purchase_order_count" widget="statinfo" string="Purchase Order"/>
                            </button>
                        </button>

                        <xpath expr="//header/field[@name='stage_id'  ]" position="replace">
                            <field name="new_status" widget="statusbar"/>
                        </xpath>

                        <xpath expr="//header/button[@name='358']" position="replace">
                        </xpath>
                        <xpath expr="//header/button[@name='action_set_won_rainbowman']" position="replace">
                        </xpath>
                        <xpath expr='//header/button[@name="toggle_active"]' position="after">
                            <field name="new_status" invisible="1"/>
                            <!--
                            <button string="Худалдан авалтын хүсэлт илгээх" type="object"
                                invisible="status != 'new'" 
                                groups="sales_team.group_sale_salesman"
                                name="send_purchase_request"/>-->
                            <button string="Батлах" type="object"
                                invisible="new_status not in ('new','price_inquire')" 
                                name="action_confirm"/>
                            
                            <button string="Шинэ" type="object"
                                invisible="new_status != 'cancel'" 
                                name="action_new"/>

                            <button string="Шинэ" type="object"
                                invisible="new_status != 'break'" 
                                name="action_new"/>
                            
                            <button string="Төслийн бараа бүртгэх" type="object"
                                groups="l10n_mn_sale.group_crm_project_product_insert"
                                invisible="1" 
                                name="action_insert_project"/>

                            
                            <button string="Зөвшөөрөх" type="object"
                                groups="l10n_mn_sale.group_crm_request_confirm"
                                invisible="new_status != 'confirm'" 
                                name="confirm_purchase"/>

                            <button string="Цуцлах" type="action"
                                invisible="new_status in ('cancel', 'done')" 
                                name="%(action_crm_cancel_reason_view)d"/>
                            <button string="Хойшлуулах" type="action"
                                
                                invisible="new_status in ('break', 'done')" 
                                name="%(action_crm_break_reason_view)d"/>
                        </xpath>

                        <xpath expr='//sheet/div[@class="oe_title"]/h1' position="after">
                            <group>
                                <field name="code" />
                                <field name="sales_type" invisible="1"/>
                                <field name="crm_type" readonly="new_status == 'done'" />
                                <field name="send_date" readonly="new_status == 'done'"/>
                                <field name="project_id" readonly="new_status == 'done'"/>
                                <field name="supply_day" readonly="new_status == 'done'"/>
                                <field name="expire_day"/>
                                <field name="invoice_percentage"/>
                                <field name="invoice_description"/>
                                <field name="warehouse_id" readonly="new_status == 'done'"/>
                            </group>
                        </xpath>

                        <xpath expr='//label[@for="date_deadline"]' position="replace">
                        </xpath>
                        <xpath expr='//field[@name="user_id"]' position="after">
                            <field name="together_sales_id" string="Борлуулагч /нэмэлт/" widget="many2many_tags" readonly="new_status == 'done'"/>
                        </xpath>

                        <xpath expr='//div[@class="o_lead_opportunity_form_inline_fields"]' position="replace">
                        </xpath>

                        <xpath expr='//group[@name="categorization"]' position="replace">
                        </xpath>

                        <xpath expr='//sheet/div[@class="oe_title"]/h2[@class="row g-0 pb-3 pb-sm-4"]/div[@class="col-auto"]/div[@id="probability"]/field[@name="probability"]' position="replace">
                            <field name="probability" widget="float" class="oe_inline o_input_6ch" invisible="1"/>
                        </xpath>

                        <xpath expr='//sheet/div[@class="oe_title"]/h2[@class="row g-0 pb-3 pb-sm-4"]/div[@class="col-auto"]/div[@id="probability"]/span[@class="oe_grey p-2"]' position="replace">
                        </xpath>

                        <xpath expr='//sheet/div[@class="oe_title"]/h2[@class="row g-0 pb-3 pb-sm-4"]/div[@class="col-auto pb-2 pb-md-0"]' position="replace">
                        </xpath>
                        <xpath expr='//notebook/page[@name="lead"]/group/group[@class="mt48"]' position="replace">
                        </xpath>
                        <xpath expr='//notebook/page[@name="lead"]/group/group[2]' position="replace">
                        </xpath>
                         <field name="partner_id" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>
                        <field name="email_from" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>

                        <field name="name" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>

                        <field name="phone" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>
                        <field name="user_id" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>

                        <field name="tag_ids" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>


                        <field name="partner_name" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>

                        <field name="street" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>

                        <field name="website" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>

                        <field name="lang_id" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>

                        <field name="company_id" position="attributes">
                            <attribute name="readonly">new_status == 'done'</attribute>
                        </field>

                        <xpath expr='//notebook/page[@name="lead"]/group/group/field[@name="team_id"]' position="replace">
                        </xpath>
                        <xpath expr='//field[@name="tag_ids"]' position="after">
                            <field name="team_id" readonly="new_status == 'done'"/>
                            <field name="source_id" readonly="new_status == 'done'"/>
                            <field name="pricelist_id" readonly="new_status == 'done'"/>
                            <field name="cancel_reason" readonly="1"/>
                            <field name="break_reason" readonly="1"/>
                        </xpath>
                        <xpath expr='//notebook/page[@name="internal_notes"]' position="before">
                            <page string='Order line'>
                                <field name="lead_line_ids" readonly="new_status == 'done'">
                                    <tree editable="bottom" decoration-success="priority == 'normal'" decoration-danger="priority == 'high'">
                                        <field name="product_id"/>
                                        <field name="name" />
                                        <field name="request_type" optional="show"/>
                                        <field name="purchase_user_id" optional="show"/>
                                        <field name="uom_id"  required="product_id != False"/>
                                        <field name="purchase_type" optional="show" required="request_type != 'send_quotation' "/>
                                        <field name="priority"  optional="show"/>
                                        <field name="purchase_date"  optional="show" readonly="1"/>
                                        <field name="pre_qty" readonly="1" optional="show"/>
                                        <field name="qty"/>
                                        <field name="cost_price" readonly="1"/>
                                        <field name="currency_id"  readonly="1"/>
                                        <field name="sale_price"/>
                                        <field name="is_free_pro" optional="hide"/>
                                        <field name="discount"  optional="hide"/>
                                        <field name="tax_id"  optional="hide"/>
                                        <field name="price_subtotal"/>
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="untax_amount" class="oe_subtotal_footer_separator"/>
                                    <field name="tax_amount" class="oe_subtotal_footer_separator"/>
                                    <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                    <label for="margin" invisible="1"/>
                                    <div class="text-nowrap oe_subtotal_footer_separator" invisible="1">
                                        <field name="sale_currency_id" invisible="1"/>
                                        <field name="margin" class="oe_inline" widget="monetary"/>
                                        <span class="oe_inline" invisible="untax_amount == 0">
                                            (<field name="margin_percent" nolabel="1" class="oe_inline" widget="percentage"/>)
                                        </span>
                                    </div>
                                </group>
                            </page>
                        </xpath>
                    </data>
                </field>
            </record>

            
        <record model="ir.actions.act_window" id="crm_lead_action_tender_pipeline">
            <field name="name">Pipeline</field>
            <field name="res_model">crm.lead</field>
            <field name="view_mode">kanban,tree,graph,pivot,form,calendar,activity</field>
            <field name="domain">[('type','=','opportunity'),('sales_type','=','tender')]</field>
            <field name="context">{
                    'default_sales_type': 'tender',
                    'default_type': 'opportunity',
                    'search_default_assigned_to_me': 1
            }</field>
            <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        </record>



        <record model="ir.actions.act_window" id="crm_lead_action_project_pipeline">
            <field name="name">Pipeline</field>
            <field name="res_model">crm.lead</field>
            <field name="view_mode">kanban,tree,graph,pivot,form,calendar,activity</field>
            <field name="domain">[('type','=','opportunity'),('sales_type','=','project')]</field>
            <field name="context">{
                    'default_sales_type': 'project',
                    'default_type': 'opportunity',
                    'search_default_assigned_to_me': 1
            }</field>
            <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        </record>


     


 

    </data>
</odoo>
