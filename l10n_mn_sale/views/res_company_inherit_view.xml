<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mn_sale_inherit_res_company_view" model="ir.ui.view">
            <field name="name">inherit.mn.sale.res.company.form</field>
            <field name="model">res.company</field>            
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='currency_id']" position="after">  
                    <field name="en_name"/>
					<field name="company_stamp" widget="image" options="{'size': [100, 100]}"/>
                    <field name="account_stamp" widget="image" options="{'size': [100, 100]}"/>
                    <field name="report_image" widget="image" options="{'size': [100, 100]}"/>
                </xpath>
            </field>
		</record>

    </data>
</odoo>
