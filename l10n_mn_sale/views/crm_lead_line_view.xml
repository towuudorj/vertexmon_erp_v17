<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        
        <record id="crm_lead_line_view_tree" model="ir.ui.view">
            <field name="name">crm.lead.line.view.tree</field>
            <field name="model">crm.lead.line</field>
            <field name="arch" type="xml">
                <tree string="Crm Lead Line" create="0" editable="bottom" decoration-success="priority == 'normal'" decoration-danger="priority == 'high'">
                        <field name="lead_id" string="CRM" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="name" readonly="1"/>
                        <field name="request_type" optional="show" readonly="1"/>
                        <field name="purchase_type"/>
                        <field name="purchase_user_id" optional="show"/>
                        <field name="uom_id"  required="product_id != False" readonly="1"/>
                        <field name="priority"  optional="show" readonly="1"/>
                        <field name="qty" readonly="1"/>
                        <field name="cost_price" readonly="request_type != 'is_purchase'"/>
                        <field name="currency_id" readonly="1"/>
                        <field name="sale_price" readonly="1"/>
                        <field name="price_subtotal" readonly="1"/>
                </tree>
            </field>
        </record>


        <record model="ir.actions.act_window" id="crm_lead_line_action">
            <field name="name">Үнийн судалгааны хувиарлалт</field>
            <field name="res_model">crm.lead.line</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('request_type','!=','send_quotation'),('request_line_id','=',False)]</field>
        </record>






    </data>
</odoo>
