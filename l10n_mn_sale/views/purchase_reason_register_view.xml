<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

            <record model="ir.ui.view" id="purchase_reason_register_tree_view">
                <field name="name">purchase.reason.register.tree</field>
                <field name="model">purchase.reason.register</field>
                <field name="arch" type="xml">
                    <tree string="Purchase reason register">
                        <field name="company_id" />
                        <field name="name" />
                    </tree>
                </field>
            </record>

            <record model="ir.ui.view" id="purchase_reason_register_form_view">
                <field name="name">purchase.reason.register.form</field>
                <field name="model">purchase.reason.register</field>
                <field name="arch" type="xml">
                    <form string="Purchase reason register">
                        <sheet>
                            <group colspan="4" col="4">
                                <group colspan="2" col="2">
                                    <field name="company_id" />
                                    <field name="name" />
                                </group>
                            </group>
                        </sheet>
                    </form>
                </field>
            </record>
            

            <record id="view_purchase_reason_register_filter" model="ir.ui.view">
                <field name="name">purchase.reason.register.list.select</field>
                <field name="model">purchase.reason.register</field>
                <field name="priority" eval="15"/>
                <field name="arch" type="xml">
                    <search string="Search Purchase reason Register">
                        <field name="name" filter_domain="['|', '|', ('name', 'ilike', self)]"/>
                    </search>
                </field>
            </record>


            <record model="ir.actions.act_window" id="action_purchase_reason_register_tree_view">
                <field name="name">Purchase reason register</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">purchase.reason.register</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="purchase_reason_register_tree_view"/>
            </record>

    </data>
</odoo>
