<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    
    
        <record id="create_product_wizard_view" model="ir.ui.view">
            <field name="name">create.product.wizard.form</field>
            <field name="model">create.product.wizard</field>
            <field name="arch" type="xml">
	             <form string="Product register">
					<group col="4" colspan="2">
						<field name="company_id" options="{'no_create': True, 'no_open': True}" />
						<field name="name"/>
						<field name="brand_id" options="{'no_create': True, 'no_open': True}" />
                        <field name="model"/>
                        <field name="barcode"/>
						<field name="uom_id" options="{'no_create': True, 'no_open': True}" />
						<field name="categ_id" options="{'no_create': True, 'no_open': True}" />
                        <field name="supplier_tax_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}" />
						<field name="distributor_ids" options="{'no_create': True, 'no_open': True}" />
					</group>
					<footer>
                        <button name="create_product" string="Create product" type="object" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
				</form>
            </field>
        </record>
        
    	<record id="action_create_product_wizard" model="ir.actions.act_window">
             <field name="name">Create product</field>
             <field name="res_model">create.product.wizard</field>
             <field name="type">ir.actions.act_window</field>
             <field name="view_mode">form</field>
             <field name="view_id" ref="create_product_wizard_view"/>
             <field name="target">new</field>
       </record>
       
    
    </data>
</odoo>