<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

         <record id="mn_sale_order_cancel_form_view" model="ir.ui.view">
            <field name="name">inherit.mn.sale.order.cancel.form</field>
            <field name="model">sale.order.cancel</field>            
            <field name="inherit_id" ref="sale.sale_order_cancel_view_form"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='subject']" position="after">   
                	<field name="cancel_reason"/>
                </xpath>
            </field>
		</record>
        

    </data>
</odoo>
