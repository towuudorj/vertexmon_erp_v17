<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
		
		
		<record id="sale_order_invoice_payment_term_wizard_view" model="ir.ui.view">
            <field name="name">sale.order.invoice.payment.term.wizard.form</field>
            <field name="model">sale.order.invoice.payment.term</field>
            <field name="arch" type="xml">
	             <form string="Sale order invoice payment term">
	             	<group>
	             		<field name="company_id" readonly="1"/>
	             	</group>
	             	<field name="line_ids">
	             		<tree string="Sale order" editable="bottom" create="0">
	             			<field name="invoice_id" readonly="1"/>
	             			<field name="desc"/>
	             			<field name="percent"/>
	             			<field name="invoice_amount"/>
	             			<field name="is_created" readonly="1"/>
	             			<field name="is_new_create" readonly="is_created == True"/>
	             		</tree>
	             	</field>
					<footer>
                        <button name="action_create_invoice" string="Нэхэмжлэл үүсгэх" type="object" class="oe_highlight" />
                        or
                        <button string="Хаах" class="oe_link" special="cancel" />
                    </footer>
				</form>
            </field>
        </record>
        
    	<record id="action_sale_order_invoice_payment_term" model="ir.actions.act_window">
             <field name="name">Нэхэмжлэл үүсгэх</field>
             <field name="res_model">sale.order.invoice.payment.term</field>
             <field name="type">ir.actions.act_window</field>
             <field name="view_id" ref="sale_order_invoice_payment_term_wizard_view"/>
             <field name="view_mode">form</field>
             <field name="binding_model_id" ref="l10n_mn_sale.model_sale_order"/>
             <field name="binding_view_types">list</field>
             <field name="target">new</field>
       </record>
		
        

    </data>
</odoo>
