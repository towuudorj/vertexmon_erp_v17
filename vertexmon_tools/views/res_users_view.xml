<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="tools_inherit_res_users_view" model="ir.ui.view">
            <field name="name">inherit.tools.res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="after">
                    <page string="Menu hide">
                        <field name="hide_menu_ids" nolabel="1">
                            <tree>
                                <field name="complete_name"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
		</record>

    </data>
</odoo>
