<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		

		<record id="view_account_asset_asset_mn_inherit" model="ir.ui.view">
            <field name="name">account.asset.asset.form.mn</field>
            <field name="model">account.asset.asset</field>
            <field name="inherit_id" ref="om_account_asset.view_account_asset_asset_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//button[@name="set_to_close"]' position="after" >
                        <button name="%(action_account_asset_sale)d"
                                string="Зарах" type="action" invisible="state != 'open'"
                                class="oe_highlight"/>
                        <button name="action_asset_scrap"
                                string="Хөрөнгө актлах" type="object" invisible="state != 'open'"
                                confirm="The asset will be scrapped permanently. Continue?"/>
                        <button name="action_asset_transfer" string="Шилжүүлэх" type="object"
                                invisible="state not in ('draft', 'open')"/>
                    </xpath>
                    <xpath expr="//div[@name='button_box']" position="inside">
                        <button name="action_view_asset_moves" type="object" class="oe_stat_button" icon="fa-exchange"
                                invisible="asset_move_count == 0">
                            <field name="asset_move_count" widget="statinfo" string="Шилжүүлэг"/>
                        </button>
                    </xpath>
                    <xpath expr='//button[@name="set_to_close"]' position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                    <xpath expr='//sheet/group/group/field[@name="salvage_value"]' position="after">
                        <field name="write_up"/>
                    </xpath>
                    <xpath expr='//field[@name="state"]' position="replace">
                        <field name="state" widget="statusbar"/>
                    </xpath>
                    <xpath expr='//sheet/group/group/field[@name="type"]' position="after">
                        <field name="scrap_id" invisible="state != 'scrap'" readonly="1"/>
                        <field name="scrap_date"/>
                        <field name="uom_id" readonly="state != 'draft'"/>
                        <field name="asset_location_id" invisible="1"/>
                        <field name="owner_id" readonly="state != 'draft'"/>
                        <field name="asset_qty" readonly="state != 'draft'"/>
                    </xpath>
                </data>
            </field>
        </record>
        
        
        <record id="view_account_asset_asset_mn_tree_inherit" model="ir.ui.view">
            <field name="name">account.asset.asset.tree.mn</field>
            <field name="model">account.asset.asset</field>
            <field name="inherit_id" ref="om_account_asset.view_account_asset_asset_purchase_tree"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//field[@name="partner_id"]' position="after">
                        <field name="owner_id" />
                        <field name="asset_location_id" optional="hidden"/>
                    </xpath>
                    <xpath expr='//field[@name="state"]' position="attributes">
                        <attribute name="string">Төлөв</attribute>
                    </xpath>
                    <xpath expr='//field[@name="value_residual"]' position="attributes">
                        <attribute name="sum">Нийт</attribute>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_account_asset_search_mn_inherit" model="ir.ui.view">
            <field name="name">account.asset.asset.search.mn</field>
            <field name="model">account.asset.asset</field>
            <field name="inherit_id" ref="om_account_asset.view_account_asset_search"/>
            <field name="arch" type="xml">
                <xpath expr='//filter[@name="current"]' position="attributes">
                    <attribute name="string">Ашиглагдаж буй</attribute>
                </xpath>
                <xpath expr='//filter[@name="closed"]' position="after">
                    <filter string="Актлагдсан" name="scrapped" domain="[('state', '=', 'scrap')]"/>
                </xpath>
                <xpath expr='//field[@name="category_id"]' position="before">
                    <field name="owner_id" string="Хөрөнгө эзэмшигч"/>
                </xpath>
                <xpath expr='//filter[@name="category"]' position="after">
                    <filter string="Хөрөнгө эзэмшигч" name="group_owner" context="{'group_by': 'owner_id'}"/>
                </xpath>
            </field>
        </record>

        <!-- Хаагдсан, Актлагдсан хөрөнгийг анхдагчаар нууна -->
        <record id="om_account_asset.action_account_asset_asset_form" model="ir.actions.act_window">
            <field name="context">{'search_default_current': 1}</field>
        </record>
		

	
	</data>
</odoo>