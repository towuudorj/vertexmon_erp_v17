<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Хөрөнгийн жагсаалтуудад баганаар шүүх мөр (vertexmon_tools: o_list_column_filter) -->

    <!-- Хөрөнгийн ангилал -->
    <record id="account_asset_category_tree_column_filter" model="ir.ui.view">
        <field name="name">account.asset.category.column.filter</field>
        <field name="model">account.asset.category</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_category_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class" add="o_list_column_filter" separator=" "/>
            </xpath>
        </field>
    </record>

</odoo>
