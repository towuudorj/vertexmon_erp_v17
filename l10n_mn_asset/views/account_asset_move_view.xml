<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="account_asset_move_tree_view">
                <field name="name">account.asset.move.tree</field>
                <field name="model">account.asset.move</field>
                <field name="arch" type="xml">
                    <tree string="Account asset move">
                        <field name="company_id"/>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="user_id"/>
                        <field name="asset_id"/>
                        <field name="owner_id"/>
                        <field name="state"/>
                    </tree>
                </field>
            </record>

            <record model="ir.ui.view" id="account_asset_move_form_view">
                <field name="name">account.asset.move.form</field>
                <field name="model">account.asset.move</field>
                <field name="arch" type="xml">
                    <form string="Account asset move">
                        <header>
                            <button name="action_asset_move_confirm" string="Confirm" type="object" class="btn-primary"/>
                            <button name="action_asset_move_cancel" string="Cancel" type="object" class="btn-primary"/>
                            <field name="state" widget="statusbar"/>
                        </header>
                        <sheet>
                            <group col="4" colspan="2" >
                                <field name="company_id" readonly="state != 'draft'"/>
                                <field name="name" />
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="user_id" readonly="state != 'draft'"/>
                                <field name="asset_id" readonly="state != 'draft'"/>
                                <field name="department_id" readonly="state != 'draft'"/>
                                <field name="owner_id" readonly="state != 'draft'"/>
                                <field name="asset_in_location_id" readonly="state != 'draft'"/>
                                <field name="asset_out_location_id" readonly="state != 'draft'"/>
                                <field name="quantity" readonly="state != 'draft'"/>
                                <field name="note" readonly="state != 'draft'"/>
                            </group>
                        </sheet>
                    </form>
                </field>
            </record>


            <record model="ir.actions.act_window" id="action_account_asset_move_tree_view">
                <field name="name">Account asset move</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">account.asset.move</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="account_asset_move_tree_view"/>
            </record>



    </data>
</odoo>
