<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="seq_account_asset_move" model="ir.sequence">
            <field name="name">Хөрөнгө шилжүүлэг</field>
            <field name="code">account.asset.move</field>
            <field name="prefix">ХШ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record model="ir.ui.view" id="account_asset_move_tree_view">
            <field name="name">account.asset.move.tree</field>
            <field name="model">account.asset.move</field>
            <field name="arch" type="xml">
                <tree string="Хөрөнгө шилжүүлэг" class="o_list_column_filter" decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="from_owner_id"/>
                    <field name="to_owner_id"/>
                    <field name="department_id" optional="show"/>
                    <field name="asset_count"/>
                    <field name="user_id" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="state" widget="badge" decoration-success="state == 'confirm'" decoration-info="state == 'draft'"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="account_asset_move_form_view">
            <field name="name">account.asset.move.form</field>
            <field name="model">account.asset.move</field>
            <field name="arch" type="xml">
                <form string="Хөрөнгө шилжүүлэг">
                    <header>
                        <button name="action_asset_move_confirm" string="Батлах" type="object" class="btn-primary"
                                invisible="state != 'draft'" groups="account.group_account_manager"
                                confirm="Сонгосон хөрөнгийн эзэмшигч хүлээн авагч руу шилжинэ. Үргэлжлүүлэх үү?"/>
                        <button name="%(action_report_asset_move)d" string="Акт хэвлэх" type="action"
                                invisible="state == 'cancel'"/>
                        <button name="action_asset_move_cancel" string="Цуцлах" type="object"
                                invisible="state == 'cancel'" groups="account.group_account_manager"
                                confirm="Батлагдсан бол хөрөнгө өмнөх эзэмшигч рүүгээ буцна. Үргэлжлүүлэх үү?"/>
                        <button name="action_asset_move_draft" string="Ноорог болгох" type="object"
                                invisible="state != 'cancel'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cubes">
                                <field name="asset_count" widget="statinfo" string="Хөрөнгө"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="from_owner_id" readonly="state != 'draft'"
                                       options="{'no_create': True}"/>
                                <field name="to_owner_id" readonly="state != 'draft'"
                                       options="{'no_create': True}"/>
                                <field name="department_id" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="asset_out_location_id" readonly="state != 'draft'"/>
                                <field name="asset_in_location_id" readonly="state != 'draft'"/>
                                <field name="user_id" readonly="state != 'draft'"/>
                                <field name="approved_user_id" invisible="not approved_user_id"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Хөрөнгө" name="assets">
                                <field name="asset_ids" readonly="state != 'draft'"
                                       domain="[('owner_id', '=', from_owner_id), ('state', 'in', ('draft', 'open')), ('company_id', '=', company_id)]"
                                       options="{'no_create': True}">
                                    <tree>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="category_id"/>
                                        <field name="date"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="value" sum="Нийт"/>
                                        <field name="value_residual" sum="Нийт"/>
                                        <field name="owner_id"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Тайлбар" name="note">
                                <field name="note" readonly="state != 'draft'"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="account_asset_move_search_view">
            <field name="name">account.asset.move.search</field>
            <field name="model">account.asset.move</field>
            <field name="arch" type="xml">
                <search string="Хөрөнгө шилжүүлэг">
                    <field name="name"/>
                    <field name="from_owner_id"/>
                    <field name="to_owner_id"/>
                    <field name="asset_ids" string="Хөрөнгө"/>
                    <filter string="Ноорог" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Батлагдсан" name="confirmed" domain="[('state', '=', 'confirm')]"/>
                    <filter string="Цуцлагдсан" name="cancelled" domain="[('state', '=', 'cancel')]"/>
                    <separator/>
                    <filter string="Огноо" name="filter_date" date="date"/>
                    <group expand="0" string="Бүлэглэх">
                        <filter string="Хүлээлгэн өгөгч" name="group_from" context="{'group_by': 'from_owner_id'}"/>
                        <filter string="Хүлээн авагч" name="group_to" context="{'group_by': 'to_owner_id'}"/>
                        <filter string="Төлөв" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_account_asset_move_tree_view">
            <field name="name">Хөрөнгө шилжүүлэг</field>
            <field name="res_model">account.asset.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="account_asset_move_tree_view"/>
            <field name="search_view_id" ref="account_asset_move_search_view"/>
        </record>

        <!-- Хөрөнгийн жагсаалт/маягтаас: Action > Хөрөнгө шилжүүлэх -->
        <record id="action_server_asset_transfer" model="ir.actions.server">
            <field name="name">Хөрөнгө шилжүүлэх</field>
            <field name="model_id" ref="om_account_asset.model_account_asset_asset"/>
            <field name="binding_model_id" ref="om_account_asset.model_account_asset_asset"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = records.action_asset_transfer()</field>
        </record>

    </data>
</odoo>
