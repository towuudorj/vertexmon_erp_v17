<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="stock_picking_income_data">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <t t-if="o.picking_type_code != 'incoming'">
                        <div class="page">
                            <div class="row mb64">
                                <div class="col-6">
                                    <p style="text-align:center;font-size: 30px;margin-left:50px; margin-right:50px;">
                                        <span>Энэ тайланг зөвхөн хүлээн авах захиалгуудаас татах боломжтой.</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-else="o.picking_type_code == 'outgoing'">
                        <div class="page">
                            <div class="row">
                                <p style="text-align:center; font-size: 12px; padding-left:65%;">
                                    <span>Сангийн сайдын 2017 оны 12 дугаар сарын 5 өдрийн 347 тоот тушаалын хавсралт
                                    </span>
                                </p>
                            </div>
                            <div class="col-xs-8" style="text-align:center;">
                                <h4>Орлогын баримт:
                                    <span t-field="o.name"/>
                                </h4>


                            </div>
                            <table class="width: 100%; table table-condensed; text-align: center; border: transparent 1px solid; margin-left:50px; margin-right:50px;">
                                <tr style="border: none;">
                                    <td style="width: 50%; border: none; font-size:11px; padding:3px; text-align:center; text-decoration: underline;">
                                        <span t-field="o.company_id.name"/>
                                    </td>
                                    <td style="width: 50%; border: none; font-size:11px; padding:3px; text-align:center; text-decoration: underline;"></td>
                                </tr>
                                <tr style="border: none; underline;">
                                    <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                        ( Байгууллагын нэр )
                                    </td>
                                    <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                        <span t-field="o.scheduled_date"
                                              t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;yyyy-MM-dd&quot;}"/>
                                    </td>
                                </tr>
                                <tr style="border: none;">
                                    <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                        <span t-field="o.partner_id.name"/>
                                    </td>
                                    <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                        Дагалдах баримт №:
                                        <span t-field="o.origin"/>
                                    </td>
                                </tr>
                                <tr style="border: none;">
                                    <td style="border: none; font-size:11px; padding:3px; text-align:center;">
                                        ( Бэлтгэн нийлүүлэгчийн нэр )
                                    </td>
                                    <td style="border: none; font-size:11px; padding:3px; text-align:center;">

                                    </td>
                                </tr>
                            </table>
                            <table class="width: 100%; table table-condensed">
                                <thead>
                                    <tr>
                                        <th style=" width: 40%; border: 1px solid black; font-size:11px; padding:2px;"
                                            rowspan="2">
                                            <strong>Материалын үнэт зүйлийн нэр, зэрэг, дугаар</strong>
                                        </th>
                                        <th style=" width: 15%;  border: 1px solid black; font-size:11px; padding:2px;"
                                            rowspan="2" class="text-right">
                                            <strong>Код</strong>
                                        </th>
                                        <th style=" width: 15%;  border: 1px solid black; font-size:11px; padding:2px;"
                                            rowspan="2" class="text-right">
                                            <strong>Хэмжих нэгж</strong>
                                        </th>
                                        <th style=" width: 10%;  border: 1px solid black; font-size:11px; padding:2px;"
                                            rowspan="2" class="text-right">
                                            <strong>Нэгж үнэ</strong>
                                        </th>
                                        <th style=" width: 20%; border: 1px solid black; font-size:11px; padding:2px;"
                                            colspan="2">
                                            <strong>Хүлээн авсан</strong>
                                        </th>

                                    </tr>
                                    <tr>
                                        <th style=" width: 10%; border: 1px solid black; font-size:11px; padding:2px;"
                                            class="text-right">
                                            <strong>Тоо</strong>
                                        </th>
                                        <th style=" width: 10%; border: 1px solid black; font-size:11px; padding:2px;"
                                            class="text-right">
                                            <strong>Дүн</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="o.state!='done'">
                                        <t t-if="o.move_ids_without_package">
                                            <tr t-foreach="o.move_ids_without_package" t-as="move">
                                                <t t-if="move.product_id.type !='service'">
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                        <span t-field="move.product_id"/>
                                                    </td>
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                        <span t-field="move.product_id.barcode"/>
                                                    </td>
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                                        class="text-right">
                                                        <span t-field="move.product_uom" groups="product.group_uom"/>
                                                    </td>
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                                        class="text-right">
                                                        <span t-field="move.price_unit"
                                                              t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                                    </td>
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                                        class="text-right">
                                                        <span t-field="move.product_uom_qty"/>
                                                    </td>

                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                                        class="text-right">
                                                        <span t-esc="move.price_unit*move.product_uom_qty"
                                                              t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                                    </td>
                                                </t>
                                            </tr>
                                            <tr class="border-black">
                                                <td colspan="4"
                                                    style="padding: 3px; border: 1px solid black; font-weight: bold; text-align: center;">
                                                    Нийт тоо
                                                </td>
                                                <td style="padding: 3px; border: 1px solid black;  text-align: right;">
                                                    <t t-esc="sum([x for x in o.move_ids_without_package.mapped('product_uom_qty')])"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.state=='done'">
                                        <t t-if="o.move_line_ids_without_package">
                                            <tr t-foreach="o.move_line_ids_without_package" t-as="move">
                                                <t t-if="move.product_id.type !='service'">
                                                    <t t-if="(o.state != 'partially_available') or (move.reserved_availability &gt; 0)">
                                                        <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                            <span t-field="move.product_id"/>
                                                        </td>
                                                        <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                            <span t-field="move.product_id.barcode"/>
                                                        </td>
                                                        <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                                            class="text-right">
                                                            <span t-field="move.product_uom"
                                                                  groups="product.group_uom"/>
                                                        </td>
                                                        <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                                            class="text-right">
                                                            <span t-field="move.move_id.price_unit"
                                                                  t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                                        </td>
                                                        <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                                            class="text-right">
                                                            <span t-field="move.quantity"/>
                                                        </td>
                                                        <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                                            class="text-right">
                                                            <span t-esc="move.move_id.price_unit*move.quantity"
                                                                  t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                                        </td>
                                                    </t>
                                                </t>
                                            </tr>
                                            <tr class="border-black">
                                                <td colspan="4"
                                                    style="font-size:11px; padding: 3px; border: 1px solid black; font-weight: bold; text-align: center;">
                                                    Нийт тоо
                                                </td>
                                                <td style="font-size:11px; padding: 3px; border: 1px solid black;  text-align: right;">
                                                    <t t-esc="sum([x for x in o.move_line_ids_without_package.mapped('quantity')])"/>
                                                </td>
                                                <td style="font-size:11px; padding: 3px; border: 1px solid black;  text-align: right;"></td>
                                            </tr>
                                        </t>
                                    </t>


                                    <tr>
                                        <td style="border: 1px solid black; font-size:11px; padding:2px;">Нийт</td>
                                        <td style="border: 1px solid black; padding:2px;"></td>
                                        <td style="border: 1px solid black; padding:2px;"></td>
                                        <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                            class="text-right">
                                        </td>
                                        <td style="border: 1px solid black; font-size:11px; padding:2px;"
                                            class="text-right">
                                            <t t-if="o.state=='done'">
                                                <span t-esc="sum(line.quantity for line in o.move_line_ids_without_package)"
                                                      t-options='{"widget": "float", "precision": 2}'/>
                                            </t>
                                        </td>
                                        <td style="border: 1px solid black; padding:2px;">
                                            <span t-esc="sum((line.quantity*line.move_id.price_unit) for line in o.move_line_ids_without_package)"
                                                  t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div style="font-size:11px; padding:4px; text-align:right;">Хүлээн авсан
                                :.................................................../................................../
                            </div>
                            <div style="font-size:11px; padding:4px; text-align:right;">Хүлээлгэн өгсөн
                                :................................................../.................................../
                            </div>
                            <div style="font-size:11px; padding:4px; text-align:right;">Ахлах нягтлан бодогч
                                :................................................../.................................../
                            </div>
                            <div style="font-size:11px; padding:4px; text-align:right;">Шалгасан нягтлан бодогч
                                :................................................../.................................../
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <template id="mn_stock_income">
            <t t-call="web.html_container">
                <t t-foreach="doc_ids" t-as="doc_id">
                    <t t-set="lang"/>
                    <t t-call="l10n_mn_stock.stock_picking_income_data" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>