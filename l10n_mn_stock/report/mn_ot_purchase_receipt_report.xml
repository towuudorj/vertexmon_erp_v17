<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="mn_ot_purchase_receipt_data">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <t t-if="o.picking_type_code != 'incoming'">
                        <div class="page">
                            <div class="row mb64">
                                <div class="col-6">
                                    <p style="text-align:center;font-size: 30px;margin-left:50px; margin-right:50px;">
                                        <span>Энэ тайланг зөвхөн хүлээн авах захиалгуудаас татах боломжтой.</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-else="o.picking_type_code == 'outgoing'">
                        <div class="page">
                            <table style="font-size:30px; width:100%; border:none; border-collapse:collapse;">
                                <tr>
                                    <td colspan="2"
                                        style="padding:5px; font-size:20px; text-align:center; border-spacing: 0; border: transparent 1px solid;">
                                        <b>PURCHASE ORDER NUMBER</b>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2"
                                        style="padding:5px; font-size:20px; text-align:center; border-spacing: 0; border: transparent 1px solid;">
                                        <b>
                                            <span t-field="o.ot_code"/>
                                        </b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style=" padding:5px; font-size:20px; text-align:left; border-spacing: 0; border: transparent 1px solid;">
                                        <b>TO:</b>
                                    </td>
                                    <td style="padding:5px; font-size:20px; padding-left:24%; text-align:left; border-spacing: 0; border: transparent 1px solid;">
                                        <b>
                                            <span t-field="o.partner_id.name"/>
                                        </b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style=" padding:5px; font-size:20px; text-align:left; border-bottom:1px solid black; border-left:transparent 1px solid;; border-right:transparent 1px solid;;">
                                        <b>FROM:</b>
                                    </td>
                                    <td style="padding:5px; font-size:20px; padding-left:24%; text-align:left; border-bottom:1px solid black; border-left:transparent 1px solid;; border-right:transparent 1px solid;;">
                                        <b>
                                            <span t-field="o.company_id.name"/>
                                        </b>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <template id="mn_ot_purchase_receipt">
            <t t-call="web.html_container">
                <t t-foreach="doc_ids" t-as="doc_id">
                    <t t-set="lang"/>
                    <t t-call="l10n_mn_stock.mn_ot_purchase_receipt_data" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>