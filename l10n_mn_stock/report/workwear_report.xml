        <template id="mn_workwear_report">
            <t t-call="web.html_container">
                <t t-foreach="doc_ids" t-as="doc_id">
                    <t t-set="lang"/>
                    <t t-call="l10n_mn_stock.mn_workwear_report_data" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
