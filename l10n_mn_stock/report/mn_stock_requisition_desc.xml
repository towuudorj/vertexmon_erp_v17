<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_requisition_desc_data">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <t t-if="o.picking_type_code != 'outgoing'">
                        <div class="page">
                            <div class="row mb64">
                                <div class="col-6">
                                    <p style="text-align:center;font-size: 30px;margin-left:50px; margin-right:50px;">
                                        <span>Энэ тайланг зөвхөн хүргэлтийн захиалгуудаас татах боломжтой.</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-else="o.picking_type_code == 'outgoing'">
                        <div class="page" style="margin-left:50px; margin-right:30px;">
                            <table style="width: 100%; text-align: center; border: transparent 1px solid;">
                                <tr style="border: none;">
                                    <td style="width: 50%; text-align: right; border: none;">
                                        <img t-attf-src="data:image/jpg;base64,{{o.company_id.logo}}"
                                             style="width:190px;height:60px;"/>
                                    </td>
                                </tr>
                            </table>
                            <h3 style="text-align:center; font-size:14px; margin-top: 50px;">
                                <b>ШААРДАХ ХУУДАС №
                                    <span t-field="o.name"/>
                                </b>
                            </h3>

                            <p style="text-align:right; font-size:12px;">
                                <span t-field="o.scheduled_date"
                                      t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;yyyy&quot;}"/>
                                он
                                <span t-field="o.scheduled_date"
                                      t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;MM&quot;}"/>
                                сар
                                <span t-field="o.scheduled_date"
                                      t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd&quot;}"/>
                                өдөр
                            </p>

                            <table style="width: 100%; font-size:11px; text-align: left; border: transparent 1px solid; margin-bottom: 20px;">
                                <tr style="height: 30px;">
                                    <td style="width: 15%; font-weight: bold; padding: 5px;">Хэнээс:</td>
                                    <td style="width: 85%; border-bottom: 1px solid #000; padding: 5px;">
                                        <t t-esc="o.location_id.name"/>
                                    </td>
                                </tr>
                                <tr style="height: 25px;">
                                    <td colspan="2"
                                        style="font-size:11px; padding: 5px; text-align:center; font-style: italic; color: #666;">
                                        (овог, нэр, албан тушаал)
                                    </td>
                                </tr>
                                <tr style="height: 30px;">
                                    <td style="font-weight: bold; padding: 5px;">Хаана:</td>
                                    <td style="border-bottom: 1px solid #000; padding: 5px;">
                                        <t t-esc="o.location_dest_id.name"/>
                                    </td>
                                </tr>
                                <tr style="height: 25px;">
                                    <td colspan="2"
                                        style="font-size:11px; padding: 5px; text-align:center; font-style: italic; color: #666;">
                                        (овог, нэр, албан тушаал)
                                    </td>
                                </tr>
                                <tr style="height: 30px;">
                                    <td style="font-weight: bold; padding: 5px;">Зориулалт:</td>
                                    <td style="border-bottom: 1px solid #000; padding: 5px;">
                                        <t t-esc="o.note"/>
                                        <t t-esc="o.analytic_id.name"/>
                                    </td>
                                </tr>
                            </table>

                            <table style="width: 100%; font-size:11px; text-align: left; border: transparent 1px solid; margin-bottom: 20px;">
                                <tr>
                                    <td style="width: 20%; font-weight: bold; padding: 12px 5px;">Харилцагчийн нэр:</td>
                                    <td style="width: 30%; border-bottom: 1px solid #000; padding: 12px 5px;">
                                        <t t-esc="o.partner_id.name"/>
                                    </td>
                                    <td style="width: 20%; font-weight: bold; padding: 12px 5px;">Буцаж ирэх огноо:</td>
                                    <td style="width: 30%; border-bottom: 1px solid #000; padding: 12px 5px;"/>
                                </tr>
                            </table>

                            <br/>

                            <table style="width: 100%; font-size:11px; text-align: center; border-collapse: collapse; border: 1px solid black;">
                                <tr style="background: #f0f0f0;">
                                    <th style="padding: 5px; border: 1px solid black;">№</th>
                                    <th style="padding: 5px; border: 1px solid black;">Барааны нэр</th>
                                    <th style="padding: 5px; border: 1px solid black;">Код</th>
                                    <th style="padding: 5px; border: 1px solid black; width:20%;">Тайлбар</th>
                                    <th style="padding: 5px; border: 1px solid black;">Хэмжих нэгж</th>
                                    <th style="padding: 5px; border: 1px solid black;">Хүссэн</th>
                                    <th style="padding: 5px; border: 1px solid black;">Зөвшөөрсөн</th>
                                    <th style="padding: 5px; border: 1px solid black;">Олгосон</th>
                                </tr>
                                <t t-set="i" t-value="1"/>
                                <t t-if="o.state!='done'">
                                    <tr t-foreach="o.move_ids_without_package" t-as="line">
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <span t-esc="i"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: left;">
                                            <t t-esc="line.product_id.name"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <t t-esc="line.product_id.default_code"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: left;">
                                            <t t-esc="line.description_picking"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <t t-esc="line.product_uom.name"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <t t-esc="line.product_uom_qty"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <t t-esc="line.product_uom_qty"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;"/>
                                        <t t-set="i" t-value="i + 1"/>
                                    </tr>
                                </t>
                                <t t-if="o.state=='done'">
                                    <tr t-foreach="o.move_line_ids_without_package" t-as="line">
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <span t-esc="i"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: left;">
                                            <t t-esc="line.product_id.name"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <t t-esc="line.product_id.default_code"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: left;">
                                            <t t-esc="line.move_id.description_picking"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <t t-esc="line.product_uom_id.name"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <t t-esc="line.quantity"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;">
                                            <t t-esc="line.quantity"/>
                                        </td>
                                        <td style="padding: 5px; border: 1px solid black; text-align: center;"/>
                                        <t t-set="i" t-value="i + 1"/>
                                    </tr>
                                </t>
                            </table>

                            <br/>
                            <t t-set="sig_dict" t-value="o.get_signature_users()"/>
                            <table style="width: 100%; font-size:11px;">
                                <tr>
                                    <td style="width: 15%; font-weight: bold;  padding: 5px;">Зөвшөөрсөн:</td>
                                    <td style="width: 35%; padding-right 25px; padding: 5px;">____________________ /
                                        ___________________ /
                                        <t t-if="sig_dict.get('approved', None) != None and sig_dict.get('approved').signature_image">
                                            <div style="margin-left: 12px; margin-top: -30px; position: fixed; border:none; z-index:2;">
                                                <img t-attf-src="data:image/jpg;base64,{{sig_dict.get('approved').signature_image}}"
                                                     style="width:80px;"/>
                                            </div>
                                            <div style="margin-left: 120px; margin-top: -15px; position: fixed; border:none; z-index:2;">
                                               <t t-esc="sig_dict.get('approved').signature"/>
                                            </div>
                                        </t>
                                    </td>
                                    <td style="width: 15%; font-weight: bold; padding: 5px;">Олгосон нярав:</td>
                                    <td style="width: 35%; padding-right 25px; padding: 5px;">____________________ /
                                        ___________________ /
                                        <t t-if="sig_dict.get('issued_cashier', None) != None and sig_dict.get('issued_cashier').signature_image">
                                            <div style="margin-left: 12px; margin-top: -30px; position: fixed; border:none; z-index:2;">
                                                <img t-attf-src="data:image/jpg;base64,{{sig_dict.get('issued_cashier').signature_image}}"
                                                     style="width:80px;"/>
                                            </div>
                                            <div style="margin-left: 120px; margin-top: -15px; position: fixed; border:none; z-index:2;">
                                               <t t-esc="sig_dict.get('issued_cashier').signature"/>
                                            </div>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 15%; font-weight: bold;  padding: 5px;">Дарга:</td>
                                    <td style="width: 35%; padding-right 25px; padding: 5px;">____________________ /
                                        ____________________ /
                                        <t t-if="sig_dict.get('head', None) != None and sig_dict.get('head').signature_image">
                                            <div style="margin-left: 12px; margin-top: -30px; position: fixed; border:none; z-index:2;">
                                                <img t-attf-src="data:image/jpg;base64,{{sig_dict.get('head').signature_image}}"
                                                     style="width:80px;"/>
                                            </div>
                                            <div style="margin-left: 120px; margin-top: -15px; position: fixed; border:none; z-index:2;">
                                               <t t-esc="sig_dict.get('head').signature"/>
                                            </div>
                                        </t>
                                    </td>
                                    <td style="width: 15%; font-weight: bold;  padding: 5px;">Хүлээн авсан:</td>
                                    <td style="width: 35%; padding-right 25px; padding: 5px;">____________________ /
                                        ___________________ /
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 15%; font-weight: bold;  padding: 5px;">Нягтлан бодогч:</td>
                                    <td style="width: 35%; padding-right 25px; padding: 5px;">____________________ /
                                        ____________________ /
                                        <t t-if="sig_dict.get('accountant', None) != None and sig_dict.get('accountant').signature_image">
                                            <div style="margin-left: 12px; margin-top: -30px; position: fixed; border:none; z-index:2;">
                                                <img t-attf-src="data:image/jpg;base64,{{sig_dict.get('accountant').signature_image}}"
                                                     style="width:80px;"/>
                                            </div>
                                            <div style="margin-left: 120px; margin-top: -15px; position: fixed; border:none; z-index:2;">
                                               <t t-esc="sig_dict.get('accountant').signature"/>
                                            </div>
                                        </t>
                                    </td>
                                    <td style="width: 15%; font-weight: bold;  padding: 5px; white-space: nowrap;">
                                        Шаардах хуудас бичсэн:
                                    </td>
                                    <td style="width: 35%; padding-right 25px; padding: 5px;">____________________ /
                                        ____________________ /
                                        <t t-if="sig_dict.get('picking_created', None) != None and sig_dict.get('picking_created').signature_image">
                                            <div style="margin-left: 12px; margin-top: -30px; position: fixed; border:none; z-index:2;">
                                                <img t-attf-src="data:image/jpg;base64,{{sig_dict.get('picking_created').signature_image}}"
                                                     style="width:80px;"/>
                                            </div>
                                            <div style="margin-left: 120px; margin-top: -15px; position: fixed; border:none; z-index:2;">
                                               <t t-esc="sig_dict.get('picking_created').signature"/>
                                            </div>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 15%; font-weight: bold;  padding: 5px;">Санхүүгийн шинжээч:</td>
                                    <td style="width: 35%; padding-right 25px; padding: 5px;">____________________ /
                                        ____________________ /
                                        <t t-if="sig_dict.get('financial_analyst', None) != None and sig_dict.get('financial_analyst').signature_image">
                                            <div style="margin-left: 12px; margin-top: -30px; position: fixed; border:none; z-index:2;">
                                                <img t-attf-src="data:image/jpg;base64,{{sig_dict.get('financial_analyst').signature_image}}"
                                                     style="width:80px;"/>
                                            </div>
                                            <div style="margin-left: 120px; margin-top: -15px; position: fixed; border:none; z-index:2;">
                                               <t t-esc="sig_dict.get('financial_analyst').signature"/>
                                            </div>
                                        </t>
                                    </td>
                                    <t t-if="sig_dict.get('coach') and sig_dict.get('coach').signature_image">
                                        <td style="width: 15%; font-weight: bold;  padding: 5px; white-space: nowrap;">
                                            Дадлагажуулагч:
                                        </td>
                                        <td style="width: 35%; padding-right 25px; padding: 5px;">____________________ /
                                            ____________________ /
                                            <t t-if="sig_dict.get('coach', None) != None and sig_dict.get('coach').signature_image">
                                                <div style="margin-left: 12px; margin-top: -30px; position: fixed; border:none; z-index:2;">
                                                    <img t-attf-src="data:image/jpg;base64,{{sig_dict.get('coach').signature_image}}"
                                                         style="width:80px;"/>
                                                </div>
                                                <div style="margin-left: 120px; margin-top: -15px; position: fixed; border:none; z-index:2;">
                                                   <t t-esc="sig_dict.get('coach').signature"/>
                                                </div>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <template id="mn_stock_requisition_desc_report">
            <t t-call="web.html_container">
                <t t-foreach="doc_ids" t-as="doc_id">
                    <t t-set="lang"/>
                    <t t-call="l10n_mn_stock.report_requisition_desc_data" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>