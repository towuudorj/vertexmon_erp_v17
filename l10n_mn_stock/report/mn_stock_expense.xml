                                                        </td>
                                                        <td style="border: 1px solid black; font-size:11px; padding:4px; text-align:right;">
                                                            <span t-esc="move.price_subtotal"
                                                                  t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                                        </td>
                                                    </t>
                                                    <t t-set="i" t-value="i+1"/>
                                                </tr>
                                                <tr class="border-black">
                                                    <td colspan="3"
