                            <t t-if="o.approve_use_stamp==True">
                                <div style="margin-left: 20px;  position: fixed; border:none; z-index:3; transform: rotate(352deg);">
                                    <img t-attf-src="data:image/jpg;base64,{{o.company_id.account_stamp}}"
                                         style="height:100px;"/>
                                </div>
                            </t>
                            <div style="position:relative; margin-left: 60px; margin-bottom: 7px;">
