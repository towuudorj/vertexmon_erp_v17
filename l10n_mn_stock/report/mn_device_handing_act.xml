<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
			
        <template id="mn_device_handing_act">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <table style="width: 100%; margin-left: 10px; margin-right: 40px;">
                             <tr>
                                 <td style="width: 50%; text-align: right; border: none; padding-right: 20px; margin-top: px;">
                                     <p style="font-size: 11px; line-height: 1.5">
                                         <t t-if="o.company_id.street"><span t-field="o.company_id.street"/><br/></t>
                                         <t t-if="o.company_id.phone">Утас : <span t-field="o.company_id.phone"/></t>
                                     </p>
                                 </td>
                             </tr>
                             <tr>
                                 <td style="width: 50%; text-align: left; border: none; padding-left: 40px; margin-top: -50px;">
                                     <img t-attf-src="data:image/jpg;base64,{{o.company_id.logo}}" style="width:190px;height:60px;"/>
                                 </td>
                             </tr>
                         </table>
         
                         <div class="col-xs-8" style="text-align:center; font-size: 18px;  margin-right:20px;">
                             <h4>Төхөөрөмж хүлээлцэх акт: <span t-field="o.name"/></h4>
                         </div>
                         
                         <p style="text-align:right; font-size:12px;">
                             <span t-field="o.date" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;yyyy&quot;}"/> он 
                             <span t-field="o.date" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;MM&quot;}"/> сар 
                             <span t-field="o.date" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd&quot;}"/> өдөр
                         </p>
         
                         <div class="col-xs-8" style="text-align:center; font-size:15px; margin-bottom: 30px;">
                             <p style="text-align:center;"><span t-field="o.partner_id.name"/>-д</p>
                         </div>
         
                         <table style="width: 95%; margin-left:50px; margin-right:20px;">
                             <thead>
                                 <tr>
                                     <th style="width: 3%; border: 1px solid black; font-size:11px; padding:3px;"><strong>№</strong></th>
                                     <th style="width: 10%; border:1px solid black; font-size:11px; padding:3px;"><strong>Төхөөрөмжийн нэр</strong></th>
                                     <!--<th style="width: 5%; border: 1px solid black; text-align: center; font-size:11px; padding:3px;"><strong>Тодорхойлолт</strong></th> -->
                                     <th style="width: 5%; border: 1px solid black; text-align: center; font-size:11px; padding:3px;" class="text-right"><strong>Тоо</strong></th>
                                     <th style="width: 7%; border: 1px solid black; text-align: center; font-size:11px; padding:3px;"><strong>Тайлбар</strong></th>
                                 </tr>
                             </thead>
                             <tbody>
                                 <t t-if="o.state!='done'">
                                     <t t-if="o.move_ids_without_package">
                                         <t t-set="i" t-value="1"/>
                                         <tr t-foreach="o.move_ids_without_package" t-as="move">
                                             <t t-if="move.product_id.type !='service'">
                                                 <td style="border: 1px solid black; font-size:11px; padding:4px; text-align:center;"><span t-esc="i"/></td>   
                                                 <td style="border: 1px solid black; font-size:11px; padding:5px;"><span t-field="move.product_id"/></td>
                                                 <!-- <td style="border: 1px solid black; font-size:11px; padding:5px; text-align:center;"/> -->
                                                 <td style="border: 1px solid black; font-size:11px; padding:5px; text-align:right;"><span t-field="move.quantity" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/></td>
                                                 <td style="border: 1px solid black; font-size:11px; padding:4px; text-align:right;"/>
                                             </t>
                                             <t t-set="i" t-value="i+1"/>
                                         </tr>
                                     </t>
                                 </t>
                             </tbody>
                         </table>
         
                         <table style="width: 100%; font-size:11px; margin-left:50px; margin-right:20px; margin-top: 30px;">                    
                             <tr style="height: 40px;">
                                 <td style="width: 20%; font-weight: bold; padding: 5px;">Нийлүүлэгчийг төлөөлж:</td>
                                 <td style="width: 30%; padding: 5px;"><span t-field="o.company_id.name"/></td>
                                 <td style="width: 15%; font-weight: bold; padding: 5px;">Захиалагчийг төлөөлж:</td>
                                 <td style="width: 35%; padding: 5px;"><span t-field="o.partner_id.name"/></td>
                             </tr>
                             <tr style="height: 40px;">
                                 <td colspan="2" style="width: 35%; padding: 5px;">/............................................./</td>
                                 <td colspan="2" style="width: 35%; padding: 5px;">/............................................./</td>
                             </tr>
 
                             <tr style="height: 40px;">
                                 <td colspan="2" style="width: 35%; padding: 5px;">/............................................./</td>
                                 <td colspan="2" style="width: 35%; padding: 5px;">/............................................./</td>
                             </tr>
                         </table>
                     </div>
                </t>
            </t>
        </template>

            <template id="device_handing_act_report">
                <t t-call="web.html_container">
                    <t t-foreach="doc_ids" t-as="doc_id">
                        <t t-set="lang"/>
                        <t t-call="l10n_mn_stock.mn_device_handing_act" t-lang="lang"/>
                    </t>
                </t>
            </template>

    </data>
</odoo>