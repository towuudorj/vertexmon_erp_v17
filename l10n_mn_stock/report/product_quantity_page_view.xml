<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="product_quantity_page_report_view" model="ir.ui.view">
			<field name="name">product.quantity.page.form</field>
			<field name="model">product.quantity.page</field>
			<field name="arch" type="xml">
				<form string="Product">
					<group>
						<field name="company_id" />
						<field name="product_id"/>
						<field name="category_id"/>
						<field name="start_date"/>
						<field name="end_date"/>
					</group>
	
					<footer>
						<button name="action_print_xls_report" string="Export" type="object"
							class="oe_highlight" />
						or
						<button string="Cancel" class="oe_link" special="cancel" />
					</footer>
				</form>
			</field>
		</record>

		<record id="action_product_quantity_page" model="ir.actions.act_window">
			<field name="name">Бараа материалын тооллогын хуудас</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">product.quantity.page</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="product_quantity_page_report_view" />
			<field name="target">new</field>
		</record>
        



    </data>
</odoo>
