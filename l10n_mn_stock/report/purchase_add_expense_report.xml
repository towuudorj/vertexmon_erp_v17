<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

         <template id="mn_purchase_add_expense_data">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="row">
                            <p style="text-align:center; font-size: 12px; padding-left:65%;">
                                <span></span>
                                </p>
                                </div>
                                <div class="col-xs-8" style="text-align:center;">
                                <h4>Худалдан авалтын зардлын баримт</h4>
                                
                                        
                                </div>
                                <table class="table table-condensed">
                                    <thead>
                                        <tr style="border: 1px solid black;">
                                            <th style="width: 10%; border: 1px solid black; font-size:11px; padding:2px;"><strong>Дугаар</strong></th>
                                            <th style="width: 20%; border: 1px solid black; font-size:11px; padding:2px;"><strong>Орлогын баримт</strong></th>
                                            <th style="width: 15%; border: 1px solid black; font-size:11px; padding:2px;"><strong>Худалдан авалт</strong></th>
                                            <th style="width: 15%; border: 1px solid black; font-size:11px; padding:2px;"><strong>Харилцагч</strong></th>
                                            <th style="width: 20%; border: 1px solid black; font-size:11px; padding:2px;"><strong>Огноо</strong></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                <span t-field="o.name"/>
                                            </td>
                                            <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                <t t-foreach="o.picking_ids" t-as="pick">
                                                    <span t-esc="pick.name"/>
                                                </t>
                                            </td>
                                            <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                
                                                 <t t-foreach="o.po_ids" t-as="po">
                                                    <span t-esc="po.name"/>
                                                </t>
                                            </td>
                                            <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                    <span t-esc="o.vendor_bill_id.partner_id.name"/>
                                            </td>
                                            <td style="border: 1px solid black; font-size:11px; padding:2px;">
                                                <span t-field="o.date"/>
                                            </td>
                                           
                                        </tr>
                                    </tbody>
                                    </table>
                                    <table class="width: 100%; table table-condensed" >
                                        <thead>
                                            <tr>
                                                <th style="width: 50%; border: 1px solid black; font-size:11px; padding:2px;"><strong>Нэмэлт зардал</strong></th>
                                                <th style="width: 10%; border: 1px solid black; font-size:11px; padding:2px;"><strong>Валют</strong></th>
                                                <th style=" width: 20%; border: 1px solid black; font-size:11px; padding:2px;" class="text-right"><strong>Хувиарлах арга</strong></th>
                                                <th style=" width: 20%; border: 1px solid black; font-size:11px; padding:2px;" class="text-right"><strong>Өртөг</strong></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="o.cost_lines">
                                            <tr t-foreach="o.cost_lines" t-as="move">
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;"><span t-field="move.product_id"/></td> 
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;"><span t-field="o.currency_id.name"/></td>  
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;"><span t-field="move.split_method"/></td>
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px;" class="text-right">
                                                        <span t-field="move.price_unit"/>
                                                    </td>
                                                
                                            </tr>
                                            </t>
                                                            
                        
                                        </tbody>
                                    </table>
                    <table class="width: 100%; table table-condensed" >
                                        <thead>
                                            <tr>
                                                <th style="width: 20%; border: 1px solid black; font-size:11px; padding:2px;"><strong>Нэмэлт зардал</strong></th>
                                                <th style=" width: 20%; border: 1px solid black; font-size:11px; padding:2px;" class="text-right"><strong>Бараа</strong></th>
                                                <th style=" width: 15%; border: 1px solid black; font-size:11px; padding:2px;" class="text-right"><strong>Тоо хэмжээ</strong></th>
                                                <th style=" width: 15%; border: 1px solid black; font-size:11px; padding:2px;" class="text-right"><strong>Анхны өртөг</strong></th>
                                                <th style=" width: 15%; border: 1px solid black; font-size:11px; padding:2px;" class="text-right"><strong>Шингэсэн нэгж өртөг</strong></th>
                                                <th style=" width: 15%; border: 1px solid black; font-size:11px; padding:2px;" class="text-right"><strong>Өртөгт шингэх зардал</strong></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="o.valuation_adjustment_lines">
                                            <tr t-foreach="o.valuation_adjustment_lines" t-as="line">
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px; text-align:right;"><span t-field="line.cost_line_id"/></td>   
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px; text-align:right;"><span t-field="line.product_id"/></td>  
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px; text-align:right;"><span t-field="line.quantity"/></td>  
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px; text-align:right;"><span t-field="line.former_cost"/></td>  
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px; text-align:right;"><span t-field="line.unit_price"/></td>
                                                    <td style="border: 1px solid black; font-size:11px; padding:2px; text-align:right;" class="text-right">
                                                        <span t-field="line.additional_landed_cost"/>
                                                    </td>
                                            </tr>
                                            </t>
                                
                                                                    
                                
                                            </tbody>
                                        </table>
                    <div style="font-size:11px; padding:4px;"> Шалгасан :.................................................../................................../
                    </div>                                                                                                                                             
                    </div>
                </t>
            </t> 
        </template>
    
        <template id="mn_purchase_add_expense">
            <t t-call="web.html_container">
                <t t-foreach="doc_ids" t-as="doc_id">
                    <t t-set="lang"/>
                    <t t-call="l10n_mn_stock.mn_purchase_add_expense_data" t-lang="lang"/>
                </t>
            </t>
        </template>

        

    </data>
</odoo>
