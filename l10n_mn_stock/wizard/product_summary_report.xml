<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    
        <record id="product_summary_report_view" model="ir.ui.view">
			<field name="name">product.summary.report</field>
			<field name="model">product.summary.report</field>
			<field name="arch" type="xml">
				<form string="Product summary report" >
					<group>
						<field name="company_id" />
						<field name="location_ids" invisible="1"/>
						<field name="product_id"/>
						<field name="categ_id"/>
						<field name="is_transaction" string="Гүйлгээтэй бараа татах"/>
						<field name="type"/>
						<field name="dont_show_inventory_count"/>
						<field name="hide_zero_qty"/>
						<field name="start_date"/>
						<field name="end_date"/>
					</group>
					<field name="warehouse_ids" />
					<footer>
						<button name="action_print_xls_report" string="Export" type="object"
							class="oe_highlight" />
						<button name="action_preview_report" string="Preview" type="object" class="oe_highlight"/>
						<button string="Cancel" class="oe_link" special="cancel" />
					</footer>
				</form>
			</field>
		</record>

		<record id="action_product_summary_report" model="ir.actions.act_window">
			<field name="name">Бараа материалын хураангуй тайлан</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">product.summary.report</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="product_summary_report_view" />
			<field name="target">new</field>
		</record>
		

    </data>
</odoo>