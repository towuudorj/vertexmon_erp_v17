<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    
        <record id="product_supply_report_view" model="ir.ui.view">
			<field name="name">supply.product.report</field>
			<field name="model">supply.product.report</field>
			<field name="arch" type="xml">
				<form string="Product summary report" >
					<group>
						<field name="company_id"/>
						<field name="group_by_partner"/>
						<field name="start_date"/>
						<field name="end_date"/>
					</group>
					<footer>
						<button name="action_print_xls_report" string="Export" type="object"
							class="oe_highlight" />
						<button name="action_preview_report" string="Preview" type="object" class="oe_highlight"/>
						<button string="Cancel" class="oe_link" special="cancel" />
					</footer>
				</form>
			</field>
		</record>

		<record id="action_product_supply_report" model="ir.actions.act_window">
			<field name="name">Supply product report</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">supply.product.report</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="product_supply_report_view" />
			<field name="target">new</field>
		</record>
		

    </data>
</odoo>