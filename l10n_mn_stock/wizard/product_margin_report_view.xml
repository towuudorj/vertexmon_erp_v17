<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="product_margin_report_view" model="ir.ui.view">
			<field name="name">product.margin.report</field>
			<field name="model">product.margin.report</field>
			<field name="arch" type="xml">
				<form string="Product detail report" >
					<group>
						<field name="company_id" />
						<field name="location_ids" />
						<field name="product_ids"/>
						<field name="categ_ids"/>
						<field name="date_from"/>
						<field name="date_to"/>
					</group>
					<field name="warehouse_ids" />
					<footer>
						<button name="action_print_xls_report" string="Export" type="object"
							class="oe_highlight" />
						or
						<button string="Cancel" class="oe_link" special="cancel" />
					</footer>
				</form>
			</field>
		</record>

		<record id="action_product_margin_report" model="ir.actions.act_window">
			<field name="name">Бараа материалын тайлан</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">product.margin.report</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="product_margin_report_view" />
			<field name="target">new</field>
		</record>
        

    </data>
</odoo>
