<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mn_stock_move_line_inherit_view" model="ir.ui.view">
            <field name="name">inherit.mn.stock.move.line.tree</field>
            <field name="model">stock.move.line</field>            
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='quantity']" position="after">   
                	<field name="delivered_qty" optional="show"/>
                    <field name="package_no" optional="show"/>
                    <field name="net_weight" optional="show"/>
                    <field name="gross_weight" optional="show"/>
                    <field name="dimensions" optional="show"/>
                    <field name="cbm" optional="show"/>

                </xpath>
            </field>
		</record>
		
		
		
		<record id="mn_stock_move_line_tree_inherit_view" model="ir.ui.view">
            <field name="name">inherit.mn.stock.move.line.trees</field>
            <field name="model">stock.move.line</field>            
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='quantity']" position="after">
                	<field name="total_cost_price" optional="hidden"/>
                	<field name="po_origin"/>
                </xpath>
                <xpath expr="//field[@name='quantity']" position="before">
                	<field name="cost_price"/>
                </xpath>
                <xpath expr="//field[@name='product_id']" position="before">
                	<field name="analytic_id" optional="hidden"/>
                	<field name="related_partner_id" optional="hidden"/>
                </xpath>
            </field>
		</record>

        <record id="stock_move_line_view_search" model="ir.ui.view">
            <field name="name">stock.move.line.search</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.stock_move_line_view_search" />
            <field name="arch" type="xml">
                <filter name="by_category" position="after">
                    <filter string="Project" name="by_project" domain="[]" context="{'group_by': 'analytic_id'}"/>
                    <filter string="By Customer" name="by_partner" domain="[]" context="{'group_by':'partner_id'}"/>
                    <filter string="Бэлтгэн нийлүүлэгч" name="by_supplier" domain="[]" context="{'group_by':'supplier_partner_id'}"/>
                </filter>
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="partner_id"/>
                    <field name="delivery_partner_id"/>
                    <field name="supplier_partner_id"/>
                </xpath>
            </field>
        </record>

        <record id="mn_stock_move_line_tree_inherit_view" model="ir.ui.view">
            <field name="name">inherit.mn.stock.move.line.trees</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="delivery_partner_id" string="Хүргэлтийн хаяг"/>
                    <field name="supplier_partner_id"/>
                </xpath>
                <xpath expr="//field[@name='product_uom_id']" position="after">
                    <field name="cost_price" groups="account.group_account_manager" readonly="1"/>
                </xpath>

            </field>
        </record>

        <record id="mn_stock_move_line_tree_related_order_view" model="ir.ui.view">
            <field name="name">inherit.mn.stock.move.line.related.order</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="related_order_id" invisible="1"/>
                    <field name="related_order_model" invisible="1"/>
                    <button name="action_view_related_order" type="object"
                        string="Худалдан авалт" class="btn-link text-success"
                        invisible="related_order_model != 'purchase.order'"/>
                    <button name="action_view_related_order" type="object"
                        string="Борлуулалт" class="btn-link text-danger"
                        invisible="related_order_model != 'sale.order'"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
