<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

            <record id="mn_stock_pikcing_inherit_view" model="ir.ui.view">
                <field name="name">inherit.mn.stock.picking.form</field>
                <field name="model">stock.picking</field>            
                <field name="inherit_id" ref="stock.view_picking_form"/>
                <field name="arch" type="xml">                
                    <xpath expr="//field[@name='origin']" position="after">
                    	<field name="is_work_out"/>
                        <field name="purchase_count"/>
                        <field name="ot_code"/>
                        <field name="ot_address_type"/>
                        <field name="ot_delivery_type" /> 
                        <field name="project_type" /> 
                        <field name="ot_contract"/>
                        <field name="analytic_id" string="Project" invisible="project_type=='tender'"/>
                        <field name="analytic_id" string="Tender" invisible="project_type=='project'"/>
                    </xpath>
                    
                    <xpath expr="//notebook/page[@name='operations']/field[@name='move_ids_without_package']/tree/field[@name='product_uom_qty']" position="after">
                		<field name="sale_prices"/>
                        <field name="price_subtotal"/>
                    </xpath>

                    <xpath expr="//field[@name='package_level_ids']" position="after">
                        <group name="note_group" col="6" class="mt-2 mt-md-0">
                            <group colspan="4">
                            </group>
                            <group colspan="2">
                                <field name="amount_total" string="Нийт дүн" colspan="2" readonly="1"/>
                            </group>
                            <div class="clearfix"/>
                        </group>
                    </xpath>

                    <xpath expr="//button[@name='action_confirm']" position="attributes">
                		<attribute name="groups">l10n_mn_stock.group_picking_receive</attribute>
                    </xpath>
                    <xpath expr="//button[@name='button_validate' and contains(@class, 'o_btn_validate')]" position="attributes">
                		<attribute name="groups">l10n_mn_stock.group_picking_receive</attribute>
                    </xpath>
                    <xpath expr="//button[@name='button_validate' and contains(@class, 'oe_highlight')]" position="attributes">
                		<attribute name="groups">l10n_mn_stock.group_picking_receive</attribute>
                    </xpath>
                    <xpath expr="//field[@name='location_id']" position="after">
                        <field name="approve_use_stamp" groups="l10n_mn_stock.group_picking_receive"/>
                    </xpath>

                    <xpath expr="//notebook/page[@name='operations']" position="after">
                		<page string="Signature approves">
                            <field name="signature_user_ids" options="{'no_create': True, 'no_quick_create': True}">
                                <tree create="0" delete="0">
                                    <field name="user_id"/>
                                    <field name="type"/>
                                    <field name="is_approve_signature"/>
                                </tree>
                                <form create="0" delete="0">
                                    <group>
                                        <field name="user_id" readonly="1"/>
                                        <field name="is_approve_signature" readonly="user_id != uid"/>
                                    </group>
                                    <group>
                                        <field name="type" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </xpath>
                    <xpath expr="//button[@name='button_validate' and contains(@class, 'oe_highlight')]" position="after">
                        <field name="can_approve_signature" invisible="1"/>
                		<button name="link_signature" type="object" string="Link signature" invisible="not can_approve_signature"/>
                    </xpath>
                </field>
            </record>

    </data>
</odoo>
