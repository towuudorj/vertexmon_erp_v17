<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mn_stock_inherit_product_product_view" model="ir.ui.view">
            <field name="name">inherit.mn.stock.product.form</field>
            <field name="model">product.template</field>            
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">                
                <xpath expr="//field[@name='barcode']" position="after">   
                	<field name="distributor_ids"/>
                    <field name="model"/>
                    <field name="is_quotation"/>
                    <field name="ot_code"/>
                </xpath>
                <field name="categ_id" position="before">
                    <field name="validity_period"/>
                </field>
            </field>
		</record>

        <record id="product_product_form_inherit_view" model="ir.ui.view">
            <field name="name">product.product.brand.search</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <field name="categ_id" position="after">
                    <field name="model" required="1"/>
                </field>
                <div name="standard_price_uom" position="after">
                    <field name="validity_period"/>
                </div>
            </field>
        </record>

    </data>
</odoo>
