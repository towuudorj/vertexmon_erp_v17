<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Агуулахын жагсаалтуудад баганаар шүүх мөр (vertexmon_tools: o_list_column_filter) -->

    <!-- Шилжүүлгүүд (Хүлээгдэж буй шилжилт мөн адил) -->
    <record id="stock_picking_tree_column_filter" model="ir.ui.view">
        <field name="name">stock.picking.column.filter.stock_picking_tree_column_filter</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class" add="o_list_column_filter" separator=" "/>
            </xpath>
        </field>
    </record>

    <!-- Шилжүүлгийн маягт доторх барааны мөрүүд -->
    <record id="stock_picking_form_moves_column_filter" model="ir.ui.view">
        <field name="name">stock.picking.column.filter.stock_picking_form_moves_column_filter</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/tree" position="attributes">
                <attribute name="class" add="o_list_column_filter" separator=" "/>
            </xpath>
        </field>
    </record>

    <!-- Барааны хөдөлгөөн (stock.move) -->
    <record id="stock_move_tree_column_filter" model="ir.ui.view">
        <field name="name">stock.move.column.filter.stock_move_tree_column_filter</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class" add="o_list_column_filter" separator=" "/>
            </xpath>
        </field>
    </record>

    <!-- Хөдөлгөөний түүх (stock.move.line) -->
    <record id="stock_move_line_tree_column_filter" model="ir.ui.view">
        <field name="name">stock.move.line.column.filter.stock_move_line_tree_column_filter</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class" add="o_list_column_filter" separator=" "/>
            </xpath>
        </field>
    </record>

    <!-- Барааны үлдэгдэл -->
    <record id="stock_quant_tree_column_filter" model="ir.ui.view">
        <field name="name">stock.quant.column.filter.stock_quant_tree_column_filter</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class" add="o_list_column_filter" separator=" "/>
            </xpath>
        </field>
    </record>

    <!-- Тооллого / физик үлдэгдэл -->
    <record id="stock_quant_inventory_tree_column_filter" model="ir.ui.view">
        <field name="name">stock.quant.column.filter.stock_quant_inventory_tree_column_filter</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class" add="o_list_column_filter" separator=" "/>
            </xpath>
        </field>
    </record>

</odoo>
