<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_distributor_register_form" model="ir.ui.view">
            <field name="name">distributor.register.form</field>
            <field name="model">distributor.register</field>
            <field name="arch" type="xml">
                <form string="Job">
                    <sheet>
                        <group>
                            <field name="company_id"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_distributor_register_tree" model="ir.ui.view">
            <field name="name">distributor.register.tree</field>
            <field name="model">distributor.register</field>
            <field name="arch" type="xml">
               	<tree string="Distributor register">
                    <field name="name"/>
                    <field name="code"/>
                </tree>
            </field>
        </record>


        <record id="view_distributor_register_filter" model="ir.ui.view">
            <field name="name">distributor.register.search</field>
            <field name="model">distributor.register</field>
            <field name="arch" type="xml">
                <search string="Vat district">
                    <field name="name"/>
                    <field name="code"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="action_distributor_register" model="ir.actions.act_window">
            <field name="name">Distributer register</field>
            <field name="res_model">distributor.register</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_distributor_register_filter"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
              </p><p>
                Let's create a distributor register.
              </p>
            </field>
        </record>


    </data>
</odoo>
