<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        
        <menuitem id="distributer_register_menu" name="Distributer register" parent="stock.menu_stock_config_settings" action="action_distributor_register"  />
        
        <menuitem id="stock_detail_report_mn_menu" name="Stock detail report" parent="stock.menu_warehouse_report" action="action_product_detail_report"  />
        
        <menuitem id="stock_product_quantity_page_mn_menu" name="Тооллогын хуудас" parent="stock.menu_warehouse_report" action="action_product_quantity_page"  />

        <menuitem id="stock_template_report_root_menu" name="Загвар" parent="stock.menu_warehouse_report" sequence="999"/>

        <menuitem id="stock_requisition_template_report_mn_menu" name="Шаардах хуудасны загвар" parent="stock_template_report_root_menu" action="action_stock_requisition_template_report" sequence="10"/>

        <menuitem id="stock_expense_template_report_mn_menu" name="Зарлагын баримтын загвар" parent="stock_template_report_root_menu" action="action_stock_expense_template_report" sequence="20"/>

        <menuitem id="stock_income_template_report_mn_menu" name="Орлогын баримтын загвар" parent="stock_template_report_root_menu" action="action_stock_income_template_report" sequence="30"/>

        <menuitem id="stock_workwear_template_report_mn_menu" name="Ажлын хувцас картын загвар" parent="stock_template_report_root_menu" action="action_stock_workwear_template_report" sequence="40"/>

        <menuitem id="purchase_product_income_report_menu" name="Орлогын тайлан" parent="stock.menu_warehouse_report" action="action_purchase_product_income_report"  />


        <menuitem id="stock_summary_report_mn_menu" name="Stock summary report" parent="stock.menu_warehouse_report" action="action_product_summary_report"  />

        <menuitem id="stock_supply_report_mn_menu" name="Stock Supply summary report" parent="stock.menu_warehouse_report" action="action_product_supply_report"  />

        <!-- Хангамж хаах: ажилтанд олгосон хангамжийг буцаалтгүйгээр хаах/актлах -->
        <record id="action_supply_writeoff_picking" model="ir.actions.act_window">
            <field name="name">Хангамж хаах</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="stock.view_picking_internal_search"/>
            <field name="domain" eval="[('picking_type_id', '=', ref('picking_type_supply_writeoff'))]"/>
            <field name="context" eval="{'contact_display': 'partner_address', 'default_picking_type_id': ref('picking_type_supply_writeoff'), 'restricted_picking_type_code': 'internal'}"/>
        </record>

        <!-- Хангамж шилжүүлэх: ажилтнаас ажилтанд -->
        <record id="action_supply_transfer_picking" model="ir.actions.act_window">
            <field name="name">Хангамж шилжүүлэх</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="stock.view_picking_internal_search"/>
            <field name="domain" eval="[('picking_type_id', '=', ref('picking_type_supply_transfer'))]"/>
            <field name="context" eval="{'contact_display': 'partner_address', 'default_picking_type_id': ref('picking_type_supply_transfer'), 'restricted_picking_type_code': 'internal'}"/>
        </record>

        <!-- Үйл ажиллагаа → Хангамж бүлэг (Гүйлгээ-ний дараа) -->
        <menuitem id="stock_supply_root_menu" name="Хангамж" parent="stock.menu_stock_warehouse_mgmt" sequence="1"/>

        <menuitem id="stock_supply_employee_balance_menu" name="Ажилтны хангамж" parent="stock_supply_root_menu" action="action_supply_employee_balance" sequence="5"/>

        <menuitem id="stock_supply_transfer_menu" name="Хангамж шилжүүлэх" parent="stock_supply_root_menu" action="action_supply_transfer_picking" sequence="10"/>

        <menuitem id="stock_supply_writeoff_menu" name="Хангамж хаах" parent="stock_supply_root_menu" action="action_supply_writeoff_picking" sequence="20"/>

        <menuitem id="stock_supply_writeoff_wizard_menu" name="Хугацаа дууссан хангамж хаах" parent="stock_supply_root_menu" action="action_supply_writeoff_wizard" sequence="30"/>

        <menuitem id="product_aged_report_mn_menu" name="Product aged report" parent="stock.menu_warehouse_report" action="action_product_aged_report"  />
        
        <menuitem id="product_sales_report_mn_menu" name="Product sales report" parent="stock.menu_warehouse_report" action="action_product_sales_report"  />

        <menuitem id="stock_warehouse_flow_report_mn_menu" name="Барааны урсгалын диаграм" parent="stock.menu_warehouse_report" action="action_stock_warehouse_flow_report"  />

        <menuitem id="product_category_new_menu" name="Product category" parent="stock.menu_stock_config_settings" action="action_product_category_new"  />

        <record model="ir.ui.menu" id="stock.menu_product_category_config_stock"><!--Sales online payments-->
            <field name="name">Item group</field>
        </record>

        <record id="action_stock_manual_employee_url" model="ir.actions.act_url">
            <field name="name">Агуулахын ажилтан</field>
            <field name="url">/l10n_mn_stock/static/stock_manual_employee.html</field>
            <field name="target">new</field>
        </record>
        <record id="action_stock_manual_manager_url" model="ir.actions.act_url">
            <field name="name">Агуулахын менежер</field>
            <field name="url">/l10n_mn_stock/static/stock_manual_manager.html</field>
            <field name="target">new</field>
        </record>

        <menuitem id="stock_manual_root_menu" name="Гарын авлага" parent="stock.menu_stock_root" sequence="99"/>
        <menuitem id="stock_manual_employee_menu" name="Агуулахын ажилтан" parent="stock_manual_root_menu" sequence="1" action="action_stock_manual_employee_url" groups="stock.group_stock_user,stock.group_stock_manager"/>
        <menuitem id="stock_manual_manager_menu" name="Агуулахын менежер" parent="stock_manual_root_menu" sequence="2" action="action_stock_manual_manager_url" groups="stock.group_stock_manager"/>

    </data>
</odoo>
