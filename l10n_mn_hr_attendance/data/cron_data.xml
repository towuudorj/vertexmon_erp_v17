<odoo noupdate="1">
    <record id="ir_cron_edi_network" model="ir.cron">
        <field name="name">ИРЦ: Нүүр таних төхөөрөмжөөс ирц татах</field>
        <field name="model_id" ref="model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model.get_attendance_data(last_days=10)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_microsoft_push_data" model="ir.cron">
        <field name="name">Microsoft: Өгөгдөл шинэчилэх API</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model.push_hr_info_to_microsoft()</field>
        <field name="interval_number">100</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field>
    </record>

    <record id="ir_cron_get_approved_leaves" model="ir.cron">
        <field name="name">Microsoft: Батлагдсан чөлөө татах</field>
        <field name="model_id" ref="model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">model.get_approved_leaves()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_update_lost_time" model="ir.cron">
        <field name="name">Microsoft: Хоцролт  шинэчилэх</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_push_late_time()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>


    <record id="ir_cron_update_attendance" model="ir.cron">
        <field name="name">Microsoft: Ирц шинэчилэх</field>
        <field name="model_id" ref="model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_attendance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_get_att_edit_req" model="ir.cron">
        <field name="name">Microsoft: Ирц нөхөн засах хүсэлт</field>
        <field name="model_id" ref="model_attendance_edit_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_get_attendance_request()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>