<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_attendance_mn_tree_view" model="ir.ui.view">
            <field name="name">hr.attendance.mn.tree</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr='//field[@name="overtime_hours"]' position="replace">
                        <field name="loss_time"/>
                    </xpath>
                    <xpath expr='//field[@name="check_out"]' position="after">
                        <field name="manual_lock" optional="show" readonly="1"/>
                        <field name="edit_note" optional="show" readonly="1"/>
                    </xpath>
                    <xpath expr='//tree' position='attributes'>
                        <attribute name="create">0</attribute>
                    </xpath>
                </data>
            </field>
        </record>


        <!-- corrected through an approved edit request: the sync leaves it alone; HR can unlock it -->
        <record id="hr_attendance_mn_form_view" model="ir.ui.view">
            <field name="name">hr.attendance.mn.form</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
            <field name="arch" type="xml">
                <xpath expr='//field[@name="check_out"]' position="after">
                    <field name="manual_lock"/>
                    <field name="edit_note" invisible="not edit_note"/>
                </xpath>
                <xpath expr='//field[@name="worked_hours"]' position="after">
                    <field name="check_in_location" invisible="not check_in_location"/>
                    <field name="check_out_location" invisible="not check_out_location"/>
                </xpath>
                <xpath expr='//form' position='attributes'>
                    <attribute name="create">0</attribute>
                </xpath>
            </field>
        </record>

         <record id="hr_attendance_calendar_view" model="ir.ui.view">
            <field name="name">hr.attendance.calendar</field>
            <field name="model">hr.attendance</field>
            <field name="arch" type="xml">
                <calendar string="Attendance" date_start="check_in" date_stop="check_out" color="employee_id" create="0"
                          delete="0">
                    <field name="employee_id"/>
                    <field name="check_in"/>
                    <field name="check_out"/>
                    <field name="worked_hours"/>
                </calendar>
            </field>
        </record>

        <record id="hr_attendance.hr_attendance_action" model="ir.actions.act_window">
            <field name="view_mode">tree,form,calendar</field>
        </record>
    </data>
</odoo>
